i32 namespaced_answer = integer::answer();
func Mapper<T>(T) => (T);
once func Action() => ();
Mapper<i32> integerMapper = (value) => { return value; };
Mapper copied = [copy factor](value) => { return value + factor; };
Mapper borrowed = [&factor, &const limit](value) => { return value + factor + limit; };
Mapper lent = unsafe [lend pointer](value) => { return value + *pointer; };
Mapper owned = unsafe [own owner](value) => { return value + *owner; };
Mapper nested = [own copied](value) => { return copied(value); };
Action action = once []() => () {};
test gold_keyword(&testing::UnitTest t) {}
