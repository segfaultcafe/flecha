{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Flecha",
  "scopeName": "source.flecha",
  "patterns": [
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#characters"},
    {"include": "#imports"},
    {"include": "#tests"},
    {"include": "#nominalDeclarations"},
    {"include": "#methodDeclarations"},
    {"include": "#functionDeclarations"},
    {"include": "#callableDeclarations"},
    {"include": "#typeSetDeclarations"},
    {"include": "#moduleDeclarations"},
    {"include": "#namespaceAttachments"},
    {"include": "#typeQualifiers"},
    {"include": "#namespaces"},
    {"include": "#typeSets"},
    {"include": "#floatingConstants"},
    {"include": "#integerLimits"},
    {"include": "#namedConstants"},
    {"include": "#enumMembers"},
    {"include": "#types"},
    {"include": "#modifiers"},
    {"include": "#control"},
    {"include": "#borrowAllArguments"},
    {"include": "#constants"},
    {"include": "#labels"},
    {"include": "#numbers"},
    {"include": "#crashBuiltin"},
    {"include": "#functions"},
    {"include": "#crashableBangs"},
    {"include": "#operators"},
    {"include": "#variables"}
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.flecha",
          "begin": "//",
          "end": "$",
          "patterns": [{"include": "#todo"}]
        },
        {
          "name": "comment.block.flecha",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{"include": "#todo"}]
        }
      ]
    },
    "todo": {
      "patterns": [
        {
          "name": "keyword.other.documentation.flecha",
          "match": "\\b(?:TODO|FIXME|XXX|NOTE)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.flecha",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {"name": "constant.character.escape.flecha", "match": "\\\\[ntr\\\\\"]"}
      ]
    },
    "characters": {
      "name": "string.quoted.single.flecha",
      "begin": "'",
      "end": "'",
      "patterns": [
        {"name": "constant.character.escape.flecha", "match": "\\\\[ntr0\\\\']"}
      ]
    },
    "imports": {
      "name": "keyword.control.import.flecha",
      "match": "@[A-Za-z_][A-Za-z0-9_]*(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*\\b"
    },
    "tests": {
      "name": "keyword.other.test.flecha",
      "match": "\\btest\\b"
    },
    "nominalDeclarations": {
      "begin": "\\b(interface|structure|enum)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": {"name": "keyword.declaration.type.flecha"},
        "3": {"name": "entity.name.type.flecha"}
      },
      "end": "(?=\\{)|;",
      "patterns": [
        {
          "match": "(<<)(\\s*)((?:[A-Za-z_][A-Za-z0-9_]*\\s*::\\s*)*[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {"name": "keyword.operator.inheritance.flecha"},
            "3": {"name": "entity.other.inherited-class.flecha"}
          }
        },
        {
          "match": "(,)(\\s*)((?:[A-Za-z_][A-Za-z0-9_]*\\s*::\\s*)*[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {"name": "punctuation.separator.inheritance.flecha"},
            "3": {"name": "entity.other.inherited-class.flecha"}
          }
        },
        {"include": "#types"},
        {"include": "#operators"}
      ]
    },
    "methodDeclarations": {
      "begin": "^(\\s*)((?:(?:unsafe|once|export|quiver|extern|foreign|inline|comptime|copy|own|lend|const|constptr|constref|volatile|private|protected|override)\\s+)*)((?:(?:&\\s*(?:const\\s+)?|\\*\\s*(?:const\\s+)?|\\[[^\\]\\n]*\\]\\s*))*(?:\\([^()\\n]*\\)|(?:i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64|bool|char|void|string|stringv|error|[A-Z][A-Za-z0-9_]*)(?:<[^>\\n]*>)?))(\\s+)((?:[A-Za-z_][A-Za-z0-9_]*::)*[A-Za-z_][A-Za-z0-9_]*)(::)([A-Za-z_][A-Za-z0-9_]*(?:<[^>\\n]*>)?)(\\s*)(!?)(\\s*)(\\()",
      "beginCaptures": {
        "2": {"name": "storage.modifier.flecha"},
        "3": {"name": "storage.type.flecha"},
        "5": {"name": "entity.name.type.flecha"},
        "6": {"name": "punctuation.accessor.namespace.flecha"},
        "7": {"name": "entity.name.function.member.flecha"},
        "9": {"name": "keyword.operator.crashable.flecha"},
        "11": {"name": "punctuation.section.parameters.begin.flecha"}
      },
      "end": "\\)",
      "endCaptures": {
        "0": {"name": "punctuation.section.parameters.end.flecha"}
      },
      "patterns": [
        {"include": "#parameters"},
        {"include": "#types"},
        {"include": "#typeSets"},
        {"include": "#modifiers"},
        {"include": "#constants"},
        {"include": "#operators"}
      ]
    },
    "functionDeclarations": {
      "begin": "^(\\s*)((?:(?:unsafe|once|export|quiver|extern|foreign|inline|comptime|copy|own|lend|const|constptr|constref|volatile|private|protected)\\s+)*)((?:(?:&\\s*(?:const\\s+)?|\\*\\s*(?:const\\s+)?|\\[[^\\]\\n]*\\]\\s*))*(?:\\([^()\\n]*\\)|(?:i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64|bool|char|void|string|stringv|error|[A-Z][A-Za-z0-9_]*)(?:<[^>\\n]*>)?))(\\s+)([A-Za-z_][A-Za-z0-9_]*(?:<[^>\\n]*>)?)(\\s*)(!?)(\\s*)(\\()",
      "beginCaptures": {
        "2": {"name": "storage.modifier.flecha"},
        "3": {"name": "storage.type.flecha"},
        "5": {"name": "entity.name.function.flecha"},
        "7": {"name": "keyword.operator.crashable.flecha"},
        "9": {"name": "punctuation.section.parameters.begin.flecha"}
      },
      "end": "\\)",
      "endCaptures": {
        "0": {"name": "punctuation.section.parameters.end.flecha"}
      },
      "patterns": [
        {"include": "#parameters"},
        {"include": "#types"},
        {"include": "#typeSets"},
        {"include": "#modifiers"},
        {"include": "#constants"},
        {"include": "#operators"}
      ]
    },
    "callableDeclarations": {
      "match": "\\b(func)(\\s+)([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": {"name": "storage.type.function.flecha"},
        "3": {"name": "entity.name.type.function.flecha"}
      }
    },
    "typeSetDeclarations": {
      "match": "\\b(typeset)(\\s+)([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": {"name": "storage.type.typeset.flecha"},
        "3": {"name": "entity.name.type.typeset.flecha"}
      }
    },
    "moduleDeclarations": {
      "match": "\\b(module)(\\s+)([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": {"name": "keyword.control.module.flecha"},
        "3": {"name": "entity.name.namespace.flecha"}
      }
    },
    "namespaceAttachments": {
      "begin": "\\b(under)(\\s+)(namespace)\\b",
      "beginCaptures": {
        "1": {"name": "keyword.control.module.flecha"},
        "3": {"name": "keyword.control.module.flecha"}
      },
      "end": ";",
      "patterns": [
        {"include": "#namespaces"}
      ]
    },
    "typeQualifiers": {
      "name": "entity.name.type.flecha",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b(?=\\s*::)"
    },
    "namespaces": {
      "name": "entity.name.namespace.flecha",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*::)"
    },
    "typeSets": {
      "name": "support.type.typeset.builtin.flecha",
      "match": "\\b(?:signed_integer|unsigned_integer|integer|floating_point|numeric)\\b"
    },
    "integerLimits": {
      "patterns": [
        {
          "match": "\\b(i8|i16|i32|i64|isize|u8|u16|u32|u64|usize)(\\s*\\.\\s*)(min_value|max_value)\\b",
          "captures": {
            "1": {"name": "storage.type.primitive.flecha"},
            "2": {"name": "punctuation.accessor.flecha"},
            "3": {"name": "constant.numeric.integer.bound.flecha"}
          }
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)(\\s*\\.\\s*)(min_value|max_value)\\b",
          "captures": {
            "1": {"name": "entity.name.type.flecha"},
            "2": {"name": "punctuation.accessor.flecha"},
            "3": {"name": "constant.numeric.integer.bound.flecha"}
          }
        }
      ]
    },
    "floatingConstants": {
      "patterns": [
        {
          "match": "\\b(f32|f64)(\\s*\\.\\s*)(nan|infinity|negative_infinity|min_value|max_value|min_positive|epsilon)\\b",
          "captures": {
            "1": {"name": "storage.type.primitive.flecha"},
            "2": {"name": "punctuation.accessor.flecha"},
            "3": {"name": "constant.numeric.float.property.flecha"}
          }
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)(\\s*\\.\\s*)(nan|infinity|negative_infinity|min_positive|epsilon)\\b",
          "captures": {
            "1": {"name": "entity.name.type.flecha"},
            "2": {"name": "punctuation.accessor.flecha"},
            "3": {"name": "constant.numeric.float.property.flecha"}
          }
        }
      ]
    },
    "namedConstants": {
      "name": "constant.other.named.flecha",
      "match": "\\b(?:[A-Z][A-Z0-9]*_[A-Z0-9_]*|[A-Z]{2,}[A-Z0-9_]*)\\b"
    },
    "enumMembers": {
      "name": "constant.other.enum.member.flecha",
      "match": "(?<=\\.)[A-Z][A-Za-z0-9_]*\\b"
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.flecha",
          "match": "\\b(?:i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64|bool|char|void|string|stringv|error)\\b"
        },
        {
          "name": "entity.name.type.flecha",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "modifiers": {
      "name": "storage.modifier.flecha",
      "match": "\\b(?:unsafe|once|export|quiver|extern|foreign|inline|comptime|copy|own|lend|const|constptr|constref|volatile|private|protected|override|virtual|default|final)\\b"
    },
    "control": {
      "name": "keyword.control.flecha",
      "match": "\\b(?:module|enum|structure|interface|decoration|build|return|defer|yield|if|match|else|also|while|for|loop|range|proceed|break|jumpto|as)\\b"
    },
    "borrowAllArguments": {
      "match": "(<-)(\\s*)(\\.\\.\\.)(\\s*)(args)\\b",
      "captures": {
        "1": {"name": "keyword.operator.flecha"},
        "3": {"name": "keyword.operator.flecha"},
        "5": {"name": "variable.language.flecha"}
      }
    },
    "constants": {
      "patterns": [
        {"name": "constant.language.boolean.flecha", "match": "\\b(?:true|false)\\b"},
        {"name": "constant.language.flecha", "match": "\\b(?:none|null)\\b"},
        {"name": "variable.language.flecha", "match": "\\bself\\b"}
      ]
    },
    "labels": {
      "name": "entity.name.label.flecha",
      "match": "#[A-Za-z_][A-Za-z0-9_]*"
    },
    "numbers": {
      "patterns": [
        {"name": "constant.numeric.float.flecha", "match": "\\b[0-9]+\\.[0-9]+\\b"},
        {"name": "constant.numeric.integer.flecha", "match": "\\b(?:0[xX][0-9A-Fa-f]+|[0-9]+)\\b"}
      ]
    },
    "crashBuiltin": {
      "name": "support.function.builtin.flecha",
      "match": "\\bcrash(?=\\s*\\()"
    },
    "parameters": {
      "patterns": [
        {
          "match": "\\b(i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64|bool|char|void|string|stringv|error)(\\s+)([a-z_][A-Za-z0-9_]*)(?=\\s*[,\\)])",
          "captures": {
            "1": {"name": "storage.type.primitive.flecha"},
            "3": {"name": "variable.parameter.flecha"}
          }
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*(?:<[^>\\n]+>)?)(\\s+)([a-z_][A-Za-z0-9_]*)(?=\\s*[,\\)])",
          "captures": {
            "1": {"name": "entity.name.type.flecha"},
            "3": {"name": "variable.parameter.flecha"}
          }
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.flecha",
          "match": "\\b(?:new|take)(?=\\s*[<(])"
        },
        {
          "name": "support.function.builtin.flecha",
          "match": "\\bisof(?=\\s*<)"
        },
        {
          "name": "variable.function.member.flecha",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?:<[^>\\n]*>\\s*)?\\()"
        },
        {
          "name": "variable.function.member.flecha",
          "match": "(?<=::)[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?:<[^>\\n]*>\\s*)?\\()"
        },
        {
          "name": "variable.function.flecha",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?:<[^>\\n]*>\\s*)?\\()"
        }
      ]
    },
    "crashableBangs": {
      "name": "keyword.operator.crashable.flecha",
      "match": "(?<=[A-Za-z0-9_>])!(?=\\s*\\()"
    },
    "operators": {
      "name": "keyword.operator.flecha",
      "match": "::|<-|->|=>|:=|===|!==|==|!=|<<|>>|<=|>=|&&|\\|\\||\\b(?:and|or|raw)\\b|[&|~=+*/%^!<>-]"
    },
    "variables": {
      "name": "variable.other.readwrite.flecha",
      "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
    }
  }
}
