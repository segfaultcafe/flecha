{
  "name": "flecha-language",
  "displayName": "Flecha Language Support",
  "description": "Syntax highlighting and editing support for Flecha source files.",
  "version": "0.3.1",
  "publisher": "flecha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbsec/flecha.git"
  },
  "homepage": "https://github.com/alexbsec/flecha",
  "bugs": "https://github.com/alexbsec/flecha/issues",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:flecha"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension starts local Flecha language-server and compiler executables."
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "compile": "esbuild extension.js --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "flecha",
        "aliases": [
          "Flecha",
          "flecha"
        ],
        "extensions": [
          ".fl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "flecha",
        "scopeName": "source.flecha",
        "path": "./syntaxes/flecha.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "keyword.other.test.flecha",
            "settings": {
              "foreground": "#FFD700"
            }
          },
          {
            "scope": "storage.type.function.flecha",
            "settings": {
              "foreground": "#569CD6"
            }
          },
          {
            "scope": "support.function.crash.flecha",
            "settings": {
              "foreground": "#87CEFA"
            }
          },
          {
            "scope": "support.type.typeset.builtin.flecha",
            "settings": {
              "foreground": "#87CEFA"
            }
          },
          {
            "scope": "constant.numeric.integer.bound.flecha",
            "settings": {
              "foreground": "#C49A00"
            }
          },
          {
            "scope": "constant.numeric.float.property.flecha",
            "settings": {
              "foreground": "#C49A00"
            }
          },
          {
            "scope": "keyword.operator.crashable.flecha",
            "settings": {
              "foreground": "#FF8C00"
            }
          }
        ]
      }
    },
    "commands": [
      {
        "command": "flecha.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Flecha"
      }
    ],
    "configuration": {
      "title": "Flecha",
      "properties": {
        "flecha.server.path": {
          "type": "string",
          "default": "flecha-lsp",
          "scope": "machine",
          "description": "Path to the Flecha language server executable."
        },
        "flecha.compiler.path": {
          "type": "string",
          "default": "flecha",
          "scope": "machine",
          "description": "Path to the Flecha compiler used by the language server."
        },
        "flecha.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Trace communication between VS Code and the Flecha language server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2"
  }
}
