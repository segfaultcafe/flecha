{
  "name": "flecha-language",
  "displayName": "Flecha Language Support",
  "description": "Syntax highlighting and editing support for Flecha source files.",
  "version": "0.1.3",
  "publisher": "flecha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbsec/flecha.git"
  },
  "homepage": "https://github.com/alexbsec/flecha",
  "bugs": "https://github.com/alexbsec/flecha/issues",
  "engines": {
    "vscode": "^1.85.0"
  },
  "scripts": {
    "package": "vsce package --no-dependencies"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "flecha",
        "aliases": [
          "Flecha",
          "flecha"
        ],
        "extensions": [
          ".fl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "flecha",
        "scopeName": "source.flecha",
        "path": "./syntaxes/flecha.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  }
}
