module failure_test;

@imports
    :: root::failure
    :: lib::std::tests::testing
    :: lib::std::tests::asserts;

test reports_failure(&testing::UnitTest t) {
    asserts::is_true(t, false, "expected fixture failure");
}

error FixtureError {
    Missing,
    Invalid,
}

error OtherFixtureError {
    Missing,
}

test reports_less_failure(&testing::UnitTest t) {
    i32 actual = 5;
    i32 expected = 4;
    asserts::less<i32>(t, &actual, &expected, "expected less failure");
}

test reports_less_or_equal_failure(&testing::UnitTest t) {
    i32 actual = 5;
    i32 expected = 4;
    asserts::less_or_equal<i32>(
        t,
        &actual,
        &expected,
        "expected less-or-equal failure"
    );
}

test reports_greater_failure(&testing::UnitTest t) {
    i32 actual = 4;
    i32 expected = 5;
    asserts::greater<i32>(t, &actual, &expected, "expected greater failure");
}

test reports_greater_or_equal_failure(&testing::UnitTest t) {
    i32 actual = 4;
    i32 expected = 5;
    asserts::greater_or_equal<i32>(
        t,
        &actual,
        &expected,
        "expected greater-or-equal failure"
    );
}

test reports_numeric_equal_failure(&testing::UnitTest t) {
    i32 actual = 4;
    i32 expected = 5;
    asserts::numeric_equal<i32>(
        t,
        &actual,
        &expected,
        "expected numeric equality failure"
    );
}

test reports_numeric_not_equal_failure(&testing::UnitTest t) {
    i32 actual = 5;
    i32 unexpected = 5;
    asserts::numeric_not_equal<i32>(
        t,
        &actual,
        &unexpected,
        "expected numeric inequality failure"
    );
}

test reports_string_equal_failure(&testing::UnitTest t) {
    asserts::string_equal(
        t,
        "hello",
        "world",
        "expected string equality failure"
    );
}

test reports_string_not_equal_failure(&testing::UnitTest t) {
    asserts::string_not_equal(
        t,
        "same",
        "same",
        "expected string inequality failure"
    );
}

test reports_escaped_string_equal_failure(&testing::UnitTest t) {
    [7]u8 actualBytes = [34, 92, 10, 13, 9, 0, 1];
    actual := actualBytes[:].cast<stringv>;
    asserts::string_equal(
        t,
        actual,
        "plain",
        "expected escaped string equality failure"
    );
}

test reports_escaped_string_not_equal_failure(&testing::UnitTest t) {
    [7]u8 actualBytes = [34, 92, 10, 13, 9, 0, 1];
    actual := actualBytes[:].cast<stringv>;
    asserts::string_not_equal(
        t,
        actual,
        actual,
        "expected escaped string inequality failure"
    );
}

test reports_string_preview_boundary_failure(&testing::UnitTest t) {
    [64]u8 actualBytes = [65; 64];
    actual := actualBytes[:].cast<stringv>;
    asserts::string_equal(
        t,
        actual,
        "different",
        "expected string preview boundary failure"
    );
}

test reports_string_single_omission_failure(&testing::UnitTest t) {
    [65]u8 actualBytes = [65; 65];
    actual := actualBytes[:].cast<stringv>;
    asserts::string_equal(
        t,
        actual,
        "different",
        "expected single-byte omission failure"
    );
}

test reports_large_string_truncation_failure(&testing::UnitTest t) {
    [80]u8 actualBytes = [65; 80];
    actualBytes[79] = 90;
    actual := actualBytes[:].cast<stringv>;
    asserts::string_equal(
        t,
        actual,
        "different",
        "expected large string truncation failure"
    );
}

test reports_bytes_equal_length_failure(&testing::UnitTest t) {
    [2]u8 actual = [1, 2];
    [3]u8 expected = [1, 2, 3];
    asserts::bytes_equal(
        t,
        actual[:],
        expected[:],
        "expected byte length failure"
    );
}

test reports_bytes_equal_content_failure(&testing::UnitTest t) {
    [3]u8 actual = [1, 2, 3];
    [3]u8 expected = [1, 9, 3];
    asserts::bytes_equal(
        t,
        actual[:],
        expected[:],
        "expected byte content failure"
    );
}

test reports_bytes_not_equal_identical_failure(&testing::UnitTest t) {
    [3]u8 actual = [1, 2, 3];
    [3]u8 unexpected = [1, 2, 3];
    asserts::bytes_not_equal(
        t,
        actual[:],
        unexpected[:],
        "expected identical byte failure"
    );
}

test reports_bytes_not_equal_empty_failure(&testing::UnitTest t) {
    [0]u8 actual = none;
    [0]u8 unexpected = none;
    asserts::bytes_not_equal(
        t,
        actual[:],
        unexpected[:],
        "expected empty byte failure"
    );
}

test reports_different_error_variant_failure(&testing::UnitTest t) {
    FixtureError actual = FixtureError.Invalid;
    asserts::has_error_variant(
        t,
        actual,
        FixtureError.Missing,
        "expected same-family variant failure"
    );
}

test reports_different_error_family_failure(&testing::UnitTest t) {
    OtherFixtureError actual = OtherFixtureError.Missing;
    asserts::has_error_variant(
        t,
        actual,
        FixtureError.Missing,
        "expected cross-family variant failure"
    );
}

test reports_missing_error_variant_failure(&testing::UnitTest t) {
    error actual = none;
    asserts::has_error_variant(
        t,
        actual,
        FixtureError.Missing,
        "expected missing-error variant failure"
    );
}

test reports_missing_error_family_failure(&testing::UnitTest t) {
    FixtureError actual = none;
    asserts::has_error_family<FixtureError>(
        t,
        actual,
        "expected missing error family failure"
    );
}

test reports_generic_error_family_failure(&testing::UnitTest t) {
    error actual = FixtureError.Missing;
    asserts::has_error_family<error>(
        t,
        actual,
        "expected generic error family failure"
    );
}
