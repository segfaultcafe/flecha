module hmac_fixture;

@imports
    :: lib::std::cryptography::hmac
    :: lib::std::cryptography::sha2;

bool tag_equals(
    &const hmac::HmacSha256Tag tag,
    []const u8 expected
) {
    actual := tag->bytes();
    if actual.len() != expected.len() {
        return false;
    }

    loop usize index = 0; index < actual.len(); index++ {
        if actual[index] != expected[index] {
            return false;
        }
    }

    return true;
}

bool tag_equals(
    &const hmac::HmacSha512Tag tag,
    []const u8 expected
) {
    actual := tag->bytes();
    if actual.len() != expected.len() {
        return false;
    }

    loop usize index = 0; index < actual.len(); index++ {
        if actual[index] != expected[index] {
            return false;
        }
    }

    return true;
}

i32 main() {
    [20]u8 shortKey = [0x0b; 20];
    message := "Hi There".cast<[]const u8>;
    [32]u8 sha256Expected = [
        0xb0, 0x34, 0x4c, 0x61, 0xd8, 0xdb, 0x38, 0x53,
        0x5c, 0xa8, 0xaf, 0xce, 0xaf, 0x0b, 0xf1, 0x2b,
        0x88, 0x1d, 0xc2, 0x00, 0xc9, 0x83, 0x3d, 0xa7,
        0x26, 0xe9, 0x37, 0x6c, 0x2e, 0x32, 0xcf, 0xf7
    ];
    [64]u8 sha512Expected = [
        0x87, 0xaa, 0x7c, 0xde, 0xa5, 0xef, 0x61, 0x9d,
        0x4f, 0xf0, 0xb4, 0x24, 0x1a, 0x1d, 0x6c, 0xb0,
        0x23, 0x79, 0xf4, 0xe2, 0xce, 0x4e, 0xc2, 0x78,
        0x7a, 0xd0, 0xb3, 0x05, 0x45, 0xe1, 0x7c, 0xde,
        0xda, 0xa8, 0x33, 0xb7, 0xd6, 0xb8, 0xa7, 0x02,
        0x03, 0x8b, 0x27, 0x4e, 0xae, 0xa3, 0xf4, 0xe4,
        0xbe, 0x9d, 0x91, 0x4e, 0xeb, 0x61, 0xf1, 0x70,
        0x2e, 0x69, 0x6c, 0x20, 0x3a, 0x12, 0x68, 0x54
    ];
    sha256Tag, sha256Error := hmac::sha256(shortKey[:], message);
    sha512Tag, sha512Error := hmac::sha512(shortKey[:], message);
    if sha256Error != none or sha512Error != none or
        !tag_equals(&sha256Tag, sha256Expected[:]) or
        !tag_equals(&sha512Tag, sha512Expected[:]) {
        return 1;
    }

    [4]u8 chunkedKey = [0x4a, 0x65, 0x66, 0x65];
    chunkedMessage := "what do ya want for nothing?".cast<[]const u8>;
    [32]u8 chunkedExpected = [
        0x5b, 0xdc, 0xc1, 0x46, 0xbf, 0x60, 0x75, 0x4e,
        0x6a, 0x04, 0x24, 0x26, 0x08, 0x95, 0x75, 0xc7,
        0x5a, 0x00, 0x3f, 0x08, 0x9d, 0x27, 0x39, 0x83,
        0x9d, 0xec, 0x58, 0xb9, 0x64, 0xec, 0x38, 0x43
    ];
    chunkedHasher, chunkedCreateError :=
        hmac::HmacSha256::create(chunkedKey[:]);
    if chunkedCreateError != none or
        chunkedHasher.update(chunkedMessage[:9]) != none or
        chunkedHasher.update(chunkedMessage[9:]) != none {
        return 2;
    }
    chunkedTag, chunkedFinalizeError := chunkedHasher.finalize();
    if chunkedFinalizeError != none or
        !tag_equals(&chunkedTag, chunkedExpected[:]) {
        return 3;
    }
    _, repeatedError := chunkedHasher.finalize();
    if repeatedError != sha2::Sha2Error.AlreadyFinalized {
        return 4;
    }

    [131]u8 longKey = [0xaa; 131];
    longMessage :=
        "Test Using Larger Than Block-Size Key - Hash Key First"
            .cast<[]const u8>;
    [64]u8 longExpected = [
        0x80, 0xb2, 0x42, 0x63, 0xc7, 0xc1, 0xa3, 0xeb,
        0xb7, 0x14, 0x93, 0xc1, 0xdd, 0x7b, 0xe8, 0xb4,
        0x9b, 0x46, 0xd1, 0xf4, 0x1b, 0x4a, 0xee, 0xc1,
        0x12, 0x1b, 0x01, 0x37, 0x83, 0xf8, 0xf3, 0x52,
        0x6b, 0x56, 0xd0, 0x37, 0xe0, 0x5f, 0x25, 0x98,
        0xbd, 0x0f, 0xd2, 0x21, 0x5d, 0x6a, 0x1e, 0x52,
        0x95, 0xe6, 0x4f, 0x73, 0xf6, 0x3f, 0x0a, 0xec,
        0x8b, 0x91, 0x5a, 0x98, 0x5d, 0x78, 0x65, 0x98
    ];
    longTag, longError := hmac::sha512(longKey[:], longMessage);
    if longError != none or !tag_equals(&longTag, longExpected[:]) {
        return 5;
    }

    hmac::HmacSha512 defaultHasher = none;
    [0]u8 empty = [];
    if defaultHasher.update(empty[:]) != hmac::HmacError.NotInitialized {
        return 6;
    }

    return 42;
}
