interface Runnable {
    error run(&self) virtual;
};

interface ProvidedRunnable << Runnable {
    error run(&self) default;
};

error ProvidedRunnable::run(&self) override {
    return none;
}

interface Validated {
    protected error validate(&const self) virtual;
};

interface Named {
    stringv name(&const self) final;
};

stringv Named::name(&const self) {
    return "fixture";
}

structure Record << ProvidedRunnable, Validated, Named {};

protected error Record::validate(&const self) override {
    return none;
}

interface WritableI32 {
    error write(&self, i32 value) virtual;
};

interface WritableString {
    error write(&self, stringv value) virtual;
};

structure Writer << WritableI32, WritableString {};

error Writer::write(&self, i32 value) override {
    return none;
}

error Writer::write(&self, stringv value) override {
    return none;
}

structure GenericRecord<T> << Validated {
    T value;
};

protected error GenericRecord<T>::validate(&const self) override {
    return none;
}

void instantiate(GenericRecord<i32> value) {}
