module move_only_growth_failure;

@imports :: lib::std::containers::collections;

structure Owner {
    *i32 cleanupCount;
    i32 id;
};

Owner Owner::zero() override {
    return build Owner {
        self.cleanupCount = null;
        self.id = 0;
    };
}

Owner Owner::init(*i32 cleanupCount, i32 id) override {
    return build Owner {
        self.cleanupCount = cleanupCount;
        self.id = id;
    };
}

Owner Owner::probe(i32 id) {
    unsafe {
        return Owner::init(null, id);
    }
}

void Owner::tear(&self) override {
    unsafe {
        if self->cleanupCount != null {
            (*self->cleanupCount)++;
        }
    }
}

usize ownerHash(&const Owner value) {
    return value->id.cast<usize>;
}

bool ownerEqual(&const Owner left, &const Owner right) {
    return left->id == right->id;
}

i32 main() {
    i32 cleanupCount = 0;

    {
        values := collections::HashSet<Owner>::init()
            .withHash(ownerHash)
            .withEqual(ownerEqual);

        unsafe {
            loop i32 id = 1; id <= 6; id++ {
                if values.insert(Owner::init(&raw cleanupCount, id)) != none {
                    return 1;
                }
            }

            if values.insert(
                Owner::init(&raw cleanupCount, 7)
            ) != AllocationError.OutOfMemory {
                return 2;
            }
        }

        if cleanupCount != 1 or values.len() != 6 or
            values.capacity() != 8 {
            return 3;
        }

        loop i32 id = 1; id <= 6; id++ {
            probe := Owner::probe(id);
            if values.erase(&probe) != none {
                return 4;
            }
        }

        if !values.empty() or values.capacity() != 8 or cleanupCount != 7 {
            return 5;
        }
    }

    if cleanupCount != 7 {
        return 6;
    }
    return 42;
}
