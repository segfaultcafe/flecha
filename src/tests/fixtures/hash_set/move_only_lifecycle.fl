module move_only_lifecycle;

@imports :: lib::std::containers::collections;

structure Owner {
    *i32 cleanupCount;
    i32 id;
};

Owner Owner::zero() override {
    return build Owner {
        self.cleanupCount = null;
        self.id = 0;
    };
}

Owner Owner::init(*i32 cleanupCount, i32 id) override {
    return build Owner {
        self.cleanupCount = cleanupCount;
        self.id = id;
    };
}

Owner Owner::probe(i32 id) {
    unsafe {
        return Owner::init(null, id);
    }
}

void Owner::tear(&self) override {
    unsafe {
        if self->cleanupCount != null {
            (*self->cleanupCount)++;
        }
    }
}

usize ownerHash(&const Owner value) {
    return value->id.cast<usize>;
}

bool ownerEqual(&const Owner left, &const Owner right) {
    return left->id == right->id;
}

void visitOwner(&const Owner value) {
    value->id;
}

i32 main() {
    i32 cleanupCount = 0;

    {
        values := collections::HashSet<Owner>::init()
            .withHash(ownerHash)
            .withEqual(ownerEqual);

        unsafe {
            loop i32 id = 1; id <= 7; id++ {
                if values.insert(Owner::init(&raw cleanupCount, id)) != none {
                    return 1;
                }
            }

            if values.insert(
                Owner::init(&raw cleanupCount, 1)
            ) != none {
                return 2;
            }
        }

        if cleanupCount != 1 or values.len() != 7 or
            values.capacity() != 16 {
            return 3;
        }

        values.forEach(visitOwner);
        probe := Owner::probe(2);
        if values.erase(&probe) != none or cleanupCount != 2 {
            return 4;
        }

        values.clear();
        if !values.empty() or values.capacity() != 16 or cleanupCount != 8 {
            return 5;
        }

        unsafe {
            if values.insert(
                Owner::init(&raw cleanupCount, 8)
            ) != none {
                return 6;
            }
        }
    }

    if cleanupCount != 9 {
        return 7;
    }
    return 42;
}
