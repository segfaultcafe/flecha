module algorithms;

@imports
    :: lib::std::containers::algorithms
    :: lib::std::containers::array;

i32 main() {
    [0]i32 empty = [];
    missing, foundEmpty := algorithms::index_of<i32>(empty[:], 42);
    if foundEmpty || missing != 0 ||
        algorithms::contains<i32>(empty[:], 42) {
        return 1;
    }

    algorithms::reverse<i32>(empty[:]);
    algorithms::fill<i32>(empty[:], 42);

    [5]i32 values = [10, 20, 30, 20, 40];
    index, found := algorithms::index_of<i32>(values[:], 20);
    if !found || index != 1 ||
        !algorithms::contains<i32>(values[:], 40) ||
        algorithms::contains<i32>(values[:], 99) {
        return 2;
    }

    algorithms::reverse<i32>(values[:]);
    if values[0] != 40 || values[1] != 20 || values[2] != 30 ||
        values[3] != 20 || values[4] != 10 {
        return 3;
    }

    algorithms::fill<i32>(values[:], 7);
    if values[0] != 7 || values[1] != 7 || values[2] != 7 ||
        values[3] != 7 || values[4] != 7 {
        return 4;
    }

    [4]i32 source = [1, 2, 3, 4];
    dynamic, err := array::Array<i32>::fromSlice(source[:]);
    if err != none {
        return 5;
    }

    memberIndex, memberFound := dynamic.indexOf(3);
    if !memberFound || memberIndex != 2 || !dynamic.contains(1) ||
        dynamic.contains(9) {
        return 6;
    }

    dynamic.reverse();
    first, firstError := dynamic.get(0);
    last, lastError := dynamic.get(3);
    if firstError != none || first != 4 || lastError != none || last != 1 {
        return 7;
    }

    dynamic.fill(42);
    loop usize i = 0; i < dynamic.len(); i++ {
        value, getError := dynamic.get(i);
        if getError != none || value != 42 {
            return 8;
        }
    }

    return 42;
}
