module address_allocation_failure;

@imports :: lib::std::net::address;

i32 main() {
    value := address::Ipv6Address::fromSegments(
        8193,
        3512,
        1,
        2,
        3,
        4,
        5,
        6
    );
    formatted, formatError := value.toString();
    if formatError != AllocationError.OutOfMemory {
        return 1;
    }
    if formatted != "" {
        return 2;
    }
    return 42;
}
