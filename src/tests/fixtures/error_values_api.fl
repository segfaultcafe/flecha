// Families are resolved before signatures, including forward references.
MathError named_error(bool fail) {
    if fail { return MathError.Overflow; }
    return none;
}

error MathError { DivisionByZero, Overflow, }
error ParseError { DivisionByZero, InvalidDigit }

error generic_error(MathError value) { return value; }
error echo_error(error value) { return value; }

(i32, MathError) checked_divide(i32 a, i32 b) {
    if b == 0 { return (0, MathError.DivisionByZero); }
    return (a / b, none);
}

(i32, error) divide_forward(i32 a, i32 b) {
    return checked_divide(a, b);
}

bool same_error(error a, error b) { return a == b; }
bool strict_error(error a, error b) { return a === b; }

i32 error_comparison_test() {
    MathError named = named_error(true);
    error general = generic_error(named);
    error other = ParseError.InvalidDigit;
    if named == none or general == none { return 1; }
    if general != named or named != general { return 2; }
    if general != MathError.Overflow { return 3; }
    if same_error(MathError.DivisionByZero, ParseError.DivisionByZero) { return 4; }
    if !same_error(MathError.DivisionByZero, MathError.DivisionByZero) { return 5; }
    if same_error(MathError.DivisionByZero, MathError.Overflow) { return 6; }
    if strict_error(general, other) or !strict_error(general, general) { return 7; }
    if MathError.DivisionByZero === ParseError.DivisionByZero { return 8; }
    if general === named or named === general { return 9; }
    if !(general !== named) { return 10; }
    named = none;
    general = named;
    ParseError input = none;
    other = input;
    if general != none or none != named or none != other { return 11; }
    if general != other or !same_error(named, input) { return 12; }
    if named === none or general === none or none === named { return 13; }
    if !(named !== none) or !(none !== general) { return 14; }
    if generic_error(named_error(false)) != none { return 15; }
    general = echo_error(ParseError.InvalidDigit);
    if general != ParseError.InvalidDigit { return 16; }
    return 42;
}

i32 error_tuple_test() {
    q, err := checked_divide(17, 5);
    if q != 3 or err != none { return 1; }
    i32 value, error any = checked_divide(3, 0);
    if value != 0 or any != MathError.DivisionByZero { return 2; }
    value, any = divide_forward(20, 4);
    if value != 5 or any != none { return 3; }
    MathError first, second = (MathError.Overflow, none);
    if first != MathError.Overflow or second != none { return 4; }
    (error, error) pair = (first, ParseError.InvalidDigit);
    a, b := pair;
    if a != first or b != ParseError.InvalidDigit { return 5; }
    (string, (error, i32)) owned = ("failure", (first, 42));
    text, nested := owned;
    failure, number := nested;
    if text != "failure" or failure != first or number != 42 { return 6; }
    _, any = checked_divide(1, 0);
    if any != MathError.DivisionByZero { return 7; }
    return 42;
}

void set_error(&error target, error value) { *target = value; }

i32 error_storage_test() {
    [3]error values = [MathError.Overflow, ParseError.InvalidDigit, none];
    {
        []error slice = values[:];
        set_error(&slice[0], none);
        slice[2] = MathError.DivisionByZero;
        if slice.front() != none or slice.back() != MathError.DivisionByZero { return 8; }
        if slice[0] != none or slice[1] != ParseError.InvalidDigit { return 1; }
    }
    if values[2] != MathError.DivisionByZero { return 2; }
    [2]MathError named = none;
    {
        &MathError item = &named[1];
        *item = MathError.Overflow;
    }
    if named[0] != none or named[1] != MathError.Overflow { return 3; }
    error delayed = none;
    if values[0] == none { delayed = named[1]; }
    else { delayed = none; }
    if delayed != MathError.Overflow { return 4; }
    const error fixed = delayed;
    {
        &const error shared = &fixed;
        if *shared != delayed { return 5; }
    }
    unsafe {
        *error ptr = &raw delayed;
        *ptr = ParseError.InvalidDigit;
    }
    if delayed != ParseError.InvalidDigit { return 6; }
    usize count = 0;
    for (i, value) := range values {
        if value != none { count = count + 1; }
    }
    if count != 2 { return 7; }
    return 42;
}

unsafe void capture_error(*error out, error value) { *out = value; }
unsafe MathError effect(*i32 count) {
    *count = *count + 1;
    return MathError.Overflow;
}

i32 error_defer_test() {
    error captured = none;
    MathError current = MathError.Overflow;
    unsafe {
        defer capture_error(&raw captured, current);
        current = none;
    }
    if captured != MathError.Overflow { return 1; }
    unsafe {
        defer capture_error(&raw captured, current);
    }
    if captured != none { return 2; }
    i32 calls = 0;
    unsafe {
        if effect(&raw calls) === ParseError.InvalidDigit { return 3; }
        if effect(&raw calls) === none { return 4; }
        if none === effect(&raw calls) { return 5; }
    }
    if calls != 3 { return 6; }
    return 42;
}
