module move_only_growth_failure;

@imports :: lib::std::containers::collections;

structure Owner {
    *i32 cleanupCount;
    *i32 cleanupLog;
    i32 id;
};

Owner Owner::zero() override {
    return build Owner {
        self.cleanupCount = null;
        self.cleanupLog = null;
        self.id = 0;
    };
}

Owner Owner::init(*i32 cleanupCount, *i32 cleanupLog, i32 id) override {
    return build Owner {
        self.cleanupCount = cleanupCount;
        self.cleanupLog = cleanupLog;
        self.id = id;
    };
}

void Owner::tear(&self) override {
    unsafe {
        if self->cleanupCount != null {
            *self->cleanupCount += 1;
            *self->cleanupLog = *self->cleanupLog * 10 + self->id;
        }
    }
}

i32 Owner::get(&const self) {
    return self->id;
}

i32 dequeueExpected(&collections::Queue<Owner> values, i32 expected) {
    owner, dequeueError := values->dequeue();

    if dequeueError != none or owner.get() != expected {
        return 1;
    }

    return 42;
}

i32 main() {
    i32 cleanupCount = 0;
    i32 cleanupLog = 0;

    {
        values := collections::Queue<Owner>::init();

        unsafe {
            loop i32 id = 1; id <= 4; id++ {
                if values.enqueue(Owner::init(
                    &raw cleanupCount,
                    &raw cleanupLog,
                    id
                )) != none {
                    return 1;
                }
            }
        }

        Owner rejected = none;
        unsafe {
            rejected = Owner::init(
                &raw cleanupCount,
                &raw cleanupLog,
                9
            );
        }

        if values.enqueue(rejected) != AllocationError.OutOfMemory {
            return 2;
        }

        if cleanupCount != 1 or cleanupLog != 9 or values.len() != 4 or
            values.capacity() != 4 {
            return 3;
        }

        loop i32 expected = 1; expected <= 4; expected++ {
            if dequeueExpected(&values, expected) != 42 {
                return 4;
            }
        }

        if !values.empty() or values.capacity() != 4 {
            return 5;
        }
    }

    if cleanupCount != 5 or cleanupLog != 91234 {
        return 6;
    }

    return 42;
}
