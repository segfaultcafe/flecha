module move_only_front_growth_failure;

@imports :: lib::std::containers::collections;

structure Owner {
    *i32 cleanupCount;
    *i32 cleanupLog;
    i32 id;
};

Owner Owner::zero() override {
    return build Owner {
        self.cleanupCount = null;
        self.cleanupLog = null;
        self.id = 0;
    };
}

Owner Owner::init(
    *i32 cleanupCount,
    *i32 cleanupLog,
    i32 id,
) override {
    return build Owner {
        self.cleanupCount = cleanupCount;
        self.cleanupLog = cleanupLog;
        self.id = id;
    };
}

void Owner::tear(&self) override {
    unsafe {
        if self->cleanupCount != null {
            *self->cleanupCount += 1;
            *self->cleanupLog = *self->cleanupLog * 10 + self->id;
        }
    }
}

i32 Owner::get(&const self) {
    return self->id;
}

i32 popExpected(&collections::Deque<Owner> values, i32 expected) {
    owner, popError := values->popFront();

    if popError != none or owner.get() != expected {
        return 1;
    }

    return 42;
}

i32 main() {
    i32 cleanupCount = 0;
    i32 cleanupLog = 0;

    {
        values := collections::Deque<Owner>::init();

        if values.reserve(4) != none {
            return 1;
        }

        unsafe {
            loop i32 id = 1; id <= 4; id++ {
                if values.pushBack(Owner::init(
                    &raw cleanupCount,
                    &raw cleanupLog,
                    id
                )) != none {
                    return 2;
                }
            }
        }

        _, _ = values.popFront();
        _, _ = values.popFront();

        unsafe {
            loop i32 id = 5; id <= 6; id++ {
                if values.pushBack(Owner::init(
                    &raw cleanupCount,
                    &raw cleanupLog,
                    id
                )) != none {
                    return 3;
                }
            }
        }

        cleanupCount = 0;
        cleanupLog = 0;

        Owner rejected = none;

        unsafe {
            rejected = Owner::init(
                &raw cleanupCount,
                &raw cleanupLog,
                9
            );
        }

        if values.pushFront(rejected) != AllocationError.OutOfMemory {
            return 4;
        }

        if cleanupCount != 1 or cleanupLog != 9 or values.len() != 4 or
            values.capacity() != 4 {
            return 5;
        }

        loop i32 expected = 3; expected <= 6; expected++ {
            if popExpected(&values, expected) != 42 {
                return 6;
            }
        }

        if !values.empty() or values.capacity() != 4 {
            return 7;
        }
    }

    if cleanupCount != 5 or cleanupLog != 93456 {
        return 8;
    }

    return 42;
}
