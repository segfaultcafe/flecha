module move_only_lifecycle;

@imports :: lib::std::containers::collections;

structure Owner {
    *i32 cleanupCount;
    *i32 cleanupLog;
    i32 id;
};

Owner Owner::zero() override {
    return build Owner {
        self.cleanupCount = null;
        self.cleanupLog = null;
        self.id = 0;
    };
}

Owner Owner::init(*i32 cleanupCount, *i32 cleanupLog, i32 id) override {
    return build Owner {
        self.cleanupCount = cleanupCount;
        self.cleanupLog = cleanupLog;
        self.id = id;
    };
}

void Owner::tear(&self) override {
    unsafe {
        if self->cleanupCount != null {
            *self->cleanupCount += 1;
            *self->cleanupLog = *self->cleanupLog * 10 + self->id;
        }
    }
}

i32 Owner::get(&const self) {
    return self->id;
}

bool ownerLess(&const Owner left, &const Owner right) {
    return left->get() < right->get();
}

unsafe i32 earlyReturn(*i32 cleanupCount, *i32 cleanupLog) {
    values := collections::BinaryHeap<Owner>::init(ownerLess);

    if values.push(Owner::init(cleanupCount, cleanupLog, 8)) != none or
        values.push(Owner::init(cleanupCount, cleanupLog, 9)) != none {
        return 1;
    }

    return 42;
}

i32 main() {
    i32 cleanupCount = 0;
    i32 cleanupLog = 0;

    {
        values := collections::BinaryHeap<Owner>::init(ownerLess);

        if values.reserve(8) != none {
            return 1;
        }

        unsafe {
            loop i32 id = 1; id <= 5; id++ {
                if values.push(Owner::init(
                    &raw cleanupCount,
                    &raw cleanupLog,
                    id
                )) != none {
                    return 2;
                }
            }
        }

        {
            extracted, popError := values.pop();
            if popError != none or extracted.get() != 5 {
                return 3;
            }
        }

        if cleanupCount != 1 or cleanupLog != 5 or values.len() != 4 {
            return 4;
        }

        values.clear();

        if cleanupCount != 5 or cleanupLog != 51234 or !values.empty() or
            values.capacity() != 8 {
            return 5;
        }

        unsafe {
            if values.push(Owner::init(
                &raw cleanupCount,
                &raw cleanupLog,
                6
            )) != none or values.push(Owner::init(
                &raw cleanupCount,
                &raw cleanupLog,
                7
            )) != none {
                return 6;
            }
        }
    }

    if cleanupCount != 7 or cleanupLog != 5123467 {
        return 7;
    }

    i32 result = 0;
    unsafe {
        result = earlyReturn(&raw cleanupCount, &raw cleanupLog);
    }

    if result != 42 or cleanupCount != 9 or cleanupLog != 512346789 {
        return 8;
    }

    return 42;
}
