module reflection_visibility_arity;
// expect FLECHA-S0082
decoration meta {
    application() target structure;
    application(stringv name) target structure::field;
};
interface Inspect { void inspect(&self, bool runtime) virtual; };
behavior meta<T> => structure << Inspect {
    void T::inspect(&self, bool runtime) override {
        for<F> Field<T, F> field = T::fields() {
            field::isPrivate(self);
        }
    }
};
@meta structure Item { i32 first; i32 second; };
