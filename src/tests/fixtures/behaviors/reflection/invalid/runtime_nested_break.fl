module runtime_nested_break;
// expect FLECHA-S0081
decoration meta { application() target structure; };
interface Read { void read(&const self) virtual; };
behavior meta<T> => structure << Read {
    void T::read(&const self) override { while true { for<F> Field<T, F> field = T::fields() { break; } } }
};
@meta structure Item { i32 value; };
