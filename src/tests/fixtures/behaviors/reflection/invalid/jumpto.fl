module reflection_jumpto;
// expect FLECHA-S0081
decoration meta { application(stringv name) target structure; application(stringv name) target structure::field; application(stringv name) target enum; application(stringv name) target interface; };
interface Inspect { void inspect(&self) virtual; };
structure Other { i32 first; private i32 hidden; };
behavior meta<T> => structure << Inspect { void T::inspect(&self) override { #out for<F> Field<T, F> field = T::fields() { jumpto out; } } };
structure Item { @meta("first") i32 first; i32 second; };
