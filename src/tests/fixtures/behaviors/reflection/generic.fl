module reflection_generic;
decoration meta { application(stringv name) target structure; application(stringv name) target structure::field; application(stringv name) target enum; application(stringv name) target interface; };
interface Inspect { void inspect(&self) virtual; };
behavior meta<T> => structure << Inspect { void T::inspect(&self) override { for<F> Field<T, F> field = T::fields() { F value = field::get(self); field::get(self) = value; } } };
@meta("box") structure Box<A> { @meta("value") A value; };
void use(Box<i32> a, Box<bool> b) {}
