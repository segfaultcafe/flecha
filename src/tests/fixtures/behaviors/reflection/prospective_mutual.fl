module prospective_mutual;
decoration meta { application() target structure; };
interface Count {
    i32 first(&const self, i32 depth) virtual;
    i32 second(&const self, i32 depth) virtual;
};
behavior meta<T> => structure << Count {
    i32 T::first(&const self, i32 depth) override {
        if T::decorated() {
            if depth > 0 { return self->second(depth - 1); }
        }
        return 0;
    }
    i32 T::second(&const self, i32 depth) override {
        if T::decorated() {
            if depth > 0 { return self->first(depth - 1); }
        }
        return 0;
    }
};
@meta structure Item { i32 value; };
i32 main() { return 0; }
