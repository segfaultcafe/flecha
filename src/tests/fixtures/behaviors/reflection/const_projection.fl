module reflection_const_projection;
decoration meta { application(stringv name) target structure; application(stringv name) target structure::field; application(stringv name) target enum; application(stringv name) target interface; };
interface Inspect { void inspect(&const self) virtual; };
behavior meta<T> => structure << Inspect { void T::inspect(&const self) override { for<F> Field<T, F> field = T::fields() { &const F value = &field::get(self); } } };
@meta("item") structure Item { private i32 first; const i32 second; };
