module reflection_unique_keys;
decoration meta {
    application() target structure;
    application(stringv name) target structure::field;
};
interface Inspect { void inspect(&self, bool runtime) virtual; };
behavior meta<T> => structure << Inspect {
    void T::inspect(&self, bool runtime) override {
        for<F> Field<T, F> field = T::fields() {
            if false { field::requireUnique(runtime); }
            if !field::isPrivate() and (T::decorated() or field::decorated()) {
                if field::decorated() {
                    field::requireUnique(field::decorator().name);
                } else {
                    field::requireUnique(field::name());
                }
            }
        }
    }
};
@meta structure Item {
    @meta("renamed") i32 first;
    i32 second;
    @meta("renamed") private bool ignored;
};
structure Explicit {
    @meta("renamed") bool first;
    i32 renamed;
};
@meta structure Empty {};
@meta structure PrivateOnly { private { i32 first; bool second; } };
