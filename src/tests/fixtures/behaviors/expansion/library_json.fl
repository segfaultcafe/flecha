module expansion_library_json;
decoration json {
    application(structure) target structure;
    application(stringv name) target structure::field;
};
interface JsonWritable {
    error writeJson(&const self, &Writer writer) virtual;
    (own []u8, error) json(&const self) default;
};
(own []u8, error) JsonWritable::json(&const self) {
    writer := Writer::init();
    err := self->writeJson(&writer);
    if err != none { return (none, err); }
    return writer.finish();
}
behavior json<T> => structure << JsonWritable {
    error T::writeJson(&const self, &Writer writer) override {
        err := writer->beginObject();
        if err != none { return err; }
        for<F> Field<T, F> field = T::fields() {
            if !field::isPrivate() {
                err = writer->key(field::name());
                if err != none { return err; }
                err = writer->write(field::get(self));
                if err != none { return err; }
            }
        }
        return writer->endObject();
    }
};

structure Writer { i32 trace; };
Writer Writer::init() override {
    return build Writer { self.trace = 0; };
}
error Writer::beginObject(&self) {
    self->trace = self->trace * 10 + 1;
    return none;
}
error Writer::endObject(&self) {
    self->trace = self->trace * 10 + 3;
    return none;
}
error Writer::key(&self, stringv name) {
    self->trace = self->trace * 10 + 2;
    return none;
}
error Writer::write(&self, i32 value) {
    self->trace = self->trace * 10 + value;
    return none;
}
(own []u8, error) Writer::finish(&const self) {
    output, err := new<own []u8>(1);
    if err != none { return (none, err); }
    if self->trace == 1243 {
        output[0] = 42;
    } else {
        output[0] = 2;
    }
    return (output, none);
}

@json(structure)
structure Response { i32 value; };

i32 main() {
    response := Response::init();
    response.value = 4;

    writer := Writer::init();
    if response.writeJson(&writer) != none { return 1; }
    direct, directError := writer.finish();
    if directError != none or direct.len() != 1 or direct[0] != 42 {
        return 2;
    }

    output, err := response.json();
    if err != none or output.len() != 1 { return 3; }
    return output[0].cast<i32>;
}
