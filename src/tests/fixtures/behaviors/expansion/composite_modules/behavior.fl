module metadata;
export decoration derive { application() target structure; };
export interface Read { i32 read(&const self) virtual; };
A identity<A>(A value) { return value; }
behavior derive<T> => structure << Read {
 i32 T::read(&const self) override {
  i32 total = 0;
  for<F> Field<T, F> field = T::fields() {
   F value = identity<F>(field::get(self));
   total += value[0].answer;
  }
  return total;
 }
};
