module expansion_suppression;
decoration meta { application() target structure; };
interface Read { i32 read(&const self) virtual; };
behavior meta<T> => structure << Read {
 i32 T::read(&const self) override {
  for<F> Field<T, F> field = T::fields() { F value = "invalid for bool"; field::invalid(); }
  return missing_symbol();
 }
};
@meta structure Item { bool value; };
i32 Item::read(&const self) override { return 42; }
i32 main() { Item item; &const Read view = item as &const Read; return view->read(); }
