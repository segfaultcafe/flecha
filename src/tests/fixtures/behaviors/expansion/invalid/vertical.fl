module expansion_vertical;
// expect FLECHA-S0065
decoration meta { application() target structure; };
interface Read { i32 read(&const self) virtual; };
interface Child << Read { bool read(&const self) default; };
bool Child::read(&const self) override { return true; }
behavior meta<T> => structure << Read { i32 T::read(&const self) override { return 42; } };
@meta structure Item {};
