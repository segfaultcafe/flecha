// expect FLECHA-S0069
decoration meta { application() target structure; application() target interface; };
interface Read { i32 read(&const self) virtual; };
behavior meta<T> => structure << Read { i32 T::read(&const self) override { return 42; } };
i32 consume<A: Read>(&const A value) { return value->read(); }
@meta(42) structure Item {};
i32 main() { Item item; return consume<Item>(&item); }
