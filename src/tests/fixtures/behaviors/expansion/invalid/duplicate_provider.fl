module expansion_duplicate_provider;
// expect FLECHA-S0079
decoration meta { application() target structure; };
interface Read { i32 read(&const self) virtual; };
behavior meta<T> => structure << Read { i32 T::read(&const self) override { return 42; } };
decoration other { application() target structure; };
behavior other<T> => structure << Read { i32 T::read(&const self) override { return 1; } };
@meta @other structure Item {};
