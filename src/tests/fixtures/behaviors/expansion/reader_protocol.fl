module expansion_reader_protocol;
decoration meta { application() target structure; };
structure Reader { i32 key; i32 value; own *i32 storage; };
unsafe Reader Reader::init(own *i32 storage) override {
    return build Reader { self.key = 0; self.value = 42; self.storage = storage; };
}
unsafe void Reader::tear(&self) override { free(self->storage); }
interface Read {
    i32 read(&self, &Reader reader) default;
    protected void readField(&self, &Reader reader) virtual;
};
i32 Read::read(&self, &Reader reader) {
    while reader->key < 2 { self->readField(reader); reader->key++; }
    return reader->value;
}
behavior meta<T> => structure << Read {
    protected void T::readField(&self, &Reader reader) override {
        for<F> Field<T, F> field = T::fields() {
            if F.isof<i32> {
                if reader->key == 0 { field::get(self) = reader->value; }
            } else if F.isof<bool> {
                if reader->key == 1 { field::get(self) = true; }
            } else { field::require(false, "unsupported field"); }
        }
    }
};
T from<T: Read>() {
    T value = T::zero();
    unsafe {
        storage, err := new<i32>(0);
        if err != none { return value; }
        reader := Reader::init(storage);
        value.read(&reader);
    }
    return value;
}
@meta structure Item { i32 value; bool flag; };
i32 main() { item := from<Item>(); if !item.flag { return 1; } return item.value; }
