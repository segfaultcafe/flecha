# Checked and forwarding fixtures run this helper concurrently.
get_filename_component(fixture_name "${FLECHA_SOURCE}" NAME_WE)
set(artifact "${CMAKE_CURRENT_BINARY_DIR}/checked-async-${fixture_name}-output")
foreach(mode IN ITEMS check build --emit-llvm --emit-object)
    file(REMOVE "${artifact}")
    set(arguments "${mode}" "${FLECHA_SOURCE}")
    if(NOT mode STREQUAL "check")
        list(APPEND arguments -o "${artifact}")
    endif()
    execute_process(COMMAND "${FLECHA_COMPILER}" ${arguments}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    set(diagnostics "${output}${error}")
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "async ${mode} failed: ${diagnostics}")
    endif()
    if(mode STREQUAL "check")
        if(EXISTS "${artifact}")
            message(FATAL_ERROR "async check unexpectedly emitted an artifact")
        endif()
    elseif(NOT EXISTS "${artifact}")
        message(FATAL_ERROR "async ${mode} did not emit an artifact")
    endif()
    string(REGEX MATCHALL "FLECHA-[A-Z][0-9]+" codes "${diagnostics}")
    if(codes)
        message(FATAL_ERROR "unexpected checked async diagnostic: ${diagnostics}")
    endif()
    if(mode STREQUAL "build")
        execute_process(COMMAND "${artifact}" RESULT_VARIABLE run_status)
        if(NOT run_status EQUAL EXPECTED_EXIT)
            message(FATAL_ERROR
                "async executable returned ${run_status}, expected ${EXPECTED_EXIT}")
        endif()
    endif()
endforeach()
