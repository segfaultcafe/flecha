module main;

@imports
    :: lib::std::containers::collections;

i32 main() {
    numbers := collections::Array<i32>::init();

    i32 i = 0;
    while i < 100 {
        err := numbers.push(i);
        if err != none {
            return 1;
        }
        i++;
    }

    value, err := numbers.get(42);
    if err != none {
        return 2;
    }

    stdout("Array length: ");
    stdoutln(numbers.len());
    stdout("Element 42: ");
    stdoutln(value);
    return value;
}
