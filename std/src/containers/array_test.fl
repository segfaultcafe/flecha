module collections_test;

@imports
    :: root::containers::collections
    :: root::containers::errors
    :: lib::std::tests::testing
    :: lib::std::tests::asserts;

structure PushOwner {
    *i32 cleanupCount;
    i32 value;
};

PushOwner PushOwner::zero() override {
    return build PushOwner {
        self.cleanupCount = null;
        self.value = 0;
    };
}

PushOwner PushOwner::init(*i32 cleanupCount, i32 value) override {
    return build PushOwner {
        self.cleanupCount = cleanupCount;
        self.value = value;
    };
}

void PushOwner::tear(&self) override {
    unsafe {
        if self->cleanupCount != null {
            *self->cleanupCount = *self->cleanupCount + 1;
        }
    }
}

i32 PushOwner::get(&const self) {
    return self->value;
}

test push_moves_grows_and_destroys_noncopyable_values_once(&testing::UnitTest t) {
    i32 cleanupCount = 0;
    {
        values := collections::Array<PushOwner>::init();
        loop i32 value = 10; value <= 50; value = value + 10 {
            PushOwner owner = none;
            unsafe {
                owner = PushOwner::init(&raw cleanupCount, value);
            }

            err := values.push(owner);
            asserts::is_true(t, err == none, "push accepts a movable value");
            if err != none {
                return;
            }
        }

        view := values.view();
        asserts::is_true(
            t,
            view.len() == 5 and view[0].get() == 10 and view[4].get() == 50,
            "growth relocates movable elements in order"
        );
        asserts::is_true(
            t,
            cleanupCount == 0,
            "moving into the array does not destroy the element"
        );
    }

    asserts::is_true(
        t,
        cleanupCount == 5,
        "array destruction cleans every moved element exactly once"
    );
}

test starts_empty_and_pushes_values(&testing::UnitTest t) {
    values := collections::Array<i32>::init();
    asserts::is_true(t, values.empty(), "a new Array is empty");
    asserts::is_true(t, values.len() == 0, "a new Array has length zero");
    asserts::is_true(t, values.capacity() == 0, "a new Array has no allocation");

    reserveError := values.reserve(2);
    firstError := values.push(10);
    secondError := values.push(20);
    asserts::is_true(t, reserveError == none, "reserve succeeds");
    asserts::is_true(t, firstError == none and secondError == none, "push appends values");
    asserts::is_true(t, values.len() == 2, "push increases the length");
    asserts::is_false(t, values.empty(), "an Array with values is not empty");
}

test from_slice_and_append_copy_the_source(&testing::UnitTest t) {
    [2]i32 source = [10, 20];
    values, err := collections::Array<i32>::fromSlice(source[:]);
    asserts::is_true(t, err == none, "fromSlice constructs an Array");
    if err != none {
        return;
    }

    source[0] = 99;
    copied, copiedError := values.get(0);
    asserts::is_true(t, copiedError == none and copied == 10, "fromSlice copies its source");

    [3]i32 added = [30, 40, 50];
    appendError := values.append(added[:]);
    asserts::is_true(t, appendError == none, "append accepts a slice");
    asserts::is_true(t, values.len() == 5, "append increases the length");

    added[2] = 0;
    last, lastError := values.get(4);
    asserts::is_true(t, lastError == none and last == 50, "append copies its source values");

    [0]i32 empty = [];
    const usize capacity = values.capacity();
    asserts::is_true(t, values.append(empty[:]) == none, "appending an empty slice succeeds");
    asserts::is_true(t, values.len() == 5 and values.capacity() == capacity, "an empty append changes nothing");
}

test get_and_set_report_bounds_errors(&testing::UnitTest t) {
    values := collections::Array<i32>::init();
    pushError := values.push(10);
    asserts::is_true(t, pushError == none, "the setup value is appended");
    if pushError != none {
        return;
    }

    setError := values.set(0, 42);
    actual, getError := values.get(0);
    asserts::is_true(t, setError == none, "set accepts an existing index");
    asserts::is_true(t, getError == none and actual == 42, "get reads the updated value");

    missing, boundsError := values.get(1);
    asserts::is_true(t, boundsError == errors::ArrayError.IndexOutOfBounds, "get rejects the end index");
    asserts::is_true(t, missing == none, "a failed get has no value");
    asserts::is_true(
        t,
        values.set(1, 99) == errors::ArrayError.IndexOutOfBounds,
        "set rejects the end index"
    );
}

test remove_preserves_the_remaining_order(&testing::UnitTest t) {
    [4]i32 source = [10, 20, 30, 40];
    values, createError := collections::Array<i32>::fromSlice(source[:]);
    if createError != none {
        asserts::is_true(t, false, "the setup Array is constructed");
        return;
    }

    removed, err := values.remove(1);
    first, firstError := values.get(0);
    middle, middleError := values.get(1);
    last, lastError := values.get(2);
    asserts::is_true(
        t,
        err == none and removed == 20 and values.len() == 3 and
            firstError == none and first == 10 and
            middleError == none and middle == 30 and
            lastError == none and last == 40,
        "remove returns the selected value and preserves the remaining order"
    );
}

test swap_remove_replaces_with_the_last_value(&testing::UnitTest t) {
    [4]i32 source = [10, 20, 30, 40];
    values, createError := collections::Array<i32>::fromSlice(source[:]);
    if createError != none {
        asserts::is_true(t, false, "the setup Array is constructed");
        return;
    }

    removed, err := values.swapRemove(1);
    replacement, replacementError := values.get(1);
    tail, tailError := values.get(2);
    asserts::is_true(
        t,
        err == none and removed == 20 and values.len() == 3 and
            replacementError == none and replacement == 40 and
            tailError == none and tail == 30,
        "swapRemove returns the selected value and fills the gap with the last value"
    );
}

test clone_has_independent_storage(&testing::UnitTest t) {
    [2]i32 source = [10, 20];
    values, createError := collections::Array<i32>::fromSlice(source[:]);
    asserts::is_true(t, createError == none, "the source Array is constructed");
    if createError != none {
        return;
    }

    copy, cloneError := values.clone();
    asserts::is_true(t, cloneError == none, "clone succeeds");
    if cloneError != none {
        return;
    }

    originalSetError := values.set(0, 99);
    copySetError := copy.set(1, 88);
    originalSecond, originalSecondError := values.get(1);
    copiedFirst, copiedFirstError := copy.get(0);
    asserts::is_true(t, originalSetError == none and copySetError == none, "both Arrays remain mutable");
    asserts::is_true(t, originalSecondError == none and originalSecond == 20, "mutating the clone does not affect the source");
    asserts::is_true(t, copiedFirstError == none and copiedFirst == 10, "mutating the source does not affect the clone");
}

test first_last_pop_and_clear_handle_empty_arrays(&testing::UnitTest t) {
    values := collections::Array<i32>::init();

    missingFirst, firstError := values.first();
    missingLast, lastError := values.last();
    missingPop, popError := values.pop();

    firstPush := values.push(10);
    secondPush := values.push(20);
    if firstPush != none or secondPush != none {
        asserts::is_true(t, false, "the setup values are appended");
        return;
    }

    first, populatedFirstError := values.first();
    last, populatedLastError := values.last();
    popped, populatedPopError := values.pop();

    const usize capacity = values.capacity();
    values.clear();
    asserts::is_true(
        t,
        firstError == errors::ArrayError.Empty and missingFirst == none and
            lastError == errors::ArrayError.Empty and missingLast == none and
            popError == errors::ArrayError.Empty and missingPop == none and
            populatedFirstError == none and first == 10 and
            populatedLastError == none and last == 20 and
            populatedPopError == none and popped == 20 and
            values.empty() and values.capacity() == capacity,
        "first, last, pop, and clear preserve the Array lifecycle contract"
    );
}

test for_each_accepts_a_capturing_generic_callback(&testing::UnitTest t) {
    [4]i32 source = [10, 20, 5, 7];
    values, createError := collections::Array<i32>::fromSlice(source[:]);
    if createError != none {
        asserts::is_true(t, false, "the setup Array is constructed");
        return;
    }

    i32 total = 0;
    values.forEach([&total](value) => {
        total = total + *value;
    });
    asserts::is_true(t, total == 42, "forEach invokes a capturing callback for every value");
}

test find_if_delegates_to_a_contextual_predicate(&testing::UnitTest t) {
    [5]i32 source = [5, 2, 7, -3, 2];
    values, createError := collections::Array<i32>::fromSlice(source[:]);
    if createError != none {
        asserts::is_true(t, false, "the setup Array is constructed");
        return;
    }

    index, found := values.findIf((value) => {
        return *value < 0;
    });
    asserts::is_true(t, found and index == 3, "findIf returns the first matching index");

    i32 limit = 10;
    missingIndex, missing := values.findIf([copy limit](value) => {
        return *value > limit;
    });
    asserts::is_true(t, !missing and missingIndex == 0, "findIf reports a missing value");
}

test find_if_accepts_an_empty_array(&testing::UnitTest t) {
    values := collections::Array<i32>::init();
    index, found := values.findIf((value) => {
        return *value == 42;
    });

    asserts::is_true(t, !found and index == 0, "findIf accepts an empty Array");
}

test predicate_and_fold_members_delegate_to_algorithms(&testing::UnitTest t) {
    [5]i32 source = [2, 4, 5, 8, 10];
    values, createError := collections::Array<i32>::fromSlice(source[:]);
    if createError != none {
        asserts::is_true(t, false, "the setup Array is constructed");
        return;
    }

    i32 threshold = 7;
    hasLargeValue := values.anyOf([copy threshold](value) => {
        return *value > threshold;
    });
    allPositive := values.allOf((value) => {
        return *value > 0;
    });
    evenCount := values.countIf((value) => {
        return *value % 2 == 0;
    });
    total := values.fold<i32>(0, (accumulator, value) => {
        return accumulator + *value;
    });

    asserts::is_true(t, hasLargeValue, "Array.anyOf accepts a capturing predicate");
    asserts::is_true(t, allPositive, "Array.allOf delegates to all_of");
    asserts::is_true(t, evenCount == 4, "Array.countIf delegates to count_if");
    asserts::is_true(t, total == 29, "Array.fold delegates to fold");
}

test sort_orders_values_and_handles_small_arrays(&testing::UnitTest t) {
    empty := collections::Array<i32>::init();
    collections::sort<i32>(empty.viewRef());
    asserts::is_true(t, empty.empty(), "sorting an empty Array is a no-op");

    [1]i32 singletonSource = [42];
    singleton, singletonError := collections::Array<i32>::fromSlice(singletonSource[:]);
    if singletonError != none {
        asserts::is_true(t, false, "the singleton Array is constructed");
        return;
    }
    collections::sort<i32>(singleton.viewRef());
    only, onlyError := singleton.get(0);
    asserts::is_true(t, onlyError == none and only == 42, "sorting one value preserves it");

    [7]i32 source = [3, -1, 3, 0, 42, 2, -1];
    values, createError := collections::Array<i32>::fromSlice(source[:]);
    if createError != none {
        asserts::is_true(t, false, "the sortable Array is constructed");
        return;
    }
    collections::sort<i32>(values.viewRef());
    first, firstError := values.get(0);
    second, secondError := values.get(1);
    middle, middleError := values.get(3);
    last, lastError := values.get(6);
    asserts::is_true(
        t,
        firstError == none and first == -1 and
            secondError == none and second == -1 and
            middleError == none and middle == 2 and
            lastError == none and last == 42,
        "sort orders duplicates, negative values, and an unsorted tail"
    );
}

test sort_by_accepts_an_inferred_generic_comparator(&testing::UnitTest t) {
    [5]i32 source = [1, 4, 2, 5, 3];
    values, createError := collections::Array<i32>::fromSlice(source[:]);
    if createError != none {
        asserts::is_true(t, false, "the setup Array is constructed");
        return;
    }

    values.sortBy((left, right) => {
        return *left > *right;
    });
    first, firstError := values.get(0);
    middle, middleError := values.get(2);
    last, lastError := values.get(4);
    asserts::is_true(
        t,
        firstError == none and first == 5 and
            middleError == none and middle == 3 and
            lastError == none and last == 1,
        "sortBy uses the inferred comparator ordering"
    );
}

test set_moves_and_cleans_values_exactly_once(&testing::UnitTest t) {
    i32 cleanupCount = 0;

    {
        values := collections::Array<PushOwner>::init();

        PushOwner original = none;
        unsafe {
            original = PushOwner::init(&raw cleanupCount, 10);
        }

        pushError := values.push(original);
        asserts::is_true(t, pushError == none, "setup push succeeds");
        if pushError != none {
            return;
        }

        PushOwner replacement = none;
        unsafe {
            replacement = PushOwner::init(&raw cleanupCount, 42);
        }

        setError := values.set(0, replacement);
        asserts::is_true(t, setError == none, "set accepts a movable value");
        asserts::is_true(
            t,
            cleanupCount == 1,
            "set destroys the replaced element exactly once"
        );

        view := values.view();
        asserts::is_true(
            t,
            view[0].get() == 42,
            "set stores the replacement value"
        );

        PushOwner rejected = none;
        unsafe {
            rejected = PushOwner::init(&raw cleanupCount, 99);
        }

        boundsError := values.set(1, rejected);
        asserts::is_true(
            t,
            boundsError == errors::ArrayError.IndexOutOfBounds,
            "set rejects an invalid index"
        );
        asserts::is_true(
            t,
            cleanupCount == 2,
            "an invalid set cleans its consumed argument exactly once"
        );

        view = values.view();
        asserts::is_true(
            t,
            view[0].get() == 42,
            "an invalid set leaves the stored element unchanged"
        );
    }

    asserts::is_true(
        t,
        cleanupCount == 3,
        "array destruction cleans the replacement exactly once"
    );
}

test pop_extracts_and_cleans_move_only_values_exactly_once(&testing::UnitTest t) {
    i32 cleanupCount = 0;

    {
        values := collections::Array<PushOwner>::init();
        loop i32 value = 10; value <= 20; value = value + 10 {
            PushOwner owner = none;
            unsafe {
                owner = PushOwner::init(&raw cleanupCount, value);
            }
            if values.push(owner) != none {
                return;
            }
        }

        {
            extracted, err := values.pop();
            asserts::is_true(t, err == none, "pop accepts a move-only element");
            if err != none {
                return;
            }

            asserts::is_true(
                t,
                values.len() == 1 and extracted.get() == 20,
                "pop transfers the final element and decreases the length"
            );
            asserts::is_true(
                t,
                cleanupCount == 0,
                "extracting an element does not destroy it"
            );
        }

        asserts::is_true(
            t,
            cleanupCount == 1,
            "the extracted owner is cleaned exactly once"
        );
        view := values.view();
        asserts::is_true(
            t,
            view.len() == 1 and view[0].get() == 10,
            "pop preserves the remaining initialized prefix"
        );
    }

    asserts::is_true(
        t,
        cleanupCount == 2,
        "array destruction cleans only the remaining owner"
    );
}

test pop_transfers_a_nested_array(&testing::UnitTest t) {
    outer := collections::Array<collections::Array<i32>>::init();
    inner := collections::Array<i32>::init();
    pushInner := inner.push(42);
    pushOuter := outer.push(inner);
    asserts::is_true(
        t,
        pushInner == none and pushOuter == none,
        "nested array setup succeeds"
    );
    if pushInner != none or pushOuter != none {
        return;
    }

    extracted, err := outer.pop();
    asserts::is_true(
        t,
        err == none and outer.empty(),
        "pop transfers the nested owner out of the outer array"
    );
    if err != none {
        return;
    }

    view := extracted.view();
    asserts::is_true(
        t,
        view.len() == 1 and view[0] == 42,
        "the extracted nested array retains its allocation and values"
    );
}

test remove_relocates_move_only_values_and_cleans_each_once(&testing::UnitTest t) {
    i32 cleanupCount = 0;

    {
        values := collections::Array<PushOwner>::init();
        loop i32 value = 10; value <= 30; value = value + 10 {
            PushOwner owner = none;
            unsafe {
                owner = PushOwner::init(&raw cleanupCount, value);
            }
            if values.push(owner) != none {
                return;
            }
        }

        {
            removed, err := values.remove(1);
            asserts::is_true(t, err == none, "remove accepts move-only elements");
            if err != none {
                return;
            }

            view := values.view();
            asserts::is_true(
                t,
                removed.get() == 20 and view.len() == 2 and
                    view[0].get() == 10 and view[1].get() == 30,
                "remove transfers its result and relocates later owners in order"
            );
            asserts::is_true(
                t,
                cleanupCount == 0,
                "ordered relocation does not destroy an owner"
            );
        }

        asserts::is_true(
            t,
            cleanupCount == 1,
            "the owner returned by remove is cleaned exactly once"
        );

        missing, boundsError := values.remove(2);
        asserts::is_true(
            t,
            boundsError == errors::ArrayError.IndexOutOfBounds,
            "remove rejects an invalid index"
        );
        view := values.view();
        asserts::is_true(
            t,
            missing == none and cleanupCount == 1 and view.len() == 2 and
                view[0].get() == 10 and view[1].get() == 30,
            "an invalid remove leaves owners and cleanup unchanged"
        );
    }

    asserts::is_true(
        t,
        cleanupCount == 3,
        "array destruction cleans the owners remaining after remove"
    );
}

test swap_remove_relocates_move_only_tail_and_cleans_each_once(&testing::UnitTest t) {
    i32 cleanupCount = 0;

    {
        values := collections::Array<PushOwner>::init();
        loop i32 value = 10; value <= 30; value = value + 10 {
            PushOwner owner = none;
            unsafe {
                owner = PushOwner::init(&raw cleanupCount, value);
            }
            if values.push(owner) != none {
                return;
            }
        }

        {
            removed, err := values.swapRemove(0);
            asserts::is_true(
                t,
                err == none,
                "swapRemove accepts move-only elements"
            );
            if err != none {
                return;
            }

            view := values.view();
            asserts::is_true(
                t,
                removed.get() == 10 and view.len() == 2 and
                    view[0].get() == 30 and view[1].get() == 20,
                "swapRemove transfers its result and relocates the final owner"
            );
            asserts::is_true(
                t,
                cleanupCount == 0,
                "unordered relocation does not destroy an owner"
            );
        }

        asserts::is_true(
            t,
            cleanupCount == 1,
            "the owner returned by swapRemove is cleaned exactly once"
        );

        missing, boundsError := values.swapRemove(2);
        asserts::is_true(
            t,
            boundsError == errors::ArrayError.IndexOutOfBounds,
            "swapRemove rejects an invalid index"
        );
        view := values.view();
        asserts::is_true(
            t,
            missing == none and cleanupCount == 1 and view.len() == 2 and
                view[0].get() == 30 and view[1].get() == 20,
            "an invalid swapRemove leaves owners and cleanup unchanged"
        );
    }

    asserts::is_true(
        t,
        cleanupCount == 3,
        "array destruction cleans the owners remaining after swapRemove"
    );
}

test remove_transfers_a_nested_array_and_preserves_outer_order(&testing::UnitTest t) {
    outer := collections::Array<collections::Array<i32>>::init();
    first := collections::Array<i32>::init();
    second := collections::Array<i32>::init();
    firstPush := first.push(42);
    secondPush := second.push(99);
    firstOuterPush := outer.push(first);
    secondOuterPush := outer.push(second);
    if firstPush != none or secondPush != none or firstOuterPush != none or
        secondOuterPush != none {
        asserts::is_true(t, false, "nested remove setup succeeds");
        return;
    }

    removed, removeError := outer.remove(0);
    if removeError != none {
        asserts::is_true(t, false, "nested remove succeeds");
        return;
    }

    remaining, popError := outer.pop();
    if popError != none {
        asserts::is_true(t, false, "the relocated nested owner remains usable");
        return;
    }

    removedView := removed.view();
    remainingView := remaining.view();
    asserts::is_true(
        t,
        outer.empty() and removedView.len() == 1 and removedView[0] == 42 and
            remainingView.len() == 1 and remainingView[0] == 99,
        "remove transfers one inner allocation and preserves the relocated one"
    );
}
