module algorithms_test;

@imports
    :: root::containers::algorithms
    :: root::containers::array
    :: lib::std::tests::testing
    :: lib::std::tests::asserts;

test index_of_finds_the_first_match(&testing::UnitTest t) {
    [5]i32 values = [10, 20, 30, 20, 40];

    index, found := algorithms::index_of<i32>(values[:], 20);
    asserts::is_true(t, found, "index_of finds a present value");

    usize expected = 1;
    asserts::equal<usize>(t, &expected, &index, "index_of returns the first matching index");
}

test index_of_reports_missing_and_empty_values(&testing::UnitTest t) {
    [3]i32 values = [10, 20, 30];
    index, found := algorithms::index_of<i32>(values[:], 99);

    asserts::is_false(t, found, "index_of reports a missing value");
    usize zero = 0;
    asserts::equal<usize>(t, &zero, &index, "a missing value returns index zero");

    [0]i32 empty = [];
    emptyIndex, foundEmpty := algorithms::index_of<i32>(empty[:], 42);
    asserts::is_false(t, foundEmpty, "index_of accepts an empty slice");
    asserts::equal<usize>(t, &zero, &emptyIndex, "an empty slice returns index zero");
}

test contains_reports_membership(&testing::UnitTest t) {
    [4]i32 values = [1, 2, 3, 4];
    [0]i32 empty = [];

    asserts::is_true(t, algorithms::contains<i32>(values[:], 3), "contains finds a present value");
    asserts::is_false(t, algorithms::contains<i32>(values[:], 9), "contains rejects a missing value");
    asserts::is_false(t, algorithms::contains<i32>(empty[:], 1), "contains accepts an empty slice");
}

test reverse_mutates_slices_in_place(&testing::UnitTest t) {
    [5]i32 odd = [1, 2, 3, 4, 5];
    algorithms::reverse<i32>(odd[:]);

    asserts::is_true(
        t,
        odd[0] == 5 and odd[1] == 4 and odd[2] == 3 and odd[3] == 2 and odd[4] == 1,
        "reverse handles an odd-length slice"
    );

    [4]i32 even = [10, 20, 30, 40];
    algorithms::reverse<i32>(even[:]);
    asserts::is_true(
        t,
        even[0] == 40 and even[1] == 30 and even[2] == 20 and even[3] == 10,
        "reverse handles an even-length slice"
    );

    [0]i32 empty = [];
    algorithms::reverse<i32>(empty[:]);
    asserts::is_true(t, empty.len() == 0, "reverse accepts an empty slice");
}

test fill_mutates_every_element(&testing::UnitTest t) {
    [4]i32 values = [1, 2, 3, 4];
    algorithms::fill<i32>(values[:], 7);

    asserts::is_true(
        t,
        values[0] == 7 and values[1] == 7 and values[2] == 7 and values[3] == 7,
        "fill replaces every element"
    );

    [0]i32 empty = [];
    algorithms::fill<i32>(empty[:], 7);
    asserts::is_true(t, empty.len() == 0, "fill accepts an empty slice");
}

test array_members_delegate_to_algorithms(&testing::UnitTest t) {
    [4]i32 source = [1, 2, 3, 4];
    values, err := array::Array<i32>::fromSlice(source[:]);
    asserts::is_true(t, err == none, "Array can be created from a slice");
    if err != none {
        return;
    }

    index, found := values.indexOf(3);
    usize expectedIndex = 2;
    asserts::is_true(t, found, "Array.indexOf finds a present value");
    asserts::equal<usize>(t, &expectedIndex, &index, "Array.indexOf returns its index");
    asserts::is_true(t, values.contains(1), "Array.contains finds a present value");
    asserts::is_false(t, values.contains(9), "Array.contains rejects a missing value");

    values.reverse();
    first, firstError := values.get(0);
    last, lastError := values.get(3);
    asserts::is_true(t, firstError == none and first == 4, "Array.reverse moves the last value first");
    asserts::is_true(t, lastError == none and last == 1, "Array.reverse moves the first value last");

    values.fill(42);
    loop usize i = 0; i < values.len(); i++ {
        value, getError := values.get(i);
        asserts::is_true(t, getError == none and value == 42, "Array.fill replaces an element");
    }
}
