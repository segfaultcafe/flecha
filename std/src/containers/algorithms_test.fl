module collections_test;

@imports
    :: root::containers::collections
    :: lib::std::tests::testing
    :: lib::std::tests::asserts;

bool is_negative(&const i32 value) {
    return *value < 0;
}

bool descending_less(&const i32 left, &const i32 right) {
    return *left > *right;
}

bool same_absolute_value(&const i32 left, &const i32 right) {
    i32 leftValue = *left;
    if leftValue < 0 {
        leftValue = -leftValue;
    }

    i32 rightValue = *right;
    if rightValue < 0 {
        rightValue = -rightValue;
    }
    return leftValue == rightValue;
}

test find_if_returns_the_first_matching_index(&testing::UnitTest t) {
    [5]i32 values = [1, 4, 8, 12, 16];
    i32 threshold = 7;
    usize visits = 0;

    index, found := collections::find_if<i32>(
        values[:],
        [&const threshold, &visits](value) => {
            visits++;
            return *value > threshold;
        }
    );

    asserts::is_true(t, found, "find_if reports a matching value");
    asserts::is_true(t, index == 2, "find_if returns the first matching index");
    asserts::is_true(t, visits == 3, "find_if stops after the first match");
}

test find_if_accepts_named_functions_and_empty_slices(&testing::UnitTest t) {
    [4]i32 values = [3, 2, -5, -8];
    index, found := collections::find_if<i32>(values[:], is_negative);
    asserts::is_true(t, found and index == 2, "find_if accepts a named predicate");

    [3]i32 positive = [1, 2, 3];
    missingIndex, missing := collections::find_if<i32>(positive[:], is_negative);
    asserts::is_true(t, !missing and missingIndex == 0, "find_if reports a missing value");

    [0]i32 empty = [];
    emptyIndex, foundEmpty := collections::find_if<i32>(empty[:], is_negative);
    asserts::is_true(t, !foundEmpty and emptyIndex == 0, "find_if accepts an empty slice");
}

test ordered_search_finds_duplicate_ranges_and_insertion_points(
    &testing::UnitTest t,
) {
    [6]i32 values = [1, 2, 2, 2, 4, 8];
    i32 present = 2;
    i32 between = 3;
    i32 before = 0;
    i32 after = 9;

    presentIndex, foundPresent := collections::binary_search<i32>(
        values[:],
        &present
    );
    betweenIndex, foundBetween := collections::binary_search<i32>(
        values[:],
        &between
    );

    asserts::is_true(
        t,
        collections::lower_bound<i32>(values[:], &present) == 1 and
            collections::upper_bound<i32>(values[:], &present) == 4 and
            foundPresent and presentIndex == 1,
        "ordered search returns the complete duplicate range"
    );
    asserts::is_true(
        t,
        !foundBetween and betweenIndex == 4 and
            collections::lower_bound<i32>(values[:], &before) == 0 and
            collections::upper_bound<i32>(values[:], &after) == 6,
        "ordered search returns boundary insertion points for missing values"
    );
}

test ordered_search_accepts_custom_ordering_and_empty_slices(
    &testing::UnitTest t,
) {
    [5]i32 descending = [9, 7, 7, 3, 1];
    i32 needle = 7;

    index, found := collections::binary_search_by<i32>(
        descending[:],
        &needle,
        descending_less
    );
    asserts::is_true(
        t,
        found and index == 1 and
            collections::lower_bound_by<i32>(
                descending[:], &needle, descending_less
            ) == 1 and
            collections::upper_bound_by<i32>(
                descending[:], &needle, descending_less
            ) == 3,
        "ordered search follows caller-supplied ordering"
    );

    [0]i32 empty = [];
    emptyIndex, foundEmpty := collections::binary_search<i32>(
        empty[:],
        &needle
    );
    asserts::is_true(
        t,
        !foundEmpty and emptyIndex == 0 and
            collections::lower_bound<i32>(empty[:], &needle) == 0 and
            collections::upper_bound<i32>(empty[:], &needle) == 0,
        "ordered search accepts an empty range"
    );
}

test index_of_finds_the_first_match(&testing::UnitTest t) {
    [5]i32 values = [10, 20, 30, 20, 40];

    index, found := collections::index_of<i32>(values[:], 20);
    asserts::is_true(t, found, "index_of finds a present value");

    usize expected = 1;
    asserts::equal<usize>(t, &expected, &index, "index_of returns the first matching index");
}

test index_of_reports_missing_and_empty_values(&testing::UnitTest t) {
    [3]i32 values = [10, 20, 30];
    index, found := collections::index_of<i32>(values[:], 99);

    asserts::is_false(t, found, "index_of reports a missing value");
    usize zero = 0;
    asserts::equal<usize>(t, &zero, &index, "a missing value returns index zero");

    [0]i32 empty = [];
    emptyIndex, foundEmpty := collections::index_of<i32>(empty[:], 42);
    asserts::is_false(t, foundEmpty, "index_of accepts an empty slice");
    asserts::equal<usize>(t, &zero, &emptyIndex, "an empty slice returns index zero");
}

test contains_reports_membership(&testing::UnitTest t) {
    [4]i32 values = [1, 2, 3, 4];
    [0]i32 empty = [];

    asserts::is_true(t, collections::contains<i32>(values[:], 3), "contains finds a present value");
    asserts::is_false(t, collections::contains<i32>(values[:], 9), "contains rejects a missing value");
    asserts::is_false(t, collections::contains<i32>(empty[:], 1), "contains accepts an empty slice");
}

test reverse_mutates_slices_in_place(&testing::UnitTest t) {
    [5]i32 odd = [1, 2, 3, 4, 5];
    collections::reverse<i32>(odd[:]);

    asserts::is_true(
        t,
        odd[0] == 5 and odd[1] == 4 and odd[2] == 3 and odd[3] == 2 and odd[4] == 1,
        "reverse handles an odd-length slice"
    );

    [4]i32 even = [10, 20, 30, 40];
    collections::reverse<i32>(even[:]);
    asserts::is_true(
        t,
        even[0] == 40 and even[1] == 30 and even[2] == 20 and even[3] == 10,
        "reverse handles an even-length slice"
    );

    [0]i32 empty = [];
    collections::reverse<i32>(empty[:]);
    asserts::is_true(t, empty.len() == 0, "reverse accepts an empty slice");
}

test fill_mutates_every_element(&testing::UnitTest t) {
    [4]i32 values = [1, 2, 3, 4];
    collections::fill<i32>(values[:], 7);

    asserts::is_true(
        t,
        values[0] == 7 and values[1] == 7 and values[2] == 7 and values[3] == 7,
        "fill replaces every element"
    );

    [0]i32 empty = [];
    collections::fill<i32>(empty[:], 7);
    asserts::is_true(t, empty.len() == 0, "fill accepts an empty slice");
}

test partition_groups_matches_and_returns_the_boundary(&testing::UnitTest t) {
    [6]i32 values = [1, 2, 3, 4, 5, 6];
    usize visits = 0;
    boundary := collections::partition_by<i32>(
        values[:],
        [&visits](value) => {
            visits++;
            return *value % 2 == 0;
        }
    );

    bool grouped = true;
    loop usize index = 0; index < boundary; index++ {
        if values[index] % 2 != 0 {
            grouped = false;
        }
    }
    loop usize index = boundary; index < values.len(); index++ {
        if values[index] % 2 == 0 {
            grouped = false;
        }
    }

    asserts::is_true(
        t,
        boundary == 3 and visits == 6 and grouped,
        "partition visits once and separates accepted values"
    );

    [0]i32 empty = [];
    emptyBoundary := collections::partition_by<i32>(empty[:], is_negative);
    asserts::is_true(t, emptyBoundary == 0, "partition accepts an empty slice");
}

test dedup_compacts_adjacent_equivalent_values(&testing::UnitTest t) {
    [7]i32 values = [1, 1, 2, 2, 2, 3, 3];
    uniqueLength := collections::dedup<i32>(values[:]);
    asserts::is_true(
        t,
        uniqueLength == 3 and values[0] == 1 and
            values[1] == 2 and values[2] == 3,
        "dedup returns the compacted unique prefix"
    );

    [5]i32 magnitudes = [1, -1, 2, -2, 2];
    magnitudeLength := collections::dedup_by<i32>(
        magnitudes[:],
        same_absolute_value
    );
    asserts::is_true(
        t,
        magnitudeLength == 2 and magnitudes[0] == 1 and magnitudes[1] == 2,
        "dedup_by uses caller-supplied equivalence"
    );

    [0]i32 empty = [];
    [1]i32 singleton = [42];
    asserts::is_true(
        t,
        collections::dedup<i32>(empty[:]) == 0 and
            collections::dedup<i32>(singleton[:]) == 1,
        "dedup preserves empty and singleton ranges"
    );
}

test callback_algorithms_accept_generic_callable_specializations(&testing::UnitTest t) {
    [4]i32 values = [4, 1, 3, 2];
    i32 total = 0;
    collections::for_each<i32>(values[:], [&total](value) => {
        total = total + *value;
    });
    asserts::is_true(t, total == 10, "for_each accepts an inferred capturing callback");

    collections::sort<i32>(values[:]);
    asserts::is_true(
        t,
        values[0] == 1 and values[1] == 2 and values[2] == 3 and values[3] == 4,
        "sort orders a mutable slice"
    );

    collections::sort_by<i32>(values[:], (left, right) => {
        return *left > *right;
    });
    asserts::is_true(
        t,
        values[0] == 4 and values[1] == 3 and values[2] == 2 and values[3] == 1,
        "sort_by accepts an inferred comparator"
    );
}

test array_members_delegate_to_algorithms(&testing::UnitTest t) {
    [4]i32 source = [1, 2, 3, 4];
    values, err := collections::Array<i32>::fromSlice(source[:]);
    asserts::is_true(t, err == none, "Array can be created from a slice");
    if err != none {
        return;
    }

    index, found := values.indexOf(3);
    usize expectedIndex = 2;
    asserts::is_true(t, found, "Array.indexOf finds a present value");
    asserts::equal<usize>(t, &expectedIndex, &index, "Array.indexOf returns its index");
    asserts::is_true(t, values.contains(1), "Array.contains finds a present value");
    asserts::is_false(t, values.contains(9), "Array.contains rejects a missing value");

    i32 orderedNeedle = 3;
    orderedIndex, orderedFound := values.binarySearch(&orderedNeedle);
    asserts::is_true(
        t,
        orderedFound and orderedIndex == 2 and
            values.lowerBound(&orderedNeedle) == 2 and
            values.upperBound(&orderedNeedle) == 3,
        "Array ordered-search members delegate to slice algorithms"
    );

    values.reverse();
    first, firstError := values.get(0);
    last, lastError := values.get(3);
    asserts::is_true(t, firstError == none and first == 4, "Array.reverse moves the last value first");
    asserts::is_true(t, lastError == none and last == 1, "Array.reverse moves the first value last");

    values.fill(42);
    loop usize i = 0; i < values.len(); i++ {
        value, getError := values.get(i);
        asserts::is_true(t, getError == none and value == 42, "Array.fill replaces an element");
    }
}

test array_partition_and_dedup_update_logical_values(&testing::UnitTest t) {
    [7]i32 source = [1, 1, 2, 2, 3, 3, 4];
    values, createError := collections::Array<i32>::fromSlice(source[:]);
    if createError != none {
        asserts::is_true(t, false, "the Array is constructed");
        return;
    }

    uniqueLength := values.dedup();
    boundary := values.partitionBy((value) => {
        return *value % 2 == 0;
    });
    view := values.view();

    asserts::is_true(
        t,
        uniqueLength == 4 and values.len() == 4 and boundary == 2 and
            view[0] % 2 == 0 and view[1] % 2 == 0 and
            view[2] % 2 != 0 and view[3] % 2 != 0,
        "Array dedup shrinks and partition returns its logical boundary"
    );
}

test predicate_algorithms_short_circuit_and_count(&testing::UnitTest t) {
    [5]i32 values = [2, 4, 6, 7, 8];

    usize anyVisits = 0;
    hasOdd := collections::any_of<i32>(
        values[:],
        [&anyVisits](value) => {
            anyVisits++;
            return *value % 2 != 0;
        }
    );

    asserts::is_true(t, hasOdd, "any_of finds a matching value");
    asserts::is_true(t, anyVisits == 4, "any_of stops at the first match");

    usize allVisits = 0;
    allEven := collections::all_of<i32>(
        values[:],
        [&allVisits](value) => {
            allVisits++;
            return *value % 2 == 0;
        }
    );

    asserts::is_false(t, allEven, "all_of rejects the first nonmatching value");
    asserts::is_true(t, allVisits == 4, "all_of stops at the first mismatch");

    usize countVisits = 0;
    evenCount := collections::count_if<i32>(values[:], [&countVisits](value) => {
        countVisits++;
        return *value % 2 == 0;
    });

    asserts::is_true(t, evenCount == 4, "count_if counts every match");
    asserts::is_true(t, countVisits == 5, "count_if visits every value");

    [0]i32 empty = [];
    usize emptyVisits = 0;
    emptyAny := collections::any_of<i32>(empty[:], [&emptyVisits](value) => {
        emptyVisits++;
        return *value == 0;
    });
    emptyAll := collections::all_of<i32>(empty[:], [&emptyVisits](value) => {
        emptyVisits++;
        return *value == 0;
    });
    emptyCount := collections::count_if<i32>(empty[:], [&emptyVisits](value) => {
        emptyVisits++;
        return *value == 0;
    });

    asserts::is_false(t, emptyAny, "any_of is false for an empty slice");
    asserts::is_true(t, emptyAll, "all_of is true for an empty slice");
    asserts::is_true(t, emptyCount == 0, "count_if returns zero for an empty slice");
    asserts::is_true(t, emptyVisits == 0, "empty predicate algorithms do not invoke their predicate");
}

test fold_reduces_values_and_preserves_empty_initial_value(
    &testing::UnitTest t
) {
    [4]i32 values = [1, 2, 3, 4];

    total := collections::fold<i32, i32>(
        values[:],
        10,
        (accumulator, value) => {
            return accumulator + *value;
        }
    );

    asserts::is_true(t, total == 20, "fold reduces values from its initial value");

    ordered := collections::fold<i32, i32>(
        values[:],
        20,
        (accumulator, value) => {
            return accumulator - *value;
        }
    );

    asserts::is_true(t, ordered == 10, "fold processes values from left to right");

    [0]i32 empty = [];
    emptyTotal := collections::fold<i32, i32>(
        empty[:],
        42,
        (accumulator, value) => {
            return accumulator + *value;
        }
    );

    asserts::is_true(t, emptyTotal == 42, "fold returns the initial value for an empty slice");
}
