module algorithms;

@imports :: root::memory::slices as mem_slices;

// Receives a shared reference to one element for its side effects.
export func Action<T>(&const T) => ();

// Reports whether left must be ordered before right.
export func Less<T>(&const T left, &const T right) => (bool);

// Selects elements for searching or aggregation.
export func Predicate<T>(&const T value) => (bool);

// Combines an accumulator with the next borrowed element.
export func Folder<T, A>(A accumulator, &const T value) => (A);

// Reports whether predicate accepts an element, stopping at the first match.
export bool any_of<T>([]const T values, Predicate<T> predicate) {
    loop usize index = 0; index < values.len(); index++ {
        if predicate(&values[index]) {
            return true;
        }
    }

    return false;
}

// Reports whether predicate accepts every element, stopping at the first
// rejection and returning true for an empty slice.
export bool all_of<T>([]const T values, Predicate<T> predicate) {
    loop usize index = 0; index < values.len(); index++ {
        if !predicate(&values[index]) {
            return false;
        }
    }

    return true;
}

// Counts the elements accepted by predicate.
export usize count_if<T>([]const T values, Predicate<T> predicate) {
    usize count = 0;
    loop usize index = 0; index < values.len(); index++ {
        if predicate(&values[index]) {
            count++;
        }
    }

    return count;
}

// Folds elements from left to right, beginning with initial.
export A fold<T, A>([]const T values, A initial, Folder<T, A> folder) {
    A accumulator = initial;
    loop usize index = 0; index < values.len(); index++ {
        accumulator = folder(accumulator, &values[index]);
    }

    return accumulator;
}

// Returns the first accepted index and true, or zero and false when absent.
export (usize, bool) find_if<T>([]const T values, Predicate<T> predicate) {
    loop usize index = 0; index < values.len(); index++ {
        if predicate(&values[index]) {
            return (index, true);
        }
    }

    return (none, false);
}

// Returns the first index equal to needle and true, or zero and false.
export (usize, bool) index_of<T>([]const T values, T needle) {
    for (i, val) := range values {
        if val == needle {
            return (i, true);
        }
    }

    return (none, false);
}

// Reports whether any element is equal to needle.
export bool contains<T>([]const T values, T needle) {
    _, found := index_of<T>(values, needle);
    return found;
}

// Reverses a slice in place using semantic element copies.
export void reverse<T>([]T values) {
    usize left = 0;
    usize right = values.len();

    while left < right {
        right = right - 1;
        if left >= right {
            break;
        }

        T temporary = values[left];
        values[left] = values[right];
        values[right] = temporary;

        left++;
    }
}

// Replaces every element with a semantic copy of value.
export void fill<T>([]T values, T value) {
    mem_slices::fill<T>(values, value);
}

// Calls action once for each element in index order.
export void for_each<T>([]const T values, Action<T> action) {
    loop usize index = 0; index < values.len(); index++ {
        action(&values[index]);
    }
}

// Sorts in place with an unstable heap sort using less as a strict ordering.
export void sort_by<T>([]T values, Less<T> less) {
    const usize LEN = values.len();

    if LEN < 2 {
        return;
    }

    usize root = LEN / 2;
    while root > 0 {
        root = root - 1;

        usize current = root;
        while current < LEN / 2 {
            usize child = current * 2 + 1;
            if child + 1 < LEN and
                less(&values[child], &values[child + 1]) {
                child++;
            }

            if !less(&values[current], &values[child]) {
                break;
            }

            T temporary = values[current];
            values[current] = values[child];
            values[child] = temporary;
            current = child;
        }
    }

    usize heapLen = LEN;
    while heapLen > 1 {
        heapLen = heapLen - 1;

        T temporary = values[0];
        values[0] = values[heapLen];
        values[heapLen] = temporary;

        usize current = 0;
        while current < heapLen / 2 {
            usize child = current * 2 + 1;
            if child + 1 < heapLen and
                less(&values[child], &values[child + 1]) {
                child++;
            }

            if !less(&values[current], &values[child]) {
                break;
            }

            temporary = values[current];
            values[current] = values[child];
            values[child] = temporary;
            current = child;
        }
    }
}

// Sorts in ascending order with the element type's less-than operation.
export void sort<T>([]T values) {
    sort_by<T>(
        values,
        [](&const T left, &const T right) => (bool) {
            return *left < *right;
        }
    );
}
