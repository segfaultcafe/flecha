module collections;

@imports
    :: root::containers::raw_array
    :: root::containers::errors;

// Owns a growable sequence and exposes safe checked element operations.
export structure Array<T> {
    private raw_array::RawArray<T> inner; 
};

// Copies source into a newly allocated array in index order.
(Array<T>, error) Array<T>::fromSlice([]const T source) {
    res := Array<T>::init();

    err := res.reserve(source.len());
    if err != none {
        return (none, err);
    }

    loop usize index = 0; index < source.len(); index++ {
        err = res.push(source[index]);
        if err != none {
            return (none, err);
        }
    }

    return (res, none);
}

// Returns the number of logical elements.
usize Array<T>::len(&const self) {
    return self->inner.len();
}

// Returns the number of elements that fit without another allocation.
usize Array<T>::capacity(&const self) {
    return self->inner.capacity();
}

// Ensures at least capacity elements fit while preserving existing contents.
error Array<T>::reserve(&self, usize capacity) {
    unsafe {
        return self->inner.reserve(capacity);
    }
}

// Appends value, copying a copyable value or consuming a movable value.
error Array<T>::push(&self, T value) {
    unsafe {
        return self->inner.push(value);
    }
}

// Returns the first index equal to value and true, or zero and false.
(usize, bool) Array<T>::indexOf(&const self, T value) {
    return index_of<T>(self->view(), value);
}

// Reports whether an element is equal to value.
bool Array<T>::contains(&const self, T value) {
    return contains<T>(self->view(), value);
}

// Reverses the logical elements in place.
void Array<T>::reverse(&self) {
    unsafe {
        self->inner.reverse();
    }
}

// Replaces every logical element with a semantic copy of value.
void Array<T>::fill(&self, T value) {
    fill<T>(self->viewRef(), value);
}

// Appends semantic copies of source, preserving contents on allocation error.
error Array<T>::append(&self, []const T source) {
    const usize CURRENT = self->len();
    const usize ADDED = source.len();
    const usize REQUIRED = CURRENT + ADDED;

    // unsigned integer overflow condition
    bool overflow = REQUIRED < CURRENT;
    if overflow {
        return AllocationError.OutOfMemory;
    }

    err := self->reserve(REQUIRED);
    if err != none {
        return err;
    }

    loop usize i = 0; i < ADDED; i++ {
        err = self->push(source[i]);
        if err != none {
            return err;
        }
    }

    return none;
}

// Creates an independent semantic copy of the array and its elements.
(Array<T>, error) Array<T>::clone(&const self) {
    return Array<T>::fromSlice(self->view());
}

// Copies the element at index or reports ArrayError.IndexOutOfBounds.
(T, error) Array<T>::get(&const self, usize index) {
    unsafe {
        return self->inner.get(index);
    }
}

// Replaces the element at index or reports ArrayError.IndexOutOfBounds.
error Array<T>::set(&self, usize index, T value) {
    unsafe {
        return self->inner.set(index, value);
    }
}

// Removes and returns the indexed element while preserving element order.
(T, error) Array<T>::remove(&self, usize index) {
    unsafe {
        return self->inner.remove(index);
    }
}

// Removes and returns an element by replacing it with the final element.
(T, error) Array<T>::swapRemove(&self, usize index) {
    unsafe {
        return self->inner.swapRemove(index);
    }
}

// Removes and returns the final element, or reports ArrayError.Empty.
(T, error) Array<T>::pop(&self) {
    unsafe {
        return self->inner.pop();
    }
}

// Borrows all logical elements as a read-only slice.
[]const T Array<T>::view(&const self) <-self {
    unsafe {
        return self->inner.view();
    }
}

// Mutably borrows all logical elements as a slice.
[]T Array<T>::viewRef(&self) <-self {
    unsafe {
        return self->inner.viewRef();
    }
}

// Reports whether the array contains no logical elements.
bool Array<T>::empty(&const self) {
    return self->len() == 0;
}

// Copies the first element or reports ArrayError.Empty.
(T, error) Array<T>::first(&const self) {
    if self->empty() {
        return (none, errors::ArrayError.Empty);
    }

    return self->get(0);
}

// Copies the final element or reports ArrayError.Empty.
(T, error) Array<T>::last(&const self) {
    if self->empty() {
        return (none, errors::ArrayError.Empty);
    }

    const usize LAST = self->len() - 1;
    return self->get(LAST);
}

// Removes all logical elements while retaining the allocation.
void Array<T>::clear(&self) {
    self->inner.clear();
}

// Sorts elements in place with less as a strict ordering.
void Array<T>::sortBy(&self, Less<T> less) {
    const usize LEN = self->len();
    if LEN < 2 {
        return;
    }

    usize root = LEN / 2;
    while root > 0 {
        root--;

        usize current = root;
        while current < LEN / 2 {
            usize child = current * 2 + 1;
            bool preferRight = false;
            if child + 1 < LEN {
                values := self->view();
                preferRight = less(&values[child], &values[child + 1]);
            }
            if preferRight {
                child++;
            }

            bool ordered = false;
            {
                values := self->view();
                ordered = !less(&values[current], &values[child]);
            }
            if ordered {
                break;
            }

            unsafe {
                self->inner.swap(current, child);
            }
            current = child;
        }
    }

    usize heapLen = LEN;
    while heapLen > 1 {
        heapLen--;
        unsafe {
            self->inner.swap(0, heapLen);
        }

        usize current = 0;
        while current < heapLen / 2 {
            usize child = current * 2 + 1;
            bool preferRight = false;
            if child + 1 < heapLen {
                values := self->view();
                preferRight = less(&values[child], &values[child + 1]);
            }
            if preferRight {
                child++;
            }

            bool ordered = false;
            {
                values := self->view();
                ordered = !less(&values[current], &values[child]);
            }
            if ordered {
                break;
            }

            unsafe {
                self->inner.swap(current, child);
            }
            current = child;
        }
    }
}

// Sorts elements in ascending order with relocation-only swaps.
void Array<T>::sort(&self) {
    self->sortBy(
        [](&const T left, &const T right) => (bool) {
            return *left < *right;
        }
    );
}

// Places accepted elements before rejected elements and returns the boundary.
usize Array<T>::partitionBy(&self, Predicate<T> predicate) {
    usize boundary = 0;
    loop usize index = 0; index < self->len(); index++ {
        bool accepted = false;
        {
            values := self->view();
            accepted = predicate(&values[index]);
        }
        if accepted {
            if boundary != index {
                unsafe {
                    self->inner.swap(boundary, index);
                }
            }
            boundary++;
        }
    }

    return boundary;
}

// Removes adjacent equivalent elements and returns the new logical length.
usize Array<T>::dedupBy(&self, Equal<T> equal) {
    const usize ORIGINAL_LENGTH = self->len();
    if ORIGINAL_LENGTH < 2 {
        return ORIGINAL_LENGTH;
    }

    usize write = 1;
    loop usize read = 1; read < ORIGINAL_LENGTH; read++ {
        bool duplicate = false;
        unsafe {
            left := self->inner.viewAt(write - 1);
            right := self->inner.viewAt(read);
            duplicate = equal(&left[0], &right[0]);
        }

        unsafe {
            if duplicate {
                self->inner.destroyAt(read);
            } else {
                if write != read {
                    self->inner.relocate(write, read);
                }
                write++;
            }
        }
    }

    unsafe {
        self->inner.commitLength(write);
    }
    return write;
}

// Removes adjacent equal elements and returns the new logical length.
usize Array<T>::dedup(&self) {
    return self->dedupBy(
        [](&const T left, &const T right) => (bool) {
            return *left == *right;
        }
    );
}

// Calls action once for each element in index order.
void Array<T>::forEach(&const self, Action<T> action) {
    for_each<T>(self->view(), action);
}

// Returns the first accepted index and true, or zero and false.
(usize, bool) Array<T>::findIf(&const self, Predicate<T> predicate) {
    return find_if<T>(self->view(), predicate);
}

// Returns the first insertion index in a range ordered by less.
usize Array<T>::lowerBoundBy(&const self, &const T needle, Less<T> less) {
    return lower_bound_by<T>(self->view(), needle, less);
}

// Returns the first index after needle's equivalent range ordered by less.
usize Array<T>::upperBoundBy(&const self, &const T needle, Less<T> less) {
    return upper_bound_by<T>(self->view(), needle, less);
}

// Returns the first equivalent index and true, or its insertion index and
// false, in a range ordered by less.
(usize, bool) Array<T>::binarySearchBy(
    &const self,
    &const T needle,
    Less<T> less,
) {
    return binary_search_by<T>(self->view(), needle, less);
}

// Returns the first insertion index in ascending order.
usize Array<T>::lowerBound(&const self, &const T needle) {
    return lower_bound<T>(self->view(), needle);
}

// Returns the first index after needle's ascending equivalent range.
usize Array<T>::upperBound(&const self, &const T needle) {
    return upper_bound<T>(self->view(), needle);
}

// Returns the first ascending equivalent index and true, or its insertion
// index and false.
(usize, bool) Array<T>::binarySearch(&const self, &const T needle) {
    return binary_search<T>(self->view(), needle);
}

// Reports whether predicate accepts at least one element.
bool Array<T>::anyOf(&const self, Predicate<T> predicate) {
    return any_of<T>(self->view(), predicate);
}

// Reports whether predicate accepts every element.
bool Array<T>::allOf(&const self, Predicate<T> predicate) {
    return all_of<T>(self->view(), predicate);
}

// Counts the elements accepted by predicate.
usize Array<T>::countIf(&const self, Predicate<T> predicate) {
    return count_if<T>(self->view(), predicate);
}

// Folds elements from left to right, beginning with initial.
A Array<T>::fold<A>(&const self, A initial, Folder<T, A> folder) {
    return fold<T, A>(self->view(), initial, folder);
}
