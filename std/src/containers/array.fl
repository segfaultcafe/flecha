module array;

@imports
    :: root::containers::raw_array
    :: root::containers::errors
    :: root::containers::algorithms;

// Owns a growable sequence and exposes safe checked element operations.
export structure Array<T> {
    private raw_array::RawArray<T> inner; 
};

// Copies source into a newly allocated array in index order.
(Array<T>, error) Array<T>::fromSlice([]const T source) {
    res := Array<T>::init();

    err := res.reserve(source.len());
    if err != none {
        return (none, err);
    }

    loop usize index = 0; index < source.len(); index++ {
        err = res.push(source[index]);
        if err != none {
            return (none, err);
        }
    }

    return (res, none);
}

// Returns the number of logical elements.
usize Array<T>::len(&const self) {
    return self->inner.len();
}

// Returns the number of elements that fit without another allocation.
usize Array<T>::capacity(&const self) {
    return self->inner.capacity();
}

// Ensures at least capacity elements fit while preserving existing contents.
error Array<T>::reserve(&self, usize capacity) {
    unsafe {
        return self->inner.reserve(capacity);
    }
}

// Appends value, copying a copyable value or consuming a movable value.
error Array<T>::push(&self, T value) {
    unsafe {
        return self->inner.push(value);
    }
}

// Returns the first index equal to value and true, or zero and false.
(usize, bool) Array<T>::indexOf(&const self, T value) {
    return algorithms::index_of<T>(self->view(), value);
}

// Reports whether an element is equal to value.
bool Array<T>::contains(&const self, T value) {
    return algorithms::contains<T>(self->view(), value);
}

// Reverses the logical elements in place.
void Array<T>::reverse(&self) {
    algorithms::reverse<T>(self->viewRef());
}

// Replaces every logical element with a semantic copy of value.
void Array<T>::fill(&self, T value) {
    algorithms::fill<T>(self->viewRef(), value);
}

// Appends semantic copies of source, preserving contents on allocation error.
error Array<T>::append(&self, []const T source) {
    const usize CURRENT = self->len();
    const usize ADDED = source.len();
    const usize REQUIRED = CURRENT + ADDED;

    // unsigned integer overflow condition
    bool overflow = REQUIRED < CURRENT;
    if overflow {
        return AllocationError.OutOfMemory;
    }

    err := self->reserve(REQUIRED);
    if err != none {
        return err;
    }

    loop usize i = 0; i < ADDED; i++ {
        err = self->push(source[i]);
        if err != none {
            return err;
        }
    }

    return none;
}

// Creates an independent semantic copy of the array and its elements.
(Array<T>, error) Array<T>::clone(&const self) {
    return Array<T>::fromSlice(self->view());
}

// Copies the element at index or reports ArrayError.IndexOutOfBounds.
(T, error) Array<T>::get(&const self, usize index) {
    unsafe {
        return self->inner.get(index);
    }
}

// Replaces the element at index or reports ArrayError.IndexOutOfBounds.
error Array<T>::set(&self, usize index, T value) {
    unsafe {
        return self->inner.set(index, value);
    }
}

// Removes and returns the indexed element while preserving element order.
(T, error) Array<T>::remove(&self, usize index) {
    unsafe {
        return self->inner.remove(index);
    }
}

// Removes and returns an element by replacing it with the final element.
(T, error) Array<T>::swapRemove(&self, usize index) {
    unsafe {
        return self->inner.swapRemove(index);
    }
}

// Removes and returns the final element, or reports ArrayError.Empty.
(T, error) Array<T>::pop(&self) {
    unsafe {
        return self->inner.pop();
    }
}

// Borrows all logical elements as a read-only slice.
[]const T Array<T>::view(&const self) <-self {
    unsafe {
        return self->inner.view();
    }
}

// Mutably borrows all logical elements as a slice.
[]T Array<T>::viewRef(&self) <-self {
    unsafe {
        return self->inner.viewRef();
    }
}

// Reports whether the array contains no logical elements.
bool Array<T>::empty(&const self) {
    return self->len() == 0;
}

// Copies the first element or reports ArrayError.Empty.
(T, error) Array<T>::first(&const self) {
    if self->empty() {
        return (none, errors::ArrayError.Empty);
    }

    return self->get(0);
}

// Copies the final element or reports ArrayError.Empty.
(T, error) Array<T>::last(&const self) {
    if self->empty() {
        return (none, errors::ArrayError.Empty);
    }

    const usize LAST = self->len() - 1;
    return self->get(LAST);
}

// Removes all logical elements while retaining the allocation.
void Array<T>::clear(&self) {
    self->inner.clear();
}

// Sorts elements in place with less as a strict ordering.
void Array<T>::sortBy(&self, algorithms::Less<T> less) {
    algorithms::sort_by<T>(self->viewRef(), less);
}

// Calls action once for each element in index order.
void Array<T>::forEach(&const self, algorithms::Action<T> action) {
    algorithms::for_each<T>(self->view(), action);
}

// Returns the first accepted index and true, or zero and false.
(usize, bool) Array<T>::findIf(&const self, algorithms::Predicate<T> predicate) {
    return algorithms::find_if<T>(self->view(), predicate);
}

// Reports whether predicate accepts at least one element.
bool Array<T>::anyOf(&const self, algorithms::Predicate<T> predicate) {
    return algorithms::any_of<T>(self->view(), predicate);
}

// Reports whether predicate accepts every element.
bool Array<T>::allOf(&const self, algorithms::Predicate<T> predicate) {
    return algorithms::all_of<T>(self->view(), predicate);
}

// Counts the elements accepted by predicate.
usize Array<T>::countIf(&const self, algorithms::Predicate<T> predicate) {
    return algorithms::count_if<T>(self->view(), predicate);
}

// Folds elements from left to right, beginning with initial.
A Array<T>::fold<A>(&const self, A initial, algorithms::Folder<T, A> folder) {
    return algorithms::fold<T, A>(self->view(), initial, folder);
}
