module raw_array;

@imports :: root::containers::errors;

export structure RawArray<T> {
    private own *T storage;
    private usize length;
    private usize allocated;
};

RawArray<T> RawArray<T>::init() override {
    return build RawArray<T> {};
}

void RawArray<T>::tear(&self) override {
    unsafe {
        free(self->storage);
    }
}

RawArray<T> RawArray<T>::zero() override {
    return build RawArray<T> {
        self.storage = null;
        self.length = 0;
        self.allocated = 0;
    };
}

usize RawArray<T>::len(&const self) {
    return self->length;
}

usize RawArray<T>::capacity(&const self) {
    return self->allocated;
}

unsafe error RawArray<T>::reserve(&self, usize capacity) {
    if capacity <= self->allocated {
        return none;
    }

    replacement, err := new<[]T>(capacity);
    if err != none {
        return err;
    }

    usize i = 0;
    while i < self->length {
        replacement[i] = self->storage[i];
        i++;
    }

    previous := take(self->storage);
    free(previous);

    self->storage = replacement;
    self->allocated = capacity;

    return none;
}

unsafe error RawArray<T>::push(&self, T value) {
    if self->length != self->allocated {
        self->storage[self->length] = value;
        self->length++;
        return none;
    }

    const usize CAPACITY_FACTOR = 2;
    usize capacity = 4;
    if self->allocated != 0 {
        capacity = self->allocated * CAPACITY_FACTOR;
    } also capacity <= self->allocated {
        return AllocationError.OutOfMemory;
    }

    err := self->reserve(capacity);
    if err != none {
        return err;
    }

    self->storage[self->length] = value;
    self->length++;
    return none;
}

unsafe (T, error) RawArray<T>::get(&const self, usize index) {
    if index >= self->length {
        return (none, errors::ArrayError.IndexOutOfBounds);
    }

    return (self->storage[index], none);
}

unsafe error RawArray<T>::set(&self, usize index, T value) {
    if index >= self->length {
        return errors::ArrayError.IndexOutOfBounds;
    }

    self->storage[index] = value;
    return none;
}

unsafe (T, error) RawArray<T>::pop(&self) {
    if self->length == 0 {
        return (none, errors::ArrayError.Empty);
    }

    len := &self->length;
    *len = *len - 1;
    return (self->storage[*len], none);
}

unsafe []const T RawArray<T>::view(&const self) <-self {
    return self->storage[:self->length];
}

unsafe []T RawArray<T>::viewRef(&self) <-self {
    return self->storage[:self->length];
}

void RawArray<T>::clear(&self) {
    self->length = 0;
}
