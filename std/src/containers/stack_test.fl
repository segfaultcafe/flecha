module collections_test;

@imports
    :: root::containers::collections
    :: root::containers::errors
    :: lib::std::tests::testing
    :: lib::std::tests::asserts;

test empty_stack_has_zero_state_and_reports_stack_errors(
    &testing::UnitTest t
) {
    values := collections::Stack<i32>::init();

    missingTop, topError := values.top();
    missingPop, popError := values.pop();

    asserts::is_true(t, values.empty(), "a new stack is empty");
    asserts::is_true(t, values.len() == 0, "a new stack has zero length");
    asserts::is_true(
        t,
        values.capacity() == 0,
        "a new stack has zero capacity"
    );
    asserts::is_true(
        t,
        missingTop == none and topError == errors::StackError.Empty,
        "top reports StackError.Empty"
    );
    asserts::is_true(
        t,
        missingPop == none and popError == errors::StackError.Empty,
        "pop reports StackError.Empty"
    );
}

test push_top_and_pop_follow_lifo_order(&testing::UnitTest t) {
    values := collections::Stack<i32>::init();

    firstPush := values.push(10);
    secondPush := values.push(20);
    thirdPush := values.push(30);

    top, topError := values.top();
    first, firstError := values.pop();
    second, secondError := values.pop();
    third, thirdError := values.pop();

    asserts::is_true(
        t,
        firstPush == none and secondPush == none and thirdPush == none,
        "push accepts values"
    );
    asserts::is_true(
        t,
        topError == none and top == 30,
        "top reads the most recently pushed value"
    );
    asserts::is_true(
        t,
        firstError == none and first == 30 and
            secondError == none and second == 20 and
            thirdError == none and third == 10,
        "pop removes values in LIFO order"
    );
    asserts::is_true(
        t,
        values.empty() and values.len() == 0,
        "popping every value empties the stack"
    );
}

test reserve_clear_and_reuse_preserve_stack_storage(
    &testing::UnitTest t
) {
    values := collections::Stack<i32>::init();

    firstPush := values.push(10);
    secondPush := values.push(20);
    reserveError := values.reserve(8);
    top, topError := values.top();

    asserts::is_true(
        t,
        firstPush == none and secondPush == none and
            reserveError == none and topError == none and
            top == 20 and values.len() == 2 and values.capacity() == 8,
        "reserve preserves stack contents and length"
    );

    values.clear();
    asserts::is_true(
        t,
        values.empty() and values.len() == 0 and values.capacity() == 8,
        "clear empties the stack while retaining capacity"
    );

    reusePush := values.push(42);
    reused, reusePop := values.pop();
    asserts::is_true(
        t,
        reusePush == none and reusePop == none and reused == 42 and
            values.empty() and values.capacity() == 8,
        "a cleared stack reuses retained storage"
    );
}

test pop_transfers_move_only_values_and_cleans_each_once(
    &testing::UnitTest t
) {
    i32 cleanupCount = 0;

    {
        values := collections::Stack<PushOwner>::init();
        error operationError = none;

        unsafe {
            operationError = values.push(
                PushOwner::init(&raw cleanupCount, 10)
            );
            operationError = values.push(
                PushOwner::init(&raw cleanupCount, 20)
            );
        }

        reserveError := values.reserve(8);
        asserts::is_true(
            t,
            operationError == none and reserveError == none and
                values.len() == 2 and values.capacity() == 8 and
                cleanupCount == 0,
            "stack growth relocates move-only values without cleanup"
        );
        if operationError != none or reserveError != none {
            return;
        }

        {
            extracted, popError := values.pop();
            asserts::is_true(
                t,
                popError == none and extracted.get() == 20 and
                    values.len() == 1 and cleanupCount == 0,
                "pop transfers the newest move-only value"
            );
        }

        asserts::is_true(
            t,
            cleanupCount == 1,
            "the popped owner is cleaned exactly once"
        );

        values.clear();
        asserts::is_true(
            t,
            cleanupCount == 2 and values.empty() and values.capacity() == 8,
            "clear cleans the remaining owner and retains storage"
        );

        unsafe {
            operationError = values.push(
                PushOwner::init(&raw cleanupCount, 30)
            );
        }
        asserts::is_true(
            t,
            operationError == none and values.len() == 1 and
                values.capacity() == 8,
            "a cleared stack accepts another move-only owner"
        );
    }

    asserts::is_true(
        t,
        cleanupCount == 3,
        "stack destruction cleans only the final owner"
    );
}
