module math;

// Returns value when it is less than other, and otherwise returns other.
export T min<T: numeric>(T value, T other) {
    if value < other {
        return value;
    }

    return other;
}

// Returns value when it is greater than other, and otherwise returns other.
export T max<T: numeric>(T value, T other) {
    if value > other {
        return value;
    }

    return other;
}

// Returns (value, other) when value is less; otherwise returns (other, value).
export (T, T) min_max<T: numeric>(T value, T other) {
    if value < other {
        return (value, other);
    }

    return (other, value);
}

// Clamps value to the inclusive interval after normalizing reversed bounds.
export T clamp<T: numeric>(T value, T low, T high) {
    lower, upper := min_max<T>(low, high);
    return max<T>(lower, min<T>(value, upper));
}

// Negates value when it is less than zero; otherwise preserves value.
export T abs<T: numeric>(T value) {
    T zero = none;

    if value < zero {
        return -value;
    }

    return value;
}

// Returns -1 when value is negative, 1 when positive, and otherwise zero.
export T sign<T: numeric>(T value) {
    T zero = none;

    if value < zero {
        return (-1) as T;
    }

    if value > zero {
        return 1 as T;
    }

    return zero;
}
