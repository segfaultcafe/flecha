module asserts_test;

@imports
    :: root::tests::asserts as paired_asserts
    :: lib::std::tests::asserts
    :: lib::std::tests::testing;

error PrimaryError {
    Missing,
    Invalid,
}

error OtherError {
    Missing,
}

test ordering_assertions_accept_integer_relations(&testing::UnitTest t) {
    i32 lower = 4;
    i32 equal = 5;
    i32 upper = 6;

    asserts::less<i32>(t, &lower, &equal, "less accepts a strict ordering");
    asserts::less_or_equal<i32>(
        t,
        &lower,
        &equal,
        "less_or_equal accepts a strict ordering"
    );
    asserts::less_or_equal<i32>(
        t,
        &equal,
        &equal,
        "less_or_equal accepts equality"
    );
    asserts::greater<i32>(t, &upper, &equal, "greater accepts a strict ordering");
    asserts::greater_or_equal<i32>(
        t,
        &upper,
        &equal,
        "greater_or_equal accepts a strict ordering"
    );
    asserts::greater_or_equal<i32>(
        t,
        &equal,
        &equal,
        "greater_or_equal accepts equality"
    );
}

test ordering_assertions_accept_floating_point_values(&testing::UnitTest t) {
    f64 lower = -1.5;
    f64 equal = 2.25;
    f64 upper = 3.75;

    asserts::less<f64>(t, &lower, &equal, "less accepts floating-point values");
    asserts::less_or_equal<f64>(
        t,
        &equal,
        &equal,
        "less_or_equal accepts equal floating-point values"
    );
    asserts::greater<f64>(t, &upper, &equal, "greater accepts floating-point values");
    asserts::greater_or_equal<f64>(
        t,
        &equal,
        &equal,
        "greater_or_equal accepts equal floating-point values"
    );
}

test numeric_equality_assertions_accept_integer_values(
    &testing::UnitTest t
) {
    i32 actual = 42;
    i32 expected = 42;
    i32 unexpected = 7;

    asserts::numeric_equal<i32>(
        t,
        &actual,
        &expected,
        "numeric_equal accepts equal integers"
    );
    asserts::numeric_not_equal<i32>(
        t,
        &actual,
        &unexpected,
        "numeric_not_equal accepts unequal integers"
    );
}

test numeric_equality_assertions_accept_floating_point_values(
    &testing::UnitTest t
) {
    f64 actual = 2.25;
    f64 expected = 2.25;
    f64 unexpected = -1.5;

    asserts::numeric_equal<f64>(
        t,
        &actual,
        &expected,
        "numeric_equal accepts equal floating-point values"
    );
    asserts::numeric_not_equal<f64>(
        t,
        &actual,
        &unexpected,
        "numeric_not_equal accepts unequal floating-point values"
    );
}

test string_equal_accepts_matching_text(&testing::UnitTest t) {
    asserts::string_equal(
        t,
        "flecha",
        "flecha",
        "string_equal accepts matching text"
    );
    asserts::string_equal(
        t,
        "",
        "",
        "string_equal accepts empty text"
    );
}

test string_not_equal_accepts_different_text(&testing::UnitTest t) {
    asserts::string_not_equal(
        t,
        "flecha",
        "arrow",
        "string_not_equal accepts different text"
    );
    asserts::string_not_equal(
        t,
        "",
        "flecha",
        "string_not_equal distinguishes empty text"
    );
}

test bytes_equal_accepts_matching_and_empty_slices(&testing::UnitTest t) {
    [3]u8 actual = [1, 2, 3];
    [3]u8 expected = [1, 2, 3];
    [0]u8 emptyActual = none;
    [0]u8 emptyExpected = none;

    asserts::bytes_equal(
        t,
        actual[:],
        expected[:],
        "bytes_equal accepts matching bytes"
    );
    asserts::bytes_equal(
        t,
        emptyActual[:],
        emptyExpected[:],
        "bytes_equal accepts empty slices"
    );
}

test bytes_not_equal_accepts_different_slices(&testing::UnitTest t) {
    [3]u8 actual = [1, 2, 3];
    [3]u8 differentContent = [1, 9, 3];
    [2]u8 differentLength = [1, 2];

    asserts::bytes_not_equal(
        t,
        actual[:],
        differentContent[:],
        "bytes_not_equal accepts different contents"
    );
    asserts::bytes_not_equal(
        t,
        actual[:],
        differentLength[:],
        "bytes_not_equal accepts different lengths"
    );
}

test error_variant_accepts_the_matching_family_and_variant(
    &testing::UnitTest t
) {
    PrimaryError actual = PrimaryError.Missing;

    asserts::has_error_variant(
        t,
        actual,
        PrimaryError.Missing,
        "matching error families and variants pass"
    );
}

test error_family_accepts_any_non_none_variant(&testing::UnitTest t) {
    PrimaryError missing = PrimaryError.Missing;
    PrimaryError invalid = PrimaryError.Invalid;

    asserts::has_error_family<PrimaryError>(
        t,
        missing,
        "error family accepts its first variant"
    );
    asserts::has_error_family<PrimaryError>(
        t,
        invalid,
        "error family accepts its other variants"
    );
}

test diagnostic_assertions_record_one_deferred_failure_each(
    &testing::UnitTest t
) {
    result := testing::UnitTest::init("nested diagnostics", false);
    i32 four = 4;
    i32 five = 5;
    [2]u8 actualBytes = [1, 2];
    [2]u8 expectedBytes = [1, 9];
    PrimaryError missing = none;

    asserts::less<i32>(&result, &five, &four, "less");
    asserts::less_or_equal<i32>(&result, &five, &four, "less_or_equal");
    asserts::greater<i32>(&result, &four, &five, "greater");
    asserts::greater_or_equal<i32>(&result, &four, &five, "greater_or_equal");
    asserts::numeric_equal<i32>(&result, &four, &five, "numeric_equal");
    asserts::numeric_not_equal<i32>(&result, &five, &five, "numeric_not_equal");
    asserts::string_equal(&result, "actual", "expected", "string_equal");
    asserts::string_not_equal(&result, "same", "same", "string_not_equal");
    asserts::bytes_equal(
        &result,
        actualBytes[:],
        expectedBytes[:],
        "bytes_equal"
    );
    asserts::bytes_not_equal(
        &result,
        actualBytes[:],
        actualBytes[:],
        "bytes_not_equal"
    );
    asserts::has_error_variant(
        &result,
        PrimaryError.Missing,
        PrimaryError.Invalid,
        "has_error_variant"
    );
    asserts::has_error_family<PrimaryError>(
        &result,
        missing,
        "has_error_family"
    );

    usize expectedCount = 12;
    actualAssertions := result.assertionCount();
    actualFailures := result.failureCount();
    asserts::equal<usize>(
        t,
        &expectedCount,
        &actualAssertions,
        "each diagnostic helper records exactly one assertion"
    );
    asserts::equal<usize>(
        t,
        &expectedCount,
        &actualFailures,
        "each failed diagnostic helper records exactly one failure"
    );
    asserts::is_true(t, result.failed(), "the nested result reports failure");
}
