module asserts;

@imports :: root::tests::testing;

// Records a failure unless actual is true.
export void is_true(
    &testing::UnitTest ut,
    bool actual,
    stringv message
) {
    ut->recordAssertion(actual, "actual is true", message);
}

// Records a failure unless actual is false.
export void is_false(
    &testing::UnitTest ut,
    bool actual,
    stringv message
) {
    ut->recordAssertion(!actual, "actual is false", message);
}

// Records a failure unless actual and expected are value-equal.
export void equal<T>(
    &testing::UnitTest ut,
    &const T expected,
    &const T actual,
    stringv message
) {
    ut->recordAssertion(*actual == *expected, "actual == expected", message);
}

// Records a failure unless actual and unexpected are value-unequal.
export void not_equal<T>(
    &testing::UnitTest ut,
    &const T unexpected,
    &const T actual,
    stringv message
) {
    ut->recordAssertion(*actual != *unexpected, "actual != unexpected", message);
}

// Records a failure unless actual and expected are type-strictly equal.
export void type_equal<A, B>(
    &testing::UnitTest ut,
    &const A expected,
    &const B actual,
    stringv message
) {
    ut->recordAssertion(*actual === *expected, "actual === expected", message);
}

// Records a failure unless actual and unexpected are type-strictly unequal.
export void type_not_equal<A, B>(
    &testing::UnitTest ut,
    &const A unexpected,
    &const B actual,
    stringv message
) {
    ut->recordAssertion(*actual !== *unexpected, "actual !== unexpected", message);
}

// Records a failure unless actual equals the zero/default none value.
export void is_none<T>(
    &testing::UnitTest ut,
    &const T actual,
    stringv message
) {
    ut->recordAssertion(*actual == none, "actual == none", message);
}

// Records a failure unless actual is a null raw pointer.
export void is_null<T>(
    &testing::UnitTest ut,
    &const T actual,
    stringv message
) {
    ut->recordAssertion(*actual == null, "actual == null", message);
}

// Records a failure unless actual contains an error value.
export void has_error(
    &testing::UnitTest ut,
    error actual,
    stringv message
) {
    ut->recordAssertion(actual != none, "actual != none", message);
}
