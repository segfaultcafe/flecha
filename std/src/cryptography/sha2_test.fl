module sha2_test;

@imports
    :: root::cryptography::sha2
    :: lib::std::tests::testing
    :: lib::std::tests::asserts;

bool digest_equals(
    &const sha2::Sha256Digest digest,
    []const u8 expected
) {
    actual := digest->bytes();
    if actual.len() != expected.len() {
        return false;
    }

    loop usize index = 0; index < actual.len(); index++ {
        if actual[index] != expected[index] {
            return false;
        }
    }

    return true;
}

bool sha512_digest_equals(
    &const sha2::Sha512Digest digest,
    []const u8 expected
) {
    actual := digest->bytes();
    if actual.len() != expected.len() {
        return false;
    }

    loop usize index = 0; index < actual.len(); index++ {
        if actual[index] != expected[index] {
            return false;
        }
    }

    return true;
}

test one_shot_matches_empty_and_abc_vectors(&testing::UnitTest t) {
    [0]u8 empty = [];
    [32]u8 emptyExpected = [
        0xe3, 0xb0, 0xc4, 0x42, 0x98, 0xfc, 0x1c, 0x14,
        0x9a, 0xfb, 0xf4, 0xc8, 0x99, 0x6f, 0xb9, 0x24,
        0x27, 0xae, 0x41, 0xe4, 0x64, 0x9b, 0x93, 0x4c,
        0xa4, 0x95, 0x99, 0x1b, 0x78, 0x52, 0xb8, 0x55
    ];
    emptyDigest, emptyError := sha2::sha256(empty[:]);

    [32]u8 abcExpected = [
        0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,
        0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23,
        0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c,
        0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad
    ];
    abcDigest, abcError := sha2::sha256("abc");

    asserts::is_true(
        t,
        emptyError == none and digest_equals(&emptyDigest, emptyExpected[:]),
        "SHA-256 matches the empty-message vector"
    );
    asserts::is_true(
        t,
        abcError == none and digest_equals(&abcDigest, abcExpected[:]),
        "SHA-256 matches the abc vector"
    );
}

test padding_boundary_uses_an_extra_block(&testing::UnitTest t) {
    [56]u8 message = [0x61; 56];
    [32]u8 expected = [
        0xb3, 0x54, 0x39, 0xa4, 0xac, 0x6f, 0x09, 0x48,
        0xb6, 0xd6, 0xf9, 0xe3, 0xc6, 0xaf, 0x0f, 0x5f,
        0x59, 0x0c, 0xe2, 0x0f, 0x1b, 0xde, 0x70, 0x90,
        0xef, 0x79, 0x70, 0x68, 0x6e, 0xc6, 0x73, 0x8a
    ];

    digest, err := sha2::sha256(message[:]);
    asserts::is_true(
        t,
        err == none and digest_equals(&digest, expected[:]),
        "a 56-byte message receives a second padding block"
    );
}

test streaming_fills_pending_block_and_finalizes_once(&testing::UnitTest t) {
    [64]u8 message = [0x61; 64];
    [32]u8 expected = [
        0xff, 0xe0, 0x54, 0xfe, 0x7a, 0xe0, 0xcb, 0x6d,
        0xc6, 0x5c, 0x3a, 0xf9, 0xb6, 0x1d, 0x52, 0x09,
        0xf4, 0x39, 0x85, 0x1d, 0xb4, 0x3d, 0x0b, 0xa5,
        0x99, 0x73, 0x37, 0xdf, 0x15, 0x46, 0x68, 0xeb
    ];

    hasher := sha2::Sha256::init();
    firstError := hasher.update(message[:13]);
    secondError := hasher.update(message[13:]);
    digest, finalizeError := hasher.finalize();
    _, repeatedFinalizeError := hasher.finalize();
    updateAfterFinalizeError := hasher.update(message[:0]);

    asserts::is_true(
        t,
        firstError == none and secondError == none and
            finalizeError == none and
            digest_equals(&digest, expected[:]),
        "streaming input produces the published 64-byte vector"
    );
    asserts::is_true(
        t,
        hasher.isFinalized() and
            repeatedFinalizeError == sha2::Sha2Error.AlreadyFinalized and
            updateAfterFinalizeError == sha2::Sha2Error.AlreadyFinalized,
        "a finalized hasher rejects further finalization and updates"
    );
}

test sha512_one_shot_matches_empty_and_abc_vectors(&testing::UnitTest t) {
    [0]u8 empty = [];
    [64]u8 emptyExpected = [
        0xcf, 0x83, 0xe1, 0x35, 0x7e, 0xef, 0xb8, 0xbd,
        0xf1, 0x54, 0x28, 0x50, 0xd6, 0x6d, 0x80, 0x07,
        0xd6, 0x20, 0xe4, 0x05, 0x0b, 0x57, 0x15, 0xdc,
        0x83, 0xf4, 0xa9, 0x21, 0xd3, 0x6c, 0xe9, 0xce,
        0x47, 0xd0, 0xd1, 0x3c, 0x5d, 0x85, 0xf2, 0xb0,
        0xff, 0x83, 0x18, 0xd2, 0x87, 0x7e, 0xec, 0x2f,
        0x63, 0xb9, 0x31, 0xbd, 0x47, 0x41, 0x7a, 0x81,
        0xa5, 0x38, 0x32, 0x7a, 0xf9, 0x27, 0xda, 0x3e
    ];
    emptyDigest, emptyError := sha2::sha512(empty[:]);

    [64]u8 abcExpected = [
        0xdd, 0xaf, 0x35, 0xa1, 0x93, 0x61, 0x7a, 0xba,
        0xcc, 0x41, 0x73, 0x49, 0xae, 0x20, 0x41, 0x31,
        0x12, 0xe6, 0xfa, 0x4e, 0x89, 0xa9, 0x7e, 0xa2,
        0x0a, 0x9e, 0xee, 0xe6, 0x4b, 0x55, 0xd3, 0x9a,
        0x21, 0x92, 0x99, 0x2a, 0x27, 0x4f, 0xc1, 0xa8,
        0x36, 0xba, 0x3c, 0x23, 0xa3, 0xfe, 0xeb, 0xbd,
        0x45, 0x4d, 0x44, 0x23, 0x64, 0x3c, 0xe8, 0x0e,
        0x2a, 0x9a, 0xc9, 0x4f, 0xa5, 0x4c, 0xa4, 0x9f
    ];
    abcDigest, abcError := sha2::sha512("abc");

    asserts::is_true(
        t,
        emptyError == none and
            sha512_digest_equals(&emptyDigest, emptyExpected[:]),
        "SHA-512 matches the empty-message vector"
    );
    asserts::is_true(
        t,
        abcError == none and
            sha512_digest_equals(&abcDigest, abcExpected[:]),
        "SHA-512 matches the abc vector"
    );
}

test sha512_padding_boundary_uses_an_extra_block(&testing::UnitTest t) {
    [112]u8 message = [0x61; 112];
    [64]u8 expected = [
        0xc0, 0x1d, 0x08, 0x0e, 0xfd, 0x49, 0x27, 0x76,
        0xa1, 0xc4, 0x3b, 0xd2, 0x3d, 0xd9, 0x9d, 0x0a,
        0x2e, 0x62, 0x6d, 0x48, 0x1e, 0x16, 0x78, 0x2e,
        0x75, 0xd5, 0x4c, 0x25, 0x03, 0xb5, 0xdc, 0x32,
        0xbd, 0x05, 0xf0, 0xf1, 0xba, 0x33, 0xe5, 0x68,
        0xb8, 0x8f, 0xd2, 0xd9, 0x70, 0x92, 0x9b, 0x71,
        0x9e, 0xcb, 0xb1, 0x52, 0xf5, 0x8f, 0x13, 0x0a,
        0x40, 0x7c, 0x88, 0x30, 0x60, 0x4b, 0x70, 0xca
    ];

    digest, err := sha2::sha512(message[:]);
    asserts::is_true(
        t,
        err == none and sha512_digest_equals(&digest, expected[:]),
        "a 112-byte SHA-512 message receives a second padding block"
    );
}

test sha512_streaming_fills_pending_block_and_finalizes_once(
    &testing::UnitTest t
) {
    [128]u8 message = [0x61; 128];
    [64]u8 expected = [
        0xb7, 0x3d, 0x19, 0x29, 0xaa, 0x61, 0x59, 0x34,
        0xe6, 0x1a, 0x87, 0x15, 0x96, 0xb3, 0xf3, 0xb3,
        0x33, 0x59, 0xf4, 0x2b, 0x81, 0x75, 0x60, 0x2e,
        0x89, 0xf7, 0xe0, 0x6e, 0x5f, 0x65, 0x8a, 0x24,
        0x36, 0x67, 0x80, 0x7e, 0xd3, 0x00, 0x31, 0x4b,
        0x95, 0xca, 0xcd, 0xd5, 0x79, 0xf3, 0xe3, 0x3a,
        0xbd, 0xfb, 0xe3, 0x51, 0x90, 0x95, 0x19, 0xa8,
        0x46, 0xd4, 0x65, 0xc5, 0x95, 0x82, 0xf3, 0x21
    ];

    hasher := sha2::Sha512::init();
    firstError := hasher.update(message[:29]);
    secondError := hasher.update(message[29:]);
    digest, finalizeError := hasher.finalize();
    _, repeatedFinalizeError := hasher.finalize();
    updateAfterFinalizeError := hasher.update(message[:0]);

    asserts::is_true(
        t,
        firstError == none and secondError == none and
            finalizeError == none and
            sha512_digest_equals(&digest, expected[:]),
        "streaming SHA-512 produces the published 128-byte result"
    );
    asserts::is_true(
        t,
        hasher.isFinalized() and
            repeatedFinalizeError == sha2::Sha2Error.AlreadyFinalized and
            updateAfterFinalizeError == sha2::Sha2Error.AlreadyFinalized,
        "a finalized SHA-512 hasher rejects finalization and updates"
    );
}

test million_a_matches_published_sha2_vectors(&testing::UnitTest t) {
    [1000]u8 chunk = [0x61; 1000];

    sha256Hasher := sha2::Sha256::init();
    bool sha256UpdatesSucceeded = true;
    loop usize iteration = 0; iteration < 1000; iteration++ {
        if sha256Hasher.update(chunk[:]) != none {
            sha256UpdatesSucceeded = false;
            break;
        }
    }
    sha256Digest, sha256Error := sha256Hasher.finalize();
    [32]u8 sha256Expected = [
        0xcd, 0xc7, 0x6e, 0x5c, 0x99, 0x14, 0xfb, 0x92,
        0x81, 0xa1, 0xc7, 0xe2, 0x84, 0xd7, 0x3e, 0x67,
        0xf1, 0x80, 0x9a, 0x48, 0xa4, 0x97, 0x20, 0x0e,
        0x04, 0x6d, 0x39, 0xcc, 0xc7, 0x11, 0x2c, 0xd0
    ];

    asserts::is_true(
        t,
        sha256UpdatesSucceeded and sha256Error == none and
            digest_equals(&sha256Digest, sha256Expected[:]),
        "SHA-256 matches the published one-million-a vector"
    );

    sha512Hasher := sha2::Sha512::init();
    bool sha512UpdatesSucceeded = true;
    loop usize iteration = 0; iteration < 1000; iteration++ {
        if sha512Hasher.update(chunk[:]) != none {
            sha512UpdatesSucceeded = false;
            break;
        }
    }
    sha512Digest, sha512Error := sha512Hasher.finalize();
    [64]u8 sha512Expected = [
        0xe7, 0x18, 0x48, 0x3d, 0x0c, 0xe7, 0x69, 0x64,
        0x4e, 0x2e, 0x42, 0xc7, 0xbc, 0x15, 0xb4, 0x63,
        0x8e, 0x1f, 0x98, 0xb1, 0x3b, 0x20, 0x44, 0x28,
        0x56, 0x32, 0xa8, 0x03, 0xaf, 0xa9, 0x73, 0xeb,
        0xde, 0x0f, 0xf2, 0x44, 0x87, 0x7e, 0xa6, 0x0a,
        0x4c, 0xb0, 0x43, 0x2c, 0xe5, 0x77, 0xc3, 0x1b,
        0xeb, 0x00, 0x9c, 0x5c, 0x2c, 0x49, 0xaa, 0x2e,
        0x4e, 0xad, 0xb2, 0x17, 0xad, 0x8c, 0xc0, 0x9b
    ];

    asserts::is_true(
        t,
        sha512UpdatesSucceeded and sha512Error == none and
            sha512_digest_equals(&sha512Digest, sha512Expected[:]),
        "SHA-512 matches the published one-million-a vector"
    );
}
