module hmac_test;

@imports
    :: root::cryptography::hmac
    :: root::cryptography::sha2
    :: lib::std::tests::testing
    :: lib::std::tests::asserts;

bool tag_equals(
    &const hmac::HmacSha256Tag tag,
    []const u8 expected
) {
    actual := tag->bytes();
    if actual.len() != expected.len() {
        return false;
    }

    loop usize index = 0; index < actual.len(); index++ {
        if actual[index] != expected[index] {
            return false;
        }
    }

    return true;
}

bool tag_equals(
    &const hmac::HmacSha512Tag tag,
    []const u8 expected
) {
    actual := tag->bytes();
    if actual.len() != expected.len() {
        return false;
    }

    loop usize index = 0; index < actual.len(); index++ {
        if actual[index] != expected[index] {
            return false;
        }
    }

    return true;
}

test rfc4231_case_one_matches_short_key_vectors(&testing::UnitTest t) {
    [20]u8 key = [0x0b; 20];
    [8]u8 message = [
        0x48, 0x69, 0x20, 0x54, 0x68, 0x65, 0x72, 0x65
    ];
    [32]u8 sha256Expected = [
        0xb0, 0x34, 0x4c, 0x61, 0xd8, 0xdb, 0x38, 0x53,
        0x5c, 0xa8, 0xaf, 0xce, 0xaf, 0x0b, 0xf1, 0x2b,
        0x88, 0x1d, 0xc2, 0x00, 0xc9, 0x83, 0x3d, 0xa7,
        0x26, 0xe9, 0x37, 0x6c, 0x2e, 0x32, 0xcf, 0xf7
    ];
    [64]u8 sha512Expected = [
        0x87, 0xaa, 0x7c, 0xde, 0xa5, 0xef, 0x61, 0x9d,
        0x4f, 0xf0, 0xb4, 0x24, 0x1a, 0x1d, 0x6c, 0xb0,
        0x23, 0x79, 0xf4, 0xe2, 0xce, 0x4e, 0xc2, 0x78,
        0x7a, 0xd0, 0xb3, 0x05, 0x45, 0xe1, 0x7c, 0xde,
        0xda, 0xa8, 0x33, 0xb7, 0xd6, 0xb8, 0xa7, 0x02,
        0x03, 0x8b, 0x27, 0x4e, 0xae, 0xa3, 0xf4, 0xe4,
        0xbe, 0x9d, 0x91, 0x4e, 0xeb, 0x61, 0xf1, 0x70,
        0x2e, 0x69, 0x6c, 0x20, 0x3a, 0x12, 0x68, 0x54
    ];

    sha256Tag, sha256Error := hmac::sha256(key[:], message[:]);
    sha512Tag, sha512Error := hmac::sha512(key[:], message[:]);

    asserts::is_true(
        t,
        sha256Error == none and tag_equals(&sha256Tag, sha256Expected[:]),
        "HMAC-SHA-256 matches RFC 4231 case 1"
    );
    asserts::is_true(
        t,
        sha512Error == none and tag_equals(&sha512Tag, sha512Expected[:]),
        "HMAC-SHA-512 matches RFC 4231 case 1"
    );
}

test incremental_input_matches_rfc4231_case_two(&testing::UnitTest t) {
    [4]u8 key = [0x4a, 0x65, 0x66, 0x65];
    message := "what do ya want for nothing?".cast<[]const u8>;
    [32]u8 sha256Expected = [
        0x5b, 0xdc, 0xc1, 0x46, 0xbf, 0x60, 0x75, 0x4e,
        0x6a, 0x04, 0x24, 0x26, 0x08, 0x95, 0x75, 0xc7,
        0x5a, 0x00, 0x3f, 0x08, 0x9d, 0x27, 0x39, 0x83,
        0x9d, 0xec, 0x58, 0xb9, 0x64, 0xec, 0x38, 0x43
    ];
    [64]u8 sha512Expected = [
        0x16, 0x4b, 0x7a, 0x7b, 0xfc, 0xf8, 0x19, 0xe2,
        0xe3, 0x95, 0xfb, 0xe7, 0x3b, 0x56, 0xe0, 0xa3,
        0x87, 0xbd, 0x64, 0x22, 0x2e, 0x83, 0x1f, 0xd6,
        0x10, 0x27, 0x0c, 0xd7, 0xea, 0x25, 0x05, 0x54,
        0x97, 0x58, 0xbf, 0x75, 0xc0, 0x5a, 0x99, 0x4a,
        0x6d, 0x03, 0x4f, 0x65, 0xf8, 0xf0, 0xe6, 0xfd,
        0xca, 0xea, 0xb1, 0xa3, 0x4d, 0x4a, 0x6b, 0x4b,
        0x63, 0x6e, 0x07, 0x0a, 0x38, 0xbc, 0xe7, 0x37
    ];

    sha256Hasher, sha256CreateError := hmac::HmacSha256::create(key[:]);
    sha512Hasher, sha512CreateError := hmac::HmacSha512::create(key[:]);
    sha256FirstError := sha256Hasher.update(message[:7]);
    sha256SecondError := sha256Hasher.update(message[7:]);
    sha512FirstError := sha512Hasher.update(message[:11]);
    sha512SecondError := sha512Hasher.update(message[11:]);
    sha256Tag, sha256FinalizeError := sha256Hasher.finalize();
    sha512Tag, sha512FinalizeError := sha512Hasher.finalize();

    asserts::is_true(
        t,
        sha256CreateError == none and sha256FirstError == none and
            sha256SecondError == none and sha256FinalizeError == none and
            tag_equals(&sha256Tag, sha256Expected[:]),
        "chunked HMAC-SHA-256 matches RFC 4231 case 2"
    );
    asserts::is_true(
        t,
        sha512CreateError == none and sha512FirstError == none and
            sha512SecondError == none and sha512FinalizeError == none and
            tag_equals(&sha512Tag, sha512Expected[:]),
        "chunked HMAC-SHA-512 matches RFC 4231 case 2"
    );
}

test rfc4231_case_six_hashes_long_keys_first(&testing::UnitTest t) {
    [131]u8 key = [0xaa; 131];
    message :=
        "Test Using Larger Than Block-Size Key - Hash Key First"
            .cast<[]const u8>;
    [32]u8 sha256Expected = [
        0x60, 0xe4, 0x31, 0x59, 0x1e, 0xe0, 0xb6, 0x7f,
        0x0d, 0x8a, 0x26, 0xaa, 0xcb, 0xf5, 0xb7, 0x7f,
        0x8e, 0x0b, 0xc6, 0x21, 0x37, 0x28, 0xc5, 0x14,
        0x05, 0x46, 0x04, 0x0f, 0x0e, 0xe3, 0x7f, 0x54
    ];
    [64]u8 sha512Expected = [
        0x80, 0xb2, 0x42, 0x63, 0xc7, 0xc1, 0xa3, 0xeb,
        0xb7, 0x14, 0x93, 0xc1, 0xdd, 0x7b, 0xe8, 0xb4,
        0x9b, 0x46, 0xd1, 0xf4, 0x1b, 0x4a, 0xee, 0xc1,
        0x12, 0x1b, 0x01, 0x37, 0x83, 0xf8, 0xf3, 0x52,
        0x6b, 0x56, 0xd0, 0x37, 0xe0, 0x5f, 0x25, 0x98,
        0xbd, 0x0f, 0xd2, 0x21, 0x5d, 0x6a, 0x1e, 0x52,
        0x95, 0xe6, 0x4f, 0x73, 0xf6, 0x3f, 0x0a, 0xec,
        0x8b, 0x91, 0x5a, 0x98, 0x5d, 0x78, 0x65, 0x98
    ];

    sha256Tag, sha256Error := hmac::sha256(key[:], message);
    sha512Tag, sha512Error := hmac::sha512(key[:], message);

    asserts::is_true(
        t,
        sha256Error == none and tag_equals(&sha256Tag, sha256Expected[:]),
        "HMAC-SHA-256 hashes a key longer than its block"
    );
    asserts::is_true(
        t,
        sha512Error == none and tag_equals(&sha512Tag, sha512Expected[:]),
        "HMAC-SHA-512 hashes a key longer than its block"
    );
}

test empty_and_exact_block_keys_are_supported(&testing::UnitTest t) {
    [0]u8 empty = [];
    [32]u8 emptySha256Expected = [
        0xb6, 0x13, 0x67, 0x9a, 0x08, 0x14, 0xd9, 0xec,
        0x77, 0x2f, 0x95, 0xd7, 0x78, 0xc3, 0x5f, 0xc5,
        0xff, 0x16, 0x97, 0xc4, 0x93, 0x71, 0x56, 0x53,
        0xc6, 0xc7, 0x12, 0x14, 0x42, 0x92, 0xc5, 0xad
    ];
    [64]u8 emptySha512Expected = [
        0xb9, 0x36, 0xce, 0xe8, 0x6c, 0x9f, 0x87, 0xaa,
        0x5d, 0x3c, 0x6f, 0x2e, 0x84, 0xcb, 0x5a, 0x42,
        0x39, 0xa5, 0xfe, 0x50, 0x48, 0x0a, 0x6e, 0xc6,
        0x6b, 0x70, 0xab, 0x5b, 0x1f, 0x4a, 0xc6, 0x73,
        0x0c, 0x6c, 0x51, 0x54, 0x21, 0xb3, 0x27, 0xec,
        0x1d, 0x69, 0x40, 0x2e, 0x53, 0xdf, 0xb4, 0x9a,
        0xd7, 0x38, 0x1e, 0xb0, 0x67, 0xb3, 0x38, 0xfd,
        0x7b, 0x0c, 0xb2, 0x22, 0x47, 0x22, 0x5d, 0x47
    ];
    emptySha256Tag, emptySha256Error := hmac::sha256(empty[:], empty[:]);
    emptySha512Tag, emptySha512Error := hmac::sha512(empty[:], empty[:]);

    [64]u8 sha256Key = [0xaa; 64];
    [32]u8 blockSha256Expected = [
        0xdb, 0x2c, 0xf9, 0x3f, 0x63, 0x3f, 0xcd, 0xfd,
        0x9b, 0xb7, 0xf3, 0xb9, 0x97, 0x63, 0xa6, 0x37,
        0x25, 0xcb, 0x8e, 0x38, 0xb4, 0xfa, 0x60, 0xa8,
        0x7d, 0x0e, 0x94, 0xb7, 0x1d, 0x8b, 0x59, 0x70
    ];
    blockSha256Tag, blockSha256Error :=
        hmac::sha256(sha256Key[:], empty[:]);

    [128]u8 sha512Key = [0xaa; 128];
    [64]u8 blockSha512Expected = [
        0x67, 0x93, 0xbf, 0xc0, 0x0c, 0xe1, 0x02, 0x83,
        0x39, 0xb2, 0x16, 0x1e, 0x47, 0x80, 0x11, 0x12,
        0x0f, 0xa2, 0x2c, 0x9a, 0xaf, 0x04, 0x5f, 0x9e,
        0x9c, 0x9e, 0xb5, 0x8f, 0x5b, 0x95, 0x2e, 0xec,
        0x28, 0xa1, 0x9a, 0x72, 0x9e, 0x72, 0xaf, 0xd4,
        0x02, 0x7a, 0xac, 0xaf, 0xc6, 0xf3, 0xad, 0xd3,
        0xab, 0x1a, 0x88, 0x5e, 0xa9, 0xb1, 0xb2, 0xd9,
        0x20, 0x2a, 0x6f, 0xa7, 0x96, 0x27, 0xa8, 0x00
    ];
    blockSha512Tag, blockSha512Error :=
        hmac::sha512(sha512Key[:], empty[:]);

    asserts::is_true(
        t,
        emptySha256Error == none and
            tag_equals(&emptySha256Tag, emptySha256Expected[:]) and
            blockSha256Error == none and
            tag_equals(&blockSha256Tag, blockSha256Expected[:]),
        "HMAC-SHA-256 supports empty and block-sized keys"
    );
    asserts::is_true(
        t,
        emptySha512Error == none and
            tag_equals(&emptySha512Tag, emptySha512Expected[:]) and
            blockSha512Error == none and
            tag_equals(&blockSha512Tag, blockSha512Expected[:]),
        "HMAC-SHA-512 supports empty and block-sized keys"
    );
}

test invalid_and_finalized_states_are_rejected(&testing::UnitTest t) {
    [0]u8 empty = [];
    hmac::HmacSha256 defaultSha256 = none;
    hmac::HmacSha512 defaultSha512 = none;
    defaultSha256UpdateError := defaultSha256.update(empty[:]);
    _, defaultSha256FinalizeError := defaultSha256.finalize();
    defaultSha512UpdateError := defaultSha512.update(empty[:]);
    _, defaultSha512FinalizeError := defaultSha512.finalize();

    sha256Hasher, sha256CreateError := hmac::HmacSha256::create(empty[:]);
    _, sha256FinalizeError := sha256Hasher.finalize();
    _, sha256RepeatedError := sha256Hasher.finalize();
    sha256UpdateAfterError := sha256Hasher.update(empty[:]);

    sha512Hasher, sha512CreateError := hmac::HmacSha512::create(empty[:]);
    _, sha512FinalizeError := sha512Hasher.finalize();
    _, sha512RepeatedError := sha512Hasher.finalize();
    sha512UpdateAfterError := sha512Hasher.update(empty[:]);

    asserts::is_true(
        t,
        defaultSha256UpdateError == hmac::HmacError.NotInitialized and
            defaultSha256FinalizeError == hmac::HmacError.NotInitialized and
            defaultSha512UpdateError == hmac::HmacError.NotInitialized and
            defaultSha512FinalizeError == hmac::HmacError.NotInitialized,
        "default HMAC values reject operations"
    );
    asserts::is_true(
        t,
        sha256CreateError == none and sha256FinalizeError == none and
            sha256RepeatedError == sha2::Sha2Error.AlreadyFinalized and
            sha256UpdateAfterError == sha2::Sha2Error.AlreadyFinalized and
            sha512CreateError == none and sha512FinalizeError == none and
            sha512RepeatedError == sha2::Sha2Error.AlreadyFinalized and
            sha512UpdateAfterError == sha2::Sha2Error.AlreadyFinalized,
        "finalized HMAC values reject further operations"
    );
}
