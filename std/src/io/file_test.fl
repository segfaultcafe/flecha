module file_test;

@imports
    :: root::io::buffered
    :: root::io::file
    :: root::io::errors
    :: root::io::filesystem
    :: root::io::stream
    :: lib::std::tests::testing
    :: lib::std::tests::asserts;

test open_option_constructors_select_the_expected_modes(&testing::UnitTest t) {
    readOnly := file::OpenOptions::readOnly();
    asserts::is_true(t, readOnly.read, "readOnly enables reading");
    asserts::is_false(t, readOnly.write, "readOnly does not enable writing");

    writeOnly := file::OpenOptions::writeOnly();
    asserts::is_true(t, writeOnly.write, "writeOnly enables writing");
    asserts::is_true(t, writeOnly.create, "writeOnly creates a missing file");
    asserts::is_true(t, writeOnly.truncate, "writeOnly truncates an existing file");
    asserts::is_false(t, writeOnly.read, "writeOnly does not enable reading");

    appendOnly := file::OpenOptions::appendOnly();
    asserts::is_true(t, appendOnly.write, "appendOnly enables writing");
    asserts::is_true(t, appendOnly.append, "appendOnly writes at the end");
    asserts::is_true(t, appendOnly.create, "appendOnly creates a missing file");
    asserts::is_false(t, appendOnly.truncate, "appendOnly preserves existing contents");
}

test open_rejects_options_before_touching_the_path(&testing::UnitTest t) {
    invalid := build file::OpenOptions {
        self.append = true;
    };

    opened, err := file::File::open("", invalid);
    asserts::is_true(t, err == errors::IoError.InvalidOptions, "append requires write access");
    asserts::is_false(t, opened.isOpen(), "a rejected open returns a closed File");
}

test option_validation_covers_every_write_modifier(&testing::UnitTest t) {
    noAccess := build file::OpenOptions {};
    appendWithoutWrite := build file::OpenOptions {
        self.append = true;
    };
    truncateWithoutWrite := build file::OpenOptions {
        self.truncate = true;
    };
    createWithoutWrite := build file::OpenOptions {
        self.create = true;
    };
    createNewWithoutWrite := build file::OpenOptions {
        self.createNew = true;
    };

    asserts::is_true(
        t,
        file::validate_options(noAccess) == errors::IoError.InvalidOptions,
        "at least one access mode is required"
    );
    asserts::is_true(
        t,
        file::validate_options(appendWithoutWrite) == errors::IoError.InvalidOptions,
        "append requires write access"
    );
    asserts::is_true(
        t,
        file::validate_options(truncateWithoutWrite) == errors::IoError.InvalidOptions,
        "truncate requires write access"
    );
    asserts::is_true(
        t,
        file::validate_options(createWithoutWrite) == errors::IoError.InvalidOptions,
        "create requires write access"
    );
    asserts::is_true(
        t,
        file::validate_options(createNewWithoutWrite) == errors::IoError.InvalidOptions,
        "createNew requires write access"
    );
    asserts::is_true(
        t,
        file::validate_options(file::OpenOptions::readOnly()) == none,
        "readOnly is valid"
    );
    asserts::is_true(
        t,
        file::validate_options(file::OpenOptions::writeOnly()) == none,
        "writeOnly is valid"
    );
    asserts::is_true(
        t,
        file::validate_options(file::OpenOptions::appendOnly()) == none,
        "appendOnly is valid"
    );
}

test open_rejects_invalid_paths(&testing::UnitTest t) {
    empty, emptyError := file::File::open("", file::OpenOptions::readOnly());
    asserts::is_true(t, emptyError == errors::IoError.InvalidPath, "an empty path is invalid");
    asserts::is_false(t, empty.isOpen(), "an invalid path returns a closed File");

    string embeddedNullPath = "bad" + '\0'.string() + "path";
    embeddedNull, embeddedNullError := file::File::open(
        embeddedNullPath.view(),
        file::OpenOptions::readOnly()
    );
    asserts::is_true(
        t,
        embeddedNullError == errors::IoError.InvalidPath,
        "an embedded null is invalid"
    );
    asserts::is_false(t, embeddedNull.isOpen(), "a failed open does not retain a handle");
}

test closed_files_reject_every_operation(&testing::UnitTest t) {
    closed, openError := file::File::open("", file::OpenOptions::readOnly());
    asserts::is_true(t, openError == errors::IoError.InvalidPath, "the setup File is closed");

    [0]u8 empty = none;
    bytesRead, readError := closed.read(empty[:]);
    asserts::is_true(
        t,
        bytesRead == 0 and readError == errors::IoError.Closed,
        "read rejects a closed File"
    );
    asserts::is_true(
        t,
        closed.readExact(empty[:]) == errors::IoError.Closed,
        "readExact rejects a closed File"
    );

    bytesWritten, writeError := closed.write(empty[:]);
    asserts::is_true(
        t,
        bytesWritten == 0 and writeError == errors::IoError.Closed,
        "write rejects a closed File"
    );
    asserts::is_true(
        t,
        closed.writeAll(empty[:]) == errors::IoError.Closed,
        "writeAll rejects a closed File"
    );
    stringv emptyText = "";
    stringBytesWritten, stringWriteError := closed.writeString(emptyText);
    asserts::is_true(
        t,
        stringBytesWritten == 0 and stringWriteError == errors::IoError.Closed,
        "writeString rejects a closed File"
    );
    asserts::is_true(
        t,
        closed.writeAllString(emptyText) == errors::IoError.Closed,
        "writeAllString rejects a closed File"
    );

    position, seekError := closed.seek(0, file::SeekFrom.Start);
    asserts::is_true(
        t,
        position == 0 and seekError == errors::IoError.Closed,
        "seek rejects a closed File"
    );
    asserts::is_true(t, closed.flush() == errors::IoError.Closed, "flush rejects a closed File");
    asserts::is_true(t, closed.close() == errors::IoError.Closed, "close rejects a closed File");
}

test seek_origins_have_stable_native_values(&testing::UnitTest t) {
    start := file::SeekFrom.Start;
    current := file::SeekFrom.Current;
    end := file::SeekFrom.End;

    asserts::is_true(t, start.number() == 0, "Start maps to zero");
    asserts::is_true(t, current.number() == 1, "Current maps to one");
    asserts::is_true(t, end.number() == 2, "End maps to two");
}

test stream_adapters_round_trip_bytes_after_moves(&testing::UnitTest t) {
    stringv path = ".flecha-file-stream-round-trip.tmp";
    [5]u8 source = [10, 20, 30, 40, 50];

    output, openWriteError := file::File::open(
        path,
        file::OpenOptions::writeOnly()
    );
    asserts::is_true(t, openWriteError == none, "the output file opens");

    if output.isOpen() {
        writer := output.writer();
        movedWriter := writer;
        writeError := movedWriter.writeAll(source[:]);
        asserts::is_true(
            t,
            writeError == none,
            "the moved writer writes all bytes"
        );

        asserts::is_true(
            t,
            output.flush() == none,
            "the file is usable after the writer"
        );
        asserts::is_true(t, output.close() == none, "the output file closes");
    }

    input, openReadError := file::File::open(
        path,
        file::OpenOptions::readOnly()
    );
    asserts::is_true(t, openReadError == none, "the input file opens");

    if input.isOpen() {
        reader := input.reader();
        movedReader := reader;

        [5]u8 destination = none;
        readError := movedReader.readExact(destination[:]);
        asserts::is_true(
            t,
            readError == none,
            "the moved reader reads every byte"
        );
        asserts::is_true(t, destination[0] == 10, "the first byte round trips");
        asserts::is_true(t, destination[4] == 50, "the last byte round trips");

        [1]u8 extra = none;
        bytesRead, eofError := movedReader.read(extra[:]);
        asserts::is_true(
            t,
            bytesRead == 0 and eofError == none,
            "the reader reports file EOF"
        );

        asserts::is_true(
            t,
            input.close() == none,
            "the file is usable after the reader"
        );
    }

    cleanupError := filesystem::remove_file(path);
    asserts::is_true(t, cleanupError == none, "the round-trip file is removed");
}

test stream_adapters_forward_closed_file_errors(&testing::UnitTest t) {
    closed, openError := file::File::open("", file::OpenOptions::readOnly());
    asserts::is_true(
        t,
        openError == errors::IoError.InvalidPath,
        "the setup File is closed"
    );

    [1]u8 bytes = none;
    reader := closed.reader();
    bytesRead, readError := reader.read(bytes[:]);
    asserts::is_true(
        t,
        bytesRead == 0 and readError == errors::IoError.Closed,
        "the reader forwards Closed"
    );

    writer := closed.writer();
    bytesWritten, writeError := writer.write(bytes[:]);
    asserts::is_true(
        t,
        bytesWritten == 0 and writeError == errors::IoError.Closed,
        "the writer forwards Closed"
    );
}

test copy_transfers_bytes_between_file_adapters(&testing::UnitTest t) {
    stringv sourcePath = ".flecha-file-stream-copy-source.tmp";
    stringv destinationPath = ".flecha-file-stream-copy-destination.tmp";
    [6]u8 expected = [1, 3, 5, 7, 9, 11];

    setupError := filesystem::write_bytes(sourcePath, expected[:]);
    asserts::is_true(t, setupError == none, "the copy source is created");

    input, inputError := file::File::open(
        sourcePath,
        file::OpenOptions::readOnly()
    );
    output, outputError := file::File::open(
        destinationPath,
        file::OpenOptions::writeOnly()
    );
    asserts::is_true(t, inputError == none, "the copy source opens");
    asserts::is_true(t, outputError == none, "the copy destination opens");

    if input.isOpen() and output.isOpen() {
        reader := input.reader();
        writer := output.writer();
        [2]u8 buffer = none;

        copied, copyError := stream::copy(&reader, &writer, buffer[:]);
        asserts::is_true(t, copyError == none, "copy succeeds");
        asserts::is_true(t, copied == 6, "copy reports every transferred byte");
    }

    if input.isOpen() {
        asserts::is_true(t, input.close() == none, "the copy source closes");
    }
    if output.isOpen() {
        asserts::is_true(
            t,
            output.flush() == none,
            "the copy destination flushes"
        );
        asserts::is_true(
            t,
            output.close() == none,
            "the copy destination closes"
        );
    }

    verification, verificationError := file::File::open(
        destinationPath,
        file::OpenOptions::readOnly()
    );
    asserts::is_true(t, verificationError == none, "the copied file opens");

    if verification.isOpen() {
        [6]u8 actual = none;
        readError := verification.readExact(actual[:]);
        asserts::is_true(
            t,
            readError == none,
            "File readExact reads the copied bytes"
        );
        asserts::is_true(t, actual[0] == 1, "copy preserves the first byte");
        asserts::is_true(t, actual[5] == 11, "copy preserves the last byte");
        asserts::is_true(
            t,
            verification.close() == none,
            "the copied file closes"
        );
    }

    sourceCleanupError := filesystem::remove_file(sourcePath);
    destinationCleanupError := filesystem::remove_file(destinationPath);
    asserts::is_true(
        t,
        sourceCleanupError == none,
        "the copy source is removed"
    );
    asserts::is_true(
        t,
        destinationCleanupError == none,
        "the copy destination is removed"
    );
}

test buffered_adapters_round_trip_bytes_and_release_file_borrows(
    &testing::UnitTest t
) {
    stringv path = ".flecha-buffered-file-round-trip.tmp";
    [7]u8 source = [1, 2, 3, 4, 5, 6, 7];

    output, openWriteError := file::File::open(
        path,
        file::OpenOptions::writeOnly()
    );
    asserts::is_true(t, openWriteError == none, "the output file opens");

    if output.isOpen() {
        writer := output.writer();
        bufferedWriter, allocationError :=
            buffered::BufferedWriter::withCapacity(writer, 3);
        asserts::is_true(
            t,
            allocationError == none,
            "the buffered writer allocates"
        );

        if allocationError == none {
            writeError := bufferedWriter.writeAll(source[:]);
            flushError := bufferedWriter.flush();
            asserts::is_true(
                t,
                writeError == none and flushError == none,
                "the buffered writer drains every byte"
            );
        }

        asserts::is_true(
            t,
            output.flush() == none,
            "the file borrow ends after the buffered writer's final use"
        );
        asserts::is_true(t, output.close() == none, "the output file closes");
    }

    input, openReadError := file::File::open(
        path,
        file::OpenOptions::readOnly()
    );
    asserts::is_true(t, openReadError == none, "the input file opens");

    if input.isOpen() {
        reader := input.reader();
        bufferedReader, allocationError :=
            buffered::BufferedReader::withCapacity(reader, 3);
        asserts::is_true(
            t,
            allocationError == none,
            "the buffered reader allocates"
        );

        if allocationError == none {
            [7]u8 destination = none;
            readError := bufferedReader.readExact(destination[:]);
            asserts::is_true(
                t,
                readError == none,
                "the buffered reader fills the destination"
            );
            asserts::is_true(
                t,
                destination[0] == 1 and destination[3] == 4 and
                    destination[6] == 7,
                "the buffered round trip preserves byte order"
            );

            [1]u8 extra = none;
            count, eofError := bufferedReader.read(extra[:]);
            asserts::is_true(
                t,
                count == 0 and eofError == none,
                "the buffered reader reports EOF"
            );
        }

        asserts::is_true(
            t,
            input.close() == none,
            "the file borrow ends after the buffered reader's final use"
        );
    }

    cleanupError := filesystem::remove_file(path);
    asserts::is_true(t, cleanupError == none, "the round-trip file is removed");
}
