module file;

@imports
    :: root::io::errors
    :: root::io::runtime
    :: root::io::stream
    :: root::io::utils;

// Selects the reference point for a file seek offset.
export enum SeekFrom: u8 {
    // Measures the offset from the beginning of the file.
    default Start,

    // Measures the offset from the current file position.
    Current,

    // Measures the offset from the end of the file.
    End
}

// Returns the runtime representation of this seek origin.
u8 SeekFrom::number(&const self) {
    return match *self {
        SeekFrom.Start => 0,
        SeekFrom.Current => 1,
        SeekFrom.End => 2,
    };
}

// Describes how File::open accesses or creates a file.
export structure OpenOptions {
    // Permits read operations.
    bool read;

    // Permits write operations.
    bool write;

    // Directs writes to the end of the file.
    bool append;

    // Truncates an existing file when it is opened.
    bool truncate;

    // Creates the file when it does not exist.
    bool create;

    // Creates a new file and fails if the path already exists.
    bool createNew;
};

// Returns options for opening an existing file for reading.
OpenOptions OpenOptions::readOnly() {
    return build OpenOptions {
        self.read = true;
    };
}

// Returns options for creating or truncating a file for writing.
OpenOptions OpenOptions::writeOnly() {
    return build OpenOptions {
        self.write = true;
        self.create = true;
        self.truncate = true;
    };
}

// Returns options for creating a file or appending to its existing contents.
OpenOptions OpenOptions::appendOnly() {
    return build OpenOptions {
        self.write = true;
        self.append = true;
        self.create = true;
    };
}

// Owns an operating-system file handle and closes it on destruction.
export structure File {
    private *void handle;
};

// Closes a still-open handle during deterministic destruction.
void File::tear(&self) override {
    if self->handle == null {
        return;
    }

    *void handle = self->handle;
    self->handle = null;

    unsafe {
        runtime::flecha_runtime_v1_file_stream_close(handle);
    }
}

// Constructs the closed representation used by none.
File File::zero() override {
    return build File {
        self.handle = null;
    };
}

// Opens path with opts and returns an owning file handle.
(File, error) File::open(stringv path, OpenOptions opts) {
    err := validate_options(opts);
    if err != none {
        return (none, err);
    }

    *void handle = null;
    unsafe {
        i32 status = runtime::flecha_runtime_v1_file_stream_open(
            &raw handle,
            path.data(),
            path.len().cast<usize>,
            utils::bool_byte(opts.read),
            utils::bool_byte(opts.write),
            utils::bool_byte(opts.append),
            utils::bool_byte(opts.truncate),
            utils::bool_byte(opts.create),
            utils::bool_byte(opts.createNew)
        );

        err = errors::from_runtime(status, errors::IoError.OpenFailed);
        if err != none {
            return (none, err);
        }
    }

    return (build File {
        self.handle = handle;
    }, none);
}

// Reports whether this value currently owns an open handle.
bool File::isOpen(&const self) {
    return self->handle != null;
}

// Reads up to destination.len() bytes and reports the partial byte count.
(usize, error) File::read(&self, []u8 destination) {
    if self->handle == null {
        return (none, errors::IoError.Closed);
    }

    usize bytesRead = 0;
    unsafe {
        i32 status = runtime::flecha_runtime_v1_file_stream_read(
            self->handle,
            destination.data(),
            destination.len(),
            &raw bytesRead
        );

        err := errors::from_runtime(status, errors::IoError.ReadFailed);
        if err != none {
            return (bytesRead, err);
        }
    }

    return (bytesRead, none);
}

// Creates a stream reader that mutably borrows this file.
stream::Reader File::reader(&self) <-self {
    return stream::Reader::init(
        [own self](destination) => {
            return self->read(destination);
        }
    );
}

// Fills destination or returns an error, including IoError.UnexpectedEof.
error File::readExact(&self, []u8 destination) {
    if self->handle == null {
        return errors::IoError.Closed;
    }

    reader := self->reader();
    return reader.readExact(destination);
}

// Writes up to source.len() bytes and reports the partial byte count.
(usize, error) File::write(&self, []const u8 source) {
    if self->handle == null {
        return (none, errors::IoError.Closed);
    }

    usize bytesWritten = 0;
    unsafe {
        i32 status = runtime::flecha_runtime_v1_file_stream_write(
            self->handle,
            source.data(),
            source.len(),
            &raw bytesWritten
        );

        err := errors::from_runtime(status, errors::IoError.WriteFailed);
        if err != none {
            return (bytesWritten, err);
        }
    }

    return (bytesWritten, none);
}

// Creates a stream writer that mutably borrows this file.
stream::Writer File::writer(&self) <-self {
    return stream::Writer::init(
        [own self](source) => {
            return self->write(source);
        }
    );
}

// Writes every source byte or returns the first write failure.
error File::writeAll(&self, []const u8 source) {
    if self->handle == null {
        return errors::IoError.Closed;
    }

    writer := self->writer();
    return writer.writeAll(source);
}

// Writes bytes from source without interpreting or validating text.
(usize, error) File::writeString(&self, stringv source) {
    if self->handle == null {
        return (none, errors::IoError.Closed);
    }

    usize bytesWritten = 0;
    unsafe {
        i32 status = runtime::flecha_runtime_v1_file_stream_write(
            self->handle,
            source.data(),
            source.len().cast<usize>,
            &raw bytesWritten
        );

        err := errors::from_runtime(status, errors::IoError.WriteFailed);
        if err != none {
            return (bytesWritten, err);
        }
    }

    return (bytesWritten, none);
}

// Writes every existing byte of source or returns the first failure.
error File::writeAllString(&self, stringv source) {
    if self->handle == null {
        return errors::IoError.Closed;
    }

    u32 offset = 0;
    while offset < source.len() {
        written, err := self->writeString(
            source.substr(offset, source.len() - offset)
        );
        if err != none {
            return err;
        }
        if written == 0 {
            return errors::IoError.WriteFailed;
        }

        offset = offset + written.cast<u32>;
    }

    return none;
}

// Changes and returns the absolute file position.
(u64, error) File::seek(&self, i64 offset, SeekFrom origin) {
    if self->handle == null {
        return (none, errors::IoError.Closed);
    }

    u64 position = 0;
    unsafe {
        i32 status = runtime::flecha_runtime_v1_file_stream_seek(
            self->handle,
            offset,
            origin.number(),
            &raw position
        );

        err := errors::from_runtime(status, errors::IoError.SeekFailed);
        if err != none {
            return (none, err);
        }
    }

    return (position, none);
}

// Requests that buffered operating-system data be committed.
error File::flush(&self) {
    if self->handle == null {
        return errors::IoError.Closed;
    }

    unsafe {
        i32 status = runtime::flecha_runtime_v1_file_stream_flush(
            self->handle
        );

        return errors::from_runtime(status, errors::IoError.FlushFailed);
    }
}

// Relinquishes the handle; even a close failure leaves this value closed.
error File::close(&self) {
    if self->handle == null {
        return errors::IoError.Closed;
    }

    *void handle = self->handle;
    self->handle = null;

    unsafe {
        i32 status = runtime::flecha_runtime_v1_file_stream_close(handle);
        return errors::from_runtime(status, errors::IoError.CloseFailed);
    }
}

error validate_options(OpenOptions options) {
    if !options.read && !options.write {
        return errors::IoError.InvalidOptions;
    }
    if options.append && !options.write {
        return errors::IoError.InvalidOptions;
    }
    if options.truncate && !options.write {
        return errors::IoError.InvalidOptions;
    }
    if options.create && !options.write {
        return errors::IoError.InvalidOptions;
    }
    if options.createNew && !options.write {
        return errors::IoError.InvalidOptions;
    }

    return none;
}
