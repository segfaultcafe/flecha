module filesystem;

@imports
    :: root::io::errors
    :: root::io::file
    :: root::io::path
    :: root::io::stream
    :: root::io::utils
    :: root::io::runtime;

const usize COPY_BUFFER_CAPACITY = 32768;

// Describes the kind and byte size of a filesystem entry.
export structure Metadata {
    // The classified entry kind.
    file::EntryType type;

    // The regular-file byte length, or zero for other entry kinds.
    u64 size;
};

// Reads an entire file as owned bytes stored in a string.
export (string, error) read_file(stringv path) {
    string output = none;
    unsafe {
        i32 status = runtime::flecha_runtime_v1_read_file(
            &raw output,
            path.data(),
            path.len().cast<usize>
        );

        err := errors::from_runtime(status, errors::IoError.ReadFailed);
        if err != none {
            return (none, err);
        }
    }

    return (output, none);
}

// Creates or truncates a file and writes every byte in contents.
export error write_file(stringv path, stringv contents) {
    output, err := file::File::open(path, file::OpenOptions::writeOnly());
    if err != none {
        return err;
    }

    err = output.writeAllString(contents);
    if err != none {
        return err;
    }

    err = output.flush();
    if err != none {
        return err;
    }

    return output.close();
}

// Creates or truncates a file and writes every byte in contents.
export error write_bytes(stringv path, []const u8 contents) {
    output, err := file::File::open(path, file::OpenOptions::writeOnly());
    if err != none {
        return err;
    }

    err = output.writeAll(contents);
    if err != none {
        return err;
    }

    err = output.flush();
    if err != none {
        return err;
    }

    return output.close();
}

// Reports path presence; an absent path returns false without an error.
export (bool, error) exists(stringv path) {
    u8 present = 0;

    unsafe {
        i32 status = runtime::flecha_runtime_v1_path_exists(
            &raw present,
            path.data(),
            path.len().cast<usize>
        );

        err := errors::from_runtime(status, errors::IoError.ExistsFailed);
        if err != none {
            return (false, err);
        }
    }

    return (present != 0, none);
}

// Returns entry kind and size, following symbolic links.
export (Metadata, error) metadata(stringv path) {
    meta := Metadata::init();
    unsafe {
        u8 typeNumber = 0;
        u64 size = 0;

        i32 status = runtime::flecha_runtime_v1_metadata(
            &raw typeNumber,
            &raw size,
            path.data(),
            path.len().cast<usize>
        );

        err := errors::from_runtime(status, errors::IoError.MetadataFailed);
        if err != none {
            return (none, err);
        }

        meta.type = file::EntryType::fromNumber(typeNumber);
        meta.size = size;
    }

    return (meta, none);
}

// Removes a file but not a directory.
export error remove_file(stringv path) {
    unsafe {
        i32 status = runtime::flecha_runtime_v1_remove_file(
            path.data(),
            path.len().cast<usize>
        );

        return errors::from_runtime(status, errors::IoError.RemoveFailed);
    }
}

// Renames a file or directory using the platform's replacement rules.
export error rename(stringv source, stringv destination) {
    unsafe {
        i32 status = runtime::flecha_runtime_v1_rename(
            source.data(),
            source.len().cast<usize>,
            destination.data(),
            destination.len().cast<usize>
        );

        return errors::from_runtime(status, errors::IoError.RenameFailed);
    }
}

// Creates one directory level without creating missing parents.
export error create_directory(stringv path) {
    unsafe {
        i32 status = runtime::flecha_runtime_v1_create_directory(
            path.data(),
            path.len().cast<usize>
        );

        return errors::from_runtime(status, errors::IoError.CreateDirectoryFailed);
    }
}

// Creates path and every missing parent directory. Existing directories
// succeed, while an existing non-directory reports IoError.AlreadyExists.
export error create_directories(stringv value) {
    if !valid_path(value) {
        return errors::IoError.InvalidPath;
    }

    normalized, normalizeError := path::normalize(value);
    if normalizeError != none {
        return normalizeError;
    }

    return create_normalized_directories(normalized.view());
}

// Copies one regular file to a new destination. Existing destinations are
// rejected. The source follows ordinary open semantics, including links.
// A failure after creation may leave a partial destination file.
export error copy_file(stringv source, stringv destination) {
    if !valid_path(source) or !valid_path(destination) {
        return errors::IoError.InvalidPath;
    }

    normalizedSource, sourcePathError := path::normalize(source);
    if sourcePathError != none {
        return sourcePathError;
    }
    normalizedDestination, destinationPathError := path::normalize(destination);
    if destinationPathError != none {
        return destinationPathError;
    }
    sourceInfo, sourceMetadataError := metadata(normalizedSource.view());
    if sourceMetadataError != none {
        return sourceMetadataError;
    }
    if sourceInfo.type != file::EntryType.File {
        return errors::IoError.UnsupportedFileType;
    }

    storage, allocationError := new<own []u8>(COPY_BUFFER_CAPACITY);
    if allocationError != none {
        return allocationError;
    }
    return copy_regular_file(
        normalizedSource.view(),
        normalizedDestination.view(),
        storage[:]
    );
}

// Recursively copies a directory to a new destination. Existing destinations
// are rejected. Symbolic links and unsupported entry kinds are not copied.
// A failure may leave the newly created destination partially populated.
export error copy_directory(stringv source, stringv destination) {
    if !valid_path(source) or !valid_path(destination) {
        return errors::IoError.InvalidPath;
    }

    normalizedSource, sourcePathError := path::normalize(source);
    if sourcePathError != none {
        return sourcePathError;
    }
    normalizedDestination, destinationPathError := path::normalize(destination);
    if destinationPathError != none {
        return destinationPathError;
    }
    destinationWithinSource, containmentError := resolved_path_contains(
        normalizedSource.view(),
        normalizedDestination.view()
    );
    if containmentError != none {
        return containmentError;
    }
    if destinationWithinSource {
        return errors::IoError.InvalidPath;
    }

    sourceInfo, sourceMetadataError := metadata(normalizedSource.view());
    if sourceMetadataError != none {
        return sourceMetadataError;
    }
    if sourceInfo.type != file::EntryType.Directory {
        return errors::IoError.UnsupportedFileType;
    }

    destinationPresent, destinationExistsError := exists(
        normalizedDestination.view()
    );
    if destinationExistsError != none {
        return destinationExistsError;
    }
    if destinationPresent {
        return errors::IoError.AlreadyExists;
    }

    storage, allocationError := new<own []u8>(COPY_BUFFER_CAPACITY);
    if allocationError != none {
        return allocationError;
    }
    return copy_directory_tree(
        normalizedSource.view(),
        normalizedDestination.view(),
        storage[:]
    );
}

error copy_regular_file(
    stringv source,
    stringv destination,
    []u8 buffer,
) {
    input, inputError := file::File::open(source, file::OpenOptions::readOnly());
    if inputError != none {
        return inputError;
    }
    file::OpenOptions outputOptions = none;
    outputOptions.write = true;
    outputOptions.createNew = true;
    output, outputError := file::File::open(destination, outputOptions);
    if outputError != none {
        return outputError;
    }

    error copyError = none;
    {
        reader := input.reader();
        writer := output.writer();
        _, copyError = stream::copy(&reader, &writer, buffer);
    }
    if copyError != none {
        return copyError;
    }

    flushError := output.flush();
    if flushError != none {
        return flushError;
    }
    outputCloseError := output.close();
    if outputCloseError != none {
        return outputCloseError;
    }
    return input.close();
}

error copy_directory_tree(
    stringv source,
    stringv destination,
    []u8 buffer,
) {
    directory, openError := file::Directory::open(source);
    if openError != none {
        return openError;
    }
    creationError := create_directory(destination);
    if creationError != none {
        return creationError;
    }

    while true {
        entry, hasEntry, nextError := directory.next();
        if nextError != none {
            return nextError;
        }
        if !hasEntry {
            break;
        }

        sourceChild, sourceJoinError := path::join(source, entry.name());
        if sourceJoinError != none {
            return sourceJoinError;
        }
        destinationChild, destinationJoinError := path::join(
            destination,
            entry.name()
        );
        if destinationJoinError != none {
            return destinationJoinError;
        }

        if entry.kind() == file::EntryType.File {
            childError := copy_regular_file(
                sourceChild.view(),
                destinationChild.view(),
                buffer
            );
            if childError != none {
                return childError;
            }
        } else {
            if entry.kind() == file::EntryType.Directory {
                childError := copy_directory_tree(
                    sourceChild.view(),
                    destinationChild.view(),
                    buffer
                );
                if childError != none {
                    return childError;
                }
            } else {
                return errors::IoError.UnsupportedFileType;
            }
        }
    }

    return directory.close();
}

error create_normalized_directories(stringv value) {
    info, metadataError := metadata(value);
    if metadataError == none {
        if info.type == file::EntryType.Directory {
            return none;
        }
        return errors::IoError.AlreadyExists;
    }
    if metadataError != errors::IoError.NotFound {
        return metadataError;
    }

    parent := path::parent(value);
    if parent.len() > 0 and parent != value {
        parentError := create_normalized_directories(parent);
        if parentError != none {
            return parentError;
        }
    }

    creationError := create_directory(value);
    if creationError != errors::IoError.AlreadyExists {
        return creationError;
    }

    // Another creator may have won the race. Accept only a directory.
    concurrentInfo, concurrentError := metadata(value);
    if concurrentError != none {
        return concurrentError;
    }
    if concurrentInfo.type != file::EntryType.Directory {
        return errors::IoError.AlreadyExists;
    }
    return none;
}

(bool, error) resolved_path_contains(stringv parent, stringv child) {
    u8 contained = 0;
    unsafe {
        i32 status = runtime::flecha_runtime_v1_path_contains(
            &raw contained,
            parent.data(),
            parent.len().cast<usize>,
            child.data(),
            child.len().cast<usize>
        );
        err := errors::from_runtime(status, errors::IoError.MetadataFailed);
        if err != none {
            return (false, err);
        }
    }
    return (contained != 0, none);
}

bool valid_path(stringv value) {
    if value.len() == 0 {
        return false;
    }
    loop u32 index = 0; index < value.len(); index++ {
        if value[index].cast<char> == '\0' {
            return false;
        }
    }
    return true;
}

// Removes an empty directory. Force recursively removes its tree and treats a
// missing path as success.
export error remove_directory(stringv path, bool force) {
    u8 forceByte = utils::bool_byte(force);

    unsafe {
        i32 status = runtime::flecha_runtime_v1_remove_directory(
            path.data(),
            path.len().cast<usize>,
            forceByte,
            forceByte
        );

        return errors::from_runtime(status, errors::IoError.RemoveDirectoryFailed);
    }
}
