module stream;
under namespace root::io;

@imports :: root::io::errors;

// Reads up to destination.len() bytes and returns a partial count and error.
export func Read([]u8 destination) => (usize, error);

// Owns a reusable byte-read operation.
export structure Reader << Readable {
    private Read operation;
};

// Creates a reader by taking ownership of operation.
Reader Reader::init(Read operation) <- operation override {
    return build Reader {
        self.operation = operation;
    };
}

// Constructs the inert representation used by none.
Reader Reader::zero() override {
    return build Reader {
        self.operation = closed_read;
    };
}

// Performs one read and preserves its partial byte count on error.
(usize, error) Reader::read(&self, []u8 destination) override {
    return (self->operation)(destination);
}

quiver (usize, error) closed_read([]u8 destination) {
    return (none, errors::IoError.Closed);
}
