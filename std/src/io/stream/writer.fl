module stream;
under namespace root::io;

@imports :: root::io::errors;

// Writes up to source.len() bytes and returns a partial count and error.
export func Write([]const u8 source) => (usize, error);

// Owns a reusable byte-write operation.
export structure Writer << Writable {
    private Write operation;
};

// Creates a writer by taking ownership of operation.
Writer Writer::init(Write operation) <- operation override {
    return build Writer {
        self.operation = operation;
    };
}

// Constructs the inert representation used by none.
Writer Writer::zero() override {
    return build Writer {
        self.operation = closed_write;
    };
}

// Performs one write and preserves its partial byte count on error.
(usize, error) Writer::write(&self, []const u8 source) override {
    return (self->operation)(source);
}

quiver (usize, error) closed_write([]const u8 source) {
    return (none, errors::IoError.Closed);
}
