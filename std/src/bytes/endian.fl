module endian;

@imports
    :: root::bytes::errors
    :: root::math::bits;

export typeset fixed_unsigned_integer {
    u8,
    u16,
    u32,
    u64,
};

export (T, errors::ByteError) read_little<T: fixed_unsigned_integer>(
    []const u8 source
) {
    usize byteCount = bits::width<T>() / 8;
    if source.len() < byteCount {
        return (none, errors::ByteError.UnexpectedEnd);
    }

    T value = none;
    loop usize index = 0; index < byteCount; index++ {
        value = value | (source[index].cast<T> << (index * 8));
    }

    return (value, none);
}

export (T, errors::ByteError) read_big<T: fixed_unsigned_integer>(
    []const u8 source
) {
    usize byteCount = bits::width<T>() / 8;
    if source.len() < byteCount {
        return (none, errors::ByteError.UnexpectedEnd);
    }

    T value = none;
    loop usize index = 0; index < byteCount; index++ {
        value = (value << 8) | source[index].cast<T>;
    }

    return (value, none);
}

export errors::ByteError write_little<T: fixed_unsigned_integer>(
    []u8 destination,
    T value
) {
    usize byteCount = bits::width<T>() / 8;
    if destination.len() < byteCount {
        return errors::ByteError.InsufficientSpace;
    }

    loop usize index = 0; index < byteCount; index++ {
        destination[index] = (value & 255).cast<u8>;
        value = value >> 8;
    }

    return none;
}

export errors::ByteError write_big<T: fixed_unsigned_integer>(
    []u8 destination,
    T value
) {
    usize byteCount = bits::width<T>() / 8;
    if destination.len() < byteCount {
        return errors::ByteError.InsufficientSpace;
    }

    usize remaining = byteCount;
    while remaining > 0 {
        remaining = remaining - 1;
        destination[remaining] = (value & 255).cast<u8>;
        value = value >> 8;
    }

    return none;
}
