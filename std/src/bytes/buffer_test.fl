module buffer_test;

@imports
    :: root::bytes::buffer
    :: lib::std::tests::testing
    :: lib::std::tests::asserts;

(buffer::Buffer, error) zero_buffer_result(error failure) {
    return (none, failure);
}

test buffer_is_trivially_zeroable_inside_tuple_results(
    &testing::UnitTest t
) {
    value, failure := zero_buffer_result(AllocationError.OutOfMemory);

    asserts::is_true(
        t,
        failure == AllocationError.OutOfMemory,
        "tuple result preserves its error"
    );
    asserts::is_true(t, value.len() == 0, "zero Buffer has no bytes");
    asserts::is_true(t, value.capacity() == 0, "zero Buffer has no allocation");
    asserts::is_true(t, value.empty(), "zero Buffer is empty and usable");
}

test buffer_with_capacity_constructs_a_usable_owner(&testing::UnitTest t) {
    value, allocationError := buffer::Buffer::withCapacity(2);

    asserts::is_true(
        t,
        allocationError == none,
        "Buffer allocation succeeds"
    );
    if allocationError != none {
        return;
    }

    asserts::is_true(t, value.len() == 0, "new Buffer starts empty");
    asserts::is_true(t, value.capacity() == 2, "Buffer preserves its capacity");
    asserts::is_true(t, value.empty(), "new Buffer reports empty");
}

test buffer_writes_grows_and_exposes_only_initialized_bytes(
    &testing::UnitTest t
) {
    value, allocationError := buffer::Buffer::withCapacity(2);
    if allocationError != none {
        asserts::is_true(t, false, "the setup Buffer is constructed");
        return;
    }

    [3]u8 source = [10, 20, 30];
    writeError := value.write(source[:]);
    asserts::is_true(t, writeError == none, "write grows the Buffer");
    asserts::is_true(t, value.len() == 3, "write advances the length");
    asserts::is_true(t, value.capacity() == 4, "growth doubles capacity");

    {
        bytes := value.bytes();
        asserts::is_true(t, bytes.len() == 3, "bytes hides spare capacity");
        asserts::is_true(
            t,
            bytes[0] == 10 and bytes[1] == 20 and bytes[2] == 30,
            "write preserves byte order"
        );
    }

    value.clear();
    asserts::is_true(t, value.empty(), "clear resets the logical length");
    asserts::is_true(t, value.capacity() == 4, "clear retains capacity");
    asserts::is_true(t, value.bytes().len() == 0, "clear hides old bytes");
}

test zero_buffer_uses_module_capacity_constant_and_writes_strings(
    &testing::UnitTest t
) {
    value, failure := zero_buffer_result(none);
    if failure != none {
        asserts::is_true(t, false, "the zero Buffer setup succeeds");
        return;
    }

    byteError := value.writeByte(65);
    stringError := value.writeString("BC");
    asserts::is_true(
        t,
        byteError == none and stringError == none,
        "byte and string writes succeed"
    );
    asserts::is_true(
        t,
        value.capacity() == 8,
        "the module-level initial-capacity constant drives growth"
    );
    bytes := value.bytes();
    asserts::is_true(
        t,
        bytes.len() == 3 and bytes[0] == 65 and bytes[1] == 66 and
            bytes[2] == 67,
        "writeString appends UTF-8 bytes"
    );
}

test truncate_only_shortens_the_logical_contents(&testing::UnitTest t) {
    value, allocationError := buffer::Buffer::withCapacity(4);
    if allocationError != none {
        asserts::is_true(t, false, "the setup Buffer is constructed");
        return;
    }

    [4]u8 source = [1, 2, 3, 4];
    writeError := value.write(source[:]);
    value.truncate(2);
    value.truncate(3);

    asserts::is_true(t, writeError == none, "the setup write succeeds");
    asserts::is_true(t, value.len() == 2, "truncate cannot grow the Buffer");
    asserts::is_true(t, value.capacity() == 4, "truncate retains capacity");
    bytes := value.bytes();
    asserts::is_true(
        t,
        bytes.len() == 2 and bytes[0] == 1 and bytes[1] == 2,
        "truncate preserves the retained prefix"
    );
}

test resize_shrinks_grows_and_fills_new_bytes(&testing::UnitTest t) {
    value, allocationError := buffer::Buffer::withCapacity(2);
    if allocationError != none {
        asserts::is_true(t, false, "the setup Buffer is constructed");
        return;
    }

    [2]u8 source = [10, 20];
    writeError := value.write(source[:]);
    growError := value.resize(5, 170);

    asserts::is_true(
        t,
        writeError == none and growError == none,
        "resize grows an initialized Buffer"
    );
    asserts::is_true(t, value.len() == 5, "growing resize updates length");
    asserts::is_true(t, value.capacity() == 8, "growing resize expands capacity");
    {
        bytes := value.bytes();
        asserts::is_true(
            t,
            bytes[0] == 10 and bytes[1] == 20 and bytes[2] == 170 and
                bytes[3] == 170 and bytes[4] == 170,
            "growing resize fills only the new bytes"
        );
    }

    shrinkError := value.resize(1, 99);
    sameError := value.resize(1, 77);
    asserts::is_true(
        t,
        shrinkError == none and sameError == none,
        "shrinking and same-length resizes succeed"
    );
    asserts::is_true(
        t,
        value.len() == 1 and value.bytes()[0] == 10,
        "shrinking resize preserves the retained prefix"
    );
    asserts::is_true(t, value.capacity() == 8, "shrinking resize retains capacity");
}

test pop_byte_removes_from_the_end_and_preserves_empty_state(
    &testing::UnitTest t
) {
    value, allocationError := buffer::Buffer::withCapacity(2);
    if allocationError != none {
        asserts::is_true(t, false, "the setup Buffer is constructed");
        return;
    }

    [2]u8 source = [10, 20];
    writeError := value.write(source[:]);
    second, secondError := value.popByte();
    first, firstError := value.popByte();
    missing, emptyError := value.popByte();

    asserts::is_true(t, writeError == none, "the setup write succeeds");
    asserts::is_true(
        t,
        second == 20 and secondError == none and
            first == 10 and firstError == none,
        "popByte removes bytes in reverse order"
    );
    asserts::is_true(
        t,
        missing == 0 and emptyError == buffer::BufferError.Empty,
        "popByte reports an empty Buffer"
    );
    asserts::is_true(
        t,
        value.empty() and value.len() == 0 and value.capacity() == 2,
        "failed popByte preserves the empty Buffer and its allocation"
    );
}
