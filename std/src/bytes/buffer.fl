module buffer;

const usize FL_BUFFER_INIT_CAPACITY = 8;

// Reports failures specific to Buffer operations.
export error BufferError {
    // The requested operation requires at least one stored byte.
    Empty,
}

// Owns a growable sequence of initialized bytes.
export structure Buffer {
    private own []u8 storage;
    private usize length;
};

// Creates an empty buffer with at least the requested initial capacity.
(Buffer, error) Buffer::withCapacity(usize capacity) {
    storage, err := new<own []u8>(capacity);
    if err != none {
        return (none, err);
    }

    return (build Buffer {
        self.storage = storage;
        self.length = 0;
    }, none);
}

// Returns the number of initialized bytes.
usize Buffer::len(&const self) {
    return self->length;
}

// Returns the number of bytes that fit without another allocation.
usize Buffer::capacity(&const self) {
    return self->storage.len();
}

// Ensures at least capacity bytes fit while preserving initialized contents.
error Buffer::reserve(&self, usize capacity) {
    if capacity <= self->capacity() {
        return none;
    }

    replacement, err := new<own []u8>(capacity);
    if err != none {
        return err;
    }

    loop usize index = 0; index < self->length; index++ {
        replacement[index] = self->storage[index];
    }

    self->storage = replacement;
    return none;
}

// Reports whether the buffer contains no initialized bytes.
bool Buffer::empty(&const self) {
    return self->length == 0;
}

// Borrows the initialized prefix of the buffer.
[]const u8 Buffer::bytes(&const self) <-self {
    return self->storage[:self->length];
}

// Removes all initialized bytes without releasing the allocation.
void Buffer::clear(&self) {
    self->length = 0;
}

// Shortens the buffer to length when length is smaller than its current size.
void Buffer::truncate(&self, usize length) {
    if length < self->length {
        self->length = length;
    }
}

// Changes the initialized length, filling newly exposed bytes with fill.
// Allocation failure leaves the length and contents unchanged.
error Buffer::resize(&self, usize length, u8 fill) {
    if length <= self->length {
        self->length = length;
        return none;
    }

    err := self->ensureAdditional(length - self->length);
    if err != none {
        return err;
    }

    loop usize index = self->length; index < length; index++ {
        self->storage[index] = fill;
    }

    self->length = length;
    return none;
}

// Removes and returns the final byte, or BufferError.Empty when empty.
(u8, BufferError) Buffer::popByte(&self) {
    if self->empty() {
        return (none, BufferError.Empty);
    }

    self->length = self->length - 1;
    return (self->storage[self->length], none);
}

// Appends every source byte, preserving existing contents on allocation error.
error Buffer::write(&self, []const u8 source) {
    err := self->ensureAdditional(source.len());
    if err != none {
        return err;
    }

    loop usize index = 0; index < source.len(); index++ {
        const usize AT_INDEX = self->length + index;
        self->insertAt(AT_INDEX, source[index]);
    }

    self->length = self->length + source.len();
    return none;
}

// Appends one byte, preserving existing contents on allocation error.
error Buffer::writeByte(&self, u8 value) {
    err := self->ensureAdditional(1);
    if err != none {
        return err;
    }

    self->pushValue(value);
    return none;
}

// Appends the existing bytes of value without interpreting or validating text.
error Buffer::writeString(&self, stringv value) {
    const usize VAL_LEN = value.len().cast<usize>;
    err := self->ensureAdditional(VAL_LEN);
    if err != none {
        return err;
    }

    loop u32 index = 0; index < value.len(); index++ {
        const usize AT_INDEX = self->length + index.cast<usize>;
        self->insertAt(AT_INDEX, value[index]);
    }

    self->length = self->length + VAL_LEN;
    return none;
}

private void Buffer::pushValue(&self, u8 value) {
    self->storage[self->length] = value;
    self->length++;
}

private void Buffer::insertAt(&self, usize index, u8 value) {
    self->storage[index] = value;
}

private error Buffer::ensureAdditional(&self, usize additional) {
    if additional == 0 {
        return none;
    }

    usize required = self->length + additional;
    if required <= self->length {
        return AllocationError.OutOfMemory;
    }

    usize nextCapacity = self->capacity();
    if nextCapacity == 0 {
        nextCapacity = FL_BUFFER_INIT_CAPACITY;
    }

    while nextCapacity < required {
        usize grown = nextCapacity * 2;
        if grown <= nextCapacity {
            return self->reserve(required);
        }

        nextCapacity = grown;
    }

    return self->reserve(nextCapacity);
}
