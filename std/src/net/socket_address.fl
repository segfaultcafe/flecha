module address;

@imports
    :: root::fmt
    :: root::net::errors;

export structure Ipv4SocketAddress {
    private Ipv4Address address;
    private u16 port;
};

export structure Ipv6SocketAddress {
    private Ipv6Address address;
    private u16 port;
};

// Identifies the address representation stored by SocketAddress.
export enum AddressFamily: u8 {
    default Ipv4,
    Ipv6,
}

// Stores either a portable IPv4 or IPv6 socket address without exposing a
// platform-native socket structure.
export structure SocketAddress {
    private AddressFamily addressFamily;
    private Ipv4SocketAddress ipv4Value;
    private Ipv6SocketAddress ipv6Value;
};

SocketAddress SocketAddress::zero() override {
    return build SocketAddress {
        self.addressFamily = AddressFamily.Ipv4;
        self.ipv4Value = Ipv4SocketAddress::fromParts(
            Ipv4Address::wildcard(),
            0
        );
        self.ipv6Value = Ipv6SocketAddress::fromParts(
            Ipv6Address::wildcard(),
            0
        );
    };
}

SocketAddress SocketAddress::fromIpv4(Ipv4SocketAddress value) {
    return build SocketAddress {
        self.addressFamily = AddressFamily.Ipv4;
        self.ipv4Value = value;
        self.ipv6Value = Ipv6SocketAddress::fromParts(
            Ipv6Address::wildcard(),
            0
        );
    };
}

SocketAddress SocketAddress::fromIpv6(Ipv6SocketAddress value) {
    return build SocketAddress {
        self.addressFamily = AddressFamily.Ipv6;
        self.ipv4Value = Ipv4SocketAddress::fromParts(
            Ipv4Address::wildcard(),
            0
        );
        self.ipv6Value = value;
    };
}

AddressFamily SocketAddress::family(&const self) {
    return self->addressFamily;
}

bool SocketAddress::isIpv4(&const self) {
    return self->addressFamily == AddressFamily.Ipv4;
}

bool SocketAddress::isIpv6(&const self) {
    return self->addressFamily == AddressFamily.Ipv6;
}

(Ipv4SocketAddress, bool) SocketAddress::ipv4(&const self) {
    if !self->isIpv4() {
        return (none, false);
    }
    return (self->ipv4Value, true);
}

(Ipv6SocketAddress, bool) SocketAddress::ipv6(&const self) {
    if !self->isIpv6() {
        return (none, false);
    }
    return (self->ipv6Value, true);
}

(string, error) SocketAddress::toString(&const self) {
    if self->isIpv6() {
        return self->ipv6Value.toString();
    }
    return self->ipv4Value.toString();
}

string SocketAddress::toString!(&const self) {
    text, formattingError := self->toString();
    if formattingError != none {
        crash("failed to format socket address");
    }
    return text;
}

Ipv4SocketAddress Ipv4SocketAddress::fromParts(
    Ipv4Address address,
    u16 port
) {
    return build Ipv4SocketAddress {
        self.address = address;
        self.port = port;
    };
}

Ipv4Address Ipv4SocketAddress::address(&const self) {
    return self->address;
}

u16 Ipv4SocketAddress::port(&const self) {
    return self->port;
}

(Ipv4SocketAddress, error) Ipv4SocketAddress::parse(stringv text) {
    u32 separator = text.len();

    for (u32 index, char c) = range text {
        if c == ':' {
            separator = index;
            break;
        }
    }

    if separator == text.len() {
        return (none, errors::NetworkError.InvalidPort);
    }

    address, addressError :=
        Ipv4Address::parse(text.substr(0, separator));
    if addressError != none {
        return (none, addressError);
    }

    u32 portStart = separator + 1;
    port, portError := parse_socket_port(
        text.substr(portStart, text.len() - portStart)
    );
    if portError != none {
        return (none, portError);
    }

    return (Ipv4SocketAddress::fromParts(address, port), none);
}

(string, error) Ipv4SocketAddress::toString(&const self) {
    addressText, addressError := self->address.toString();
    if addressError != none {
        return (none, addressError);
    }

    return fmt::sprintf("{}:{}", addressText, self->port);
}

string Ipv4SocketAddress::toString!(&const self) {
    text, formattingError := self->toString();
    if formattingError != none {
        crash("failed to format IPv4 socket address");
    }

    return text;
}

Ipv6SocketAddress Ipv6SocketAddress::fromParts(
    Ipv6Address address,
    u16 port
) {
    return build Ipv6SocketAddress {
        self.address = address;
        self.port = port;
    };
}

Ipv6Address Ipv6SocketAddress::address(&const self) {
    return self->address;
}

u16 Ipv6SocketAddress::port(&const self) {
    return self->port;
}

(Ipv6SocketAddress, error) Ipv6SocketAddress::parse(stringv text) {
    if text.len() == 0 or text[0].cast<char> != '[' {
        return (none, errors::NetworkError.InvalidAddress);
    }

    u32 closingBracket = text.len();

    for (u32 index, char c) = range text {
        if index > 0 and c == ']' {
            closingBracket = index;
            break;
        }
    }

    if closingBracket == text.len() {
        return (none, errors::NetworkError.InvalidAddress);
    }

    address, addressError := Ipv6Address::parse(
        text.substr(1, closingBracket - 1)
    );
    if addressError != none {
        return (none, addressError);
    }

    u32 separator = closingBracket + 1;
    if separator >= text.len() or text[separator].cast<char> != ':' {
        return (none, errors::NetworkError.InvalidPort);
    }

    u32 portStart = separator + 1;
    port, portError := parse_socket_port(
        text.substr(portStart, text.len() - portStart)
    );
    if portError != none {
        return (none, portError);
    }

    return (Ipv6SocketAddress::fromParts(address, port), none);
}

(string, error) Ipv6SocketAddress::toString(&const self) {
    addressText, addressError := self->address.toString();
    if addressError != none {
        return (none, addressError);
    }

    return fmt::sprintf("[{}]:{}", addressText, self->port);
}

string Ipv6SocketAddress::toString!(&const self) {
    text, formattingError := self->toString();
    if formattingError != none {
        crash("failed to format IPv6 socket address");
    }

    return text;
}

(u16, error) parse_socket_port(stringv text) {
    if text.len() == 0 {
        return (none, errors::NetworkError.InvalidPort);
    }

    if text.len() > 1 and text[0].cast<char> == '0' {
        return (none, errors::NetworkError.InvalidPort);
    }

    u32 value = 0;
    for (u32 _, char c) = range text {
        if c < '0' or c > '9' {
            return (none, errors::NetworkError.InvalidPort);
        }

        u32 digit = (c.cast<u8> - 48).cast<u32>;
        value = value * 10 + digit;

        if value > 65535 {
            return (none, errors::NetworkError.InvalidPort);
        }
    }

    return (value.cast<u16>, none);
}
