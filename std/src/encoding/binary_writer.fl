module binary;

@imports :: root::math::bits;

// Writes typed values sequentially into a borrowed byte slice.
export structure Writer {
    private []u8 destination;
    private usize position;
};

// Creates a writer positioned at the beginning of destination.
Writer Writer::init([]u8 destination) <-destination override {
    return build Writer {
        self.destination = destination;
        self.position = 0;
    };
}

// Returns the current byte offset.
usize Writer::position(&const self) {
    return self->position;
}

// Returns the total destination length.
usize Writer::len(&const self) {
    return self->destination.len();
}

// Returns the number of unwritten destination bytes.
usize Writer::remaining(&const self) {
    return self->destination.len() - self->position;
}

// Reports whether no destination space remains.
bool Writer::full(&const self) {
    return self->remaining() == 0;
}

// Borrows the initialized destination prefix.
[]const u8 Writer::writtenBytes(&const self) <-self {
    return self->destination[:self->position];
}

// Advances exactly count bytes without writing, or does not advance on error.
BinaryError Writer::skip(&self, usize count) {
    if count > self->remaining() {
        return BinaryError.InsufficientSpace;
    }

    self->position = self->position + count;
    return none;
}

// Moves the current position back to the beginning without clearing bytes.
void Writer::reset(&self) {
    self->position = 0;
}

// Writes one byte and advances, or does not advance when full.
BinaryError Writer::writeByte(&self, u8 value) {
    if self->full() {
        return BinaryError.InsufficientSpace;
    }

    self->destination[self->position] = value;
    self->position++;
    return none;
}

// Writes the existing bytes of value without interpreting or validating text.
// Insufficient space leaves the writer unchanged.
BinaryError Writer::writeString(&self, stringv value) {
    const usize LEN = value.len().cast<usize>;
    if LEN > self->remaining() {
        return BinaryError.InsufficientSpace;
    }

    loop u32 index = 0; index < value.len(); index++ {
        self->destination[self->position + index.cast<usize>] = value[index];
    }

    self->position = self->position + LEN;
    return none;
}

// Writes every source byte and advances, or leaves the writer unchanged.
BinaryError Writer::write(&self, []const u8 source) {
    if source.len() > self->remaining() {
        return BinaryError.InsufficientSpace;
    }

    loop usize index = 0; index < source.len(); index++ {
        self->destination[self->position + index] = source[index];
    }

    self->position = self->position + source.len();
    return none;
}

// Writes one little-endian fixed-width integer and advances.
// Failure leaves the writer unchanged.
BinaryError Writer::writeLittle<
    T: fixed_unsigned_integer
>(&self, T value) {
    usize byteCount = bits::width<T>() / 8;
    if byteCount > self->remaining() {
        return BinaryError.InsufficientSpace;
    }

    err := write_little<T>(self->destination[self->position:], value);
    if err != none {
        return err;
    }

    self->position = self->position + byteCount;
    return none;
}

// Writes one big-endian fixed-width integer and advances.
// Failure leaves the writer unchanged.
BinaryError Writer::writeBig<
    T: fixed_unsigned_integer
>(&self, T value) {
    usize byteCount = bits::width<T>() / 8;
    if byteCount > self->remaining() {
        return BinaryError.InsufficientSpace;
    }

    err := write_big<T>(self->destination[self->position:], value);
    if err != none {
        return err;
    }

    self->position = self->position + byteCount;
    return none;
}

// Writes one canonical unsigned variable-width integer and advances.
// Failure leaves the writer unchanged.
BinaryError Writer::writeVarint<
    T: fixed_unsigned_integer
>(&self, T value) {
    byteCount, err := write_varint<T>(
        self->destination[self->position:],
        value
    );
    if err != none {
        return err;
    }

    self->position = self->position + byteCount;
    return none;
}
