module binary;

@imports :: root::math::bits;

// Returns the canonical unsigned variable-width encoding length.
export usize varint_length<T: fixed_unsigned_integer>(T value) {
    usize length = 1;
    while value >= 128 {
        value = value >> 7;
        length++;
    }

    return length;
}

// Writes a canonical unsigned variable-width integer and its byte count.
// An undersized destination is left unchanged.
export (usize, BinaryError) write_varint<
    T: fixed_unsigned_integer
>([]u8 destination, T value) {
    const usize LENGTH = varint_length<T>(value);
    if destination.len() < LENGTH {
        return (none, BinaryError.InsufficientSpace);
    }

    usize index = 0;
    while value >= 128 {
        destination[index] = ((value & 127) | 128).cast<u8>;
        value = value >> 7;
        index++;
    }

    destination[index] = value.cast<u8>;
    return (LENGTH, none);
}

// Reads a canonical unsigned variable-width integer and its consumed length.
export (T, usize, BinaryError) read_varint<
    T: fixed_unsigned_integer
>([]const u8 source) {
    const usize MAX_BYTES = (bits::width<T>() + 6) / 7;
    T value = none;
    usize index = 0;

    while index < source.len() {
        if index >= MAX_BYTES {
            return (none, none, BinaryError.Overflow);
        }

        const u8 BYTE = source[index];
        const T PAYLOAD = (BYTE & 127).cast<T>;
        const usize SHIFT = index * 7;

        if PAYLOAD > (T.max_value >> SHIFT) {
            return (none, none, BinaryError.Overflow);
        }

        value = value | (PAYLOAD << SHIFT);
        index++;

        if (BYTE & 128) == 0 {
            if index > 1 and PAYLOAD == 0 {
                return (none, none, BinaryError.InvalidEncoding);
            }

            return (value, index, none);
        }
    }

    return (none, none, BinaryError.UnexpectedEnd);
}

// Maps a signed fixed-width integer to its ZigZag unsigned wire value.
// The result remains within the unsigned width corresponding to T.
export u64 zigzag_encode<T: fixed_signed_integer>(T value) {
    const i64 SIGNED_VALUE = value.cast<i64>;
    if SIGNED_VALUE < 0 {
        return (-(SIGNED_VALUE + 1)).cast<u64> * 2 + 1;
    }

    return SIGNED_VALUE.cast<u64> * 2;
}

// Maps a ZigZag wire value back to T, rejecting values outside T's width.
export (T, BinaryError) zigzag_decode<T: fixed_signed_integer>(u64 value) {
    const u64 MAX_ENCODED = T.max_value.cast<u64> * 2 + 1;
    if value > MAX_ENCODED {
        return (none, BinaryError.Overflow);
    }

    const u64 MAGNITUDE = value >> 1;
    if (value & 1) == 0 {
        return (MAGNITUDE.cast<T>, none);
    }

    const i64 NEGATIVE = -MAGNITUDE.cast<i64> - 1;
    return (NEGATIVE.cast<T>, none);
}

// Returns the canonical ZigZag variable-width encoding length.
export usize signed_varint_length<T: fixed_signed_integer>(T value) {
    return varint_length<u64>(zigzag_encode<T>(value));
}

// Writes a canonical ZigZag variable-width integer and its byte count.
// An undersized destination is left unchanged.
export (usize, BinaryError) write_signed_varint<
    T: fixed_signed_integer
>([]u8 destination, T value) {
    return write_varint<u64>(destination, zigzag_encode<T>(value));
}

// Reads a canonical ZigZag variable-width integer and its consumed length.
export (T, usize, BinaryError) read_signed_varint<
    T: fixed_signed_integer
>([]const u8 source) {
    encoded, byteCount, readError := read_varint<u64>(source);
    if readError != none {
        return (none, none, readError);
    }

    value, decodeError := zigzag_decode<T>(encoded);
    if decodeError != none {
        return (none, none, decodeError);
    }

    return (value, byteCount, none);
}
