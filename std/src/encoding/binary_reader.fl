module binary;

@imports :: root::math::bits;

// Reads typed values sequentially from a borrowed byte slice.
export structure Reader {
    private []const u8 source;
    private usize position;
};

// Creates a reader positioned at the beginning of source.
Reader Reader::init([]const u8 source) <-source override {
    return build Reader {
        self.source = source;
        self.position = 0;
    };
}

// Returns the current byte offset.
usize Reader::position(&const self) {
    return self->position;
}

// Returns the total source length.
usize Reader::len(&const self) {
    return self->source.len();
}

// Returns the number of unread bytes.
usize Reader::remaining(&const self) {
    return self->source.len() - self->position;
}

// Reports whether no unread bytes remain.
bool Reader::empty(&const self) {
    return self->remaining() == 0;
}

// Reads one byte without advancing on UnexpectedEnd.
(u8, BinaryError) Reader::readByte(&self) {
    if self->empty() {
        return (none, BinaryError.UnexpectedEnd);
    }

    u8 value = self->source[self->position];
    self->position++;
    return (value, none);
}

// Borrows and advances past exactly count bytes, or does not advance on error.
([]const u8, BinaryError) Reader::read(&self, usize count) <-self {
    if count > self->remaining() {
        return (
            self->source[self->position:self->position],
            BinaryError.UnexpectedEnd
        );
    }

    usize start = self->position;
    self->position = self->position + count;
    return (self->source[start:self->position], none);
}

// Reads and advances past one little-endian fixed-width integer.
// Failure leaves the position unchanged.
(T, BinaryError) Reader::readLittle<
    T: fixed_unsigned_integer
>(&self) {
    usize byteCount = bits::width<T>() / 8;
    if byteCount > self->remaining() {
        return (none, BinaryError.UnexpectedEnd);
    }

    value, err := read_little<T>(self->source[self->position:]);
    if err != none {
        return (none, err);
    }

    self->position = self->position + byteCount;
    return (value, none);
}

// Reads and advances past one big-endian fixed-width integer.
// Failure leaves the position unchanged.
(T, BinaryError) Reader::readBig<
    T: fixed_unsigned_integer
>(&self) {
    usize byteCount = bits::width<T>() / 8;
    if byteCount > self->remaining() {
        return (none, BinaryError.UnexpectedEnd);
    }

    value, err := read_big<T>(self->source[self->position:]);
    if err != none {
        return (none, err);
    }

    self->position = self->position + byteCount;
    return (value, none);
}

// Reads and advances past one canonical unsigned variable-width integer.
// Failure leaves the position unchanged.
(T, BinaryError) Reader::readVarint<
    T: fixed_unsigned_integer
>(&self) {
    value, byteCount, err := read_varint<T>(self->source[self->position:]);
    if err != none {
        return (none, err);
    }

    self->position = self->position + byteCount;
    return (value, none);
}

// Returns the next byte without advancing.
(u8, BinaryError) Reader::peekByte(&const self) {
    if self->empty() {
        return (none, BinaryError.UnexpectedEnd);
    }

    return (self->source[self->position], none);
}

// Advances exactly count bytes, or does not advance on UnexpectedEnd.
BinaryError Reader::skip(&self, usize count) {
    if self->remaining() < count {
        return BinaryError.UnexpectedEnd;
    }
    
    self->position = self->position + count;
    return none;
}

// Borrows the unread suffix without advancing.
[]const u8 Reader::remainingBytes(&const self) <-self {
    return self->source[self->position:];
}

// Borrows the unread suffix and advances to the end.
([]const u8, BinaryError) Reader::readRemaining(&self) <-self {
    return self->read(self->remaining()); 
}

// Moves the current position back to the beginning.
void Reader::reset(&self) {
    self->position = 0;
}
