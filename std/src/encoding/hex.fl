module hex;

@imports :: root::text::strings;

// Reports hexadecimal output-length and input-validation failures.
export error HexError {
    // The required output length cannot be represented by usize.
    Overflow,

    // The source has odd length or contains a non-hexadecimal byte.
    InvalidEncoding,
}

// Returns twice byteCount, or HexError.Overflow.
export (usize, HexError) encoded_length(usize byteCount) {
    length, overflowed := byteCount.overflow_mul(2);
    if overflowed {
        return (none, HexError.Overflow);
    }

    return (length, none);
}

// Validates hexadecimal source and returns its decoded byte count.
export (usize, HexError) decoded_length([]const u8 source) {
    if source.len() % 2 != 0 {
        return (none, HexError.InvalidEncoding);
    }

    loop usize index = 0; index < source.len(); index++ {
        if !is_digit(source[index]) {
            return (none, HexError.InvalidEncoding);
        }
    }

    return (source.len() / 2, none);
}

// Encodes a borrowed byte string with lowercase hexadecimal digits.
export (string, error) encode(stringv source) {
    bytes, encodeError := encode_to_bytes(source);
    if encodeError != none {
        return (none, encodeError);
    }

    return strings::string_from_bytes(bytes[:]);
}

// Encodes arbitrary borrowed bytes as a lowercase hexadecimal string.
export (string, error) encode_bytes([]const u8 source) {
    return encode(source.cast<stringv>);
}

// Encodes arbitrary borrowed bytes as owned lowercase hexadecimal bytes.
export (own []u8, error) encode_byte_to_byte([]const u8 source) {
    return encode_to_bytes(source.cast<stringv>);
}

// Encodes a borrowed byte string as owned lowercase hexadecimal bytes.
export (own []u8, error) encode_to_bytes(stringv source) {
    return encode_with_case(source, false);
}

// Encodes a borrowed byte string with uppercase hexadecimal digits.
export (string, error) encode_upper(stringv source) {
    bytes, encodeError := encode_upper_to_bytes(source);
    if encodeError != none {
        return (none, encodeError);
    }

    return strings::string_from_bytes(bytes[:]);
}

// Encodes arbitrary borrowed bytes as an uppercase hexadecimal string.
export (string, error) encode_upper_bytes([]const u8 source) {
    return encode_upper(source.cast<stringv>);
}

// Encodes arbitrary borrowed bytes as owned uppercase hexadecimal bytes.
export (own []u8, error) encode_upper_byte_to_byte([]const u8 source) {
    return encode_upper_to_bytes(source.cast<stringv>);
}

// Encodes a borrowed byte string as owned uppercase hexadecimal bytes.
export (own []u8, error) encode_upper_to_bytes(stringv source) {
    return encode_with_case(source, true);
}

// Decodes a borrowed hexadecimal string into a byte-oriented string.
export (string, error) decode(stringv source) {
    bytes, decodeError := decode_to_bytes(source);
    if decodeError != none {
        return (none, decodeError);
    }

    return strings::string_from_bytes(bytes[:]);
}

// Decodes borrowed hexadecimal bytes into a byte-oriented string.
export (string, error) decode_from_bytes([]const u8 source) {
    return decode(source.cast<stringv>);
}

// Decodes borrowed hexadecimal bytes into owned binary bytes.
export (own []u8, error) decode_byte_to_byte([]const u8 source) {
    return decode_to_bytes(source.cast<stringv>);
}

// Validates source before allocating and returns its decoded bytes.
export (own []u8, error) decode_to_bytes(stringv source) {
    const usize LENGTH, HexError lengthError =
        validated_decoded_length(source);
    if lengthError != none {
        return (none, lengthError);
    }

    destination, allocationError := new<own []u8>(LENGTH);
    if allocationError != none {
        return (none, allocationError);
    }

    loop usize index = 0; index < LENGTH; index++ {
        const usize SOURCE_INDEX = index * 2;
        const u8 HIGH = digit_value(source[SOURCE_INDEX.cast<u32>]);
        const u8 LOW = digit_value(source[(SOURCE_INDEX + 1).cast<u32>]);
        destination[index] = (HIGH << 4) | LOW;
    }

    return (destination, none);
}

(own []u8, error) encode_with_case(stringv source, bool uppercase) {
    const usize SOURCE_LENGTH = source.len().cast<usize>;
    const usize LENGTH, HexError lengthError =
        encoded_length(SOURCE_LENGTH);
    if lengthError != none {
        return (none, lengthError);
    }

    destination, allocationError := new<own []u8>(LENGTH);
    if allocationError != none {
        return (none, allocationError);
    }

    loop usize index = 0; index < SOURCE_LENGTH; index++ {
        const usize DESTINATION_INDEX = index * 2;
        const u8 BYTE = source[index.cast<u32>];
        destination[DESTINATION_INDEX] = digit(BYTE >> 4, uppercase);
        destination[DESTINATION_INDEX + 1] = digit(BYTE & 15, uppercase);
    }

    return (destination, none);
}

(usize, HexError) validated_decoded_length(stringv source) {
    const usize SOURCE_LENGTH = source.len().cast<usize>;
    if SOURCE_LENGTH % 2 != 0 {
        return (none, HexError.InvalidEncoding);
    }

    loop usize index = 0; index < SOURCE_LENGTH; index++ {
        if !is_digit(source[index.cast<u32>]) {
            return (none, HexError.InvalidEncoding);
        }
    }

    return (SOURCE_LENGTH / 2, none);
}

u8 digit(u8 value, bool uppercase) {
    if value < 10 {
        return value + 48;
    }

    if uppercase {
        return value + 55;
    }

    return value + 87;
}

bool is_digit(u8 value) {
    return (value >= 48 and value <= 57) or
        (value >= 65 and value <= 70) or
        (value >= 97 and value <= 102);
}

u8 digit_value(u8 value) {
    if value <= 57 {
        return value - 48;
    }

    if value <= 70 {
        return value - 55;
    }

    return value - 87;
}
