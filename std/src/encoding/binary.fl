module binary;

@imports :: root::math::bits;

// Reports fixed-width and variable-width binary encoding failures.
export error BinaryError {
    // The source ended before a complete value was available.
    UnexpectedEnd,

    // The destination cannot hold the complete encoded value.
    InsufficientSpace,

    // The decoded or calculated value cannot be represented by its type.
    Overflow,

    // The input is structurally valid bytes but not a canonical encoding.
    InvalidEncoding,
}

// Contains fixed-width unsigned types supported by binary encoders.
export typeset fixed_unsigned_integer {
    u8,
    u16,
    u32,
    u64,
};

// Reads one fixed-width integer from a little-endian byte prefix.
export (T, BinaryError) read_little<T: fixed_unsigned_integer>(
    []const u8 source
) {
    usize byteCount = bits::width<T>() / 8;
    if source.len() < byteCount {
        return (none, BinaryError.UnexpectedEnd);
    }

    T value = none;
    loop usize index = 0; index < byteCount; index++ {
        value = value | (source[index].cast<T> << (index * 8));
    }

    return (value, none);
}

// Reads one fixed-width integer from a big-endian byte prefix.
export (T, BinaryError) read_big<T: fixed_unsigned_integer>(
    []const u8 source
) {
    usize byteCount = bits::width<T>() / 8;
    if source.len() < byteCount {
        return (none, BinaryError.UnexpectedEnd);
    }

    T value = none;
    loop usize index = 0; index < byteCount; index++ {
        value = (value << 8) | source[index].cast<T>;
    }

    return (value, none);
}

// Writes one fixed-width integer in little-endian order.
// An undersized destination is left unchanged.
export BinaryError write_little<T: fixed_unsigned_integer>(
    []u8 destination,
    T value
) {
    usize byteCount = bits::width<T>() / 8;
    if destination.len() < byteCount {
        return BinaryError.InsufficientSpace;
    }

    loop usize index = 0; index < byteCount; index++ {
        destination[index] = (value & 255).cast<u8>;
        value = value >> 8;
    }

    return none;
}

// Writes one fixed-width integer in big-endian order.
// An undersized destination is left unchanged.
export BinaryError write_big<T: fixed_unsigned_integer>(
    []u8 destination,
    T value
) {
    usize byteCount = bits::width<T>() / 8;
    if destination.len() < byteCount {
        return BinaryError.InsufficientSpace;
    }

    usize remaining = byteCount;
    while remaining > 0 {
        remaining = remaining - 1;
        destination[remaining] = (value & 255).cast<u8>;
        value = value >> 8;
    }

    return none;
}
