module strings;

@imports
    :: root::text::runtime
    :: root::text::utf8
    :: root::bytes::buffer;

// Builds byte-oriented text incrementally with explicit allocation failures.
export structure StringBuilder {
    private buffer::Buffer storage;
};

// Creates an empty builder with at least the requested initial capacity.
(StringBuilder, error) StringBuilder::withCapacity(usize capacity) {
    buffer, err := buffer::Buffer::withCapacity(capacity);
    if err != none {
        return (StringBuilder::init(), err);
    }

    return (build StringBuilder {
        self.storage = buffer;
    }, none);
}

// Returns the number of accumulated bytes.
usize StringBuilder::len(&const self) {
    return self->storage.len();
}

// Returns the number of bytes that fit without another allocation.
usize StringBuilder::capacity(&const self) {
    return self->storage.capacity();
}

// Reports whether the builder contains no bytes.
bool StringBuilder::empty(&const self) {
    return self->storage.empty();
}

// Ensures at least capacity bytes fit while preserving existing contents.
error StringBuilder::reserve(&self, usize capacity) {
    return self->storage.reserve(capacity);
}

// Appends the existing bytes of value.
error StringBuilder::append(&self, stringv value) {
    return self->storage.writeString(value);
}

// Appends one byte-oriented character.
error StringBuilder::appendChar(&self, char value) {
    return self->storage.writeByte(value);
}

// Appends arbitrary bytes without interpreting or validating text.
error StringBuilder::appendBytes(&self, []const u8 value) {
    return self->storage.write(value);
}

// Appends value using lowercase digits in a base from 2 through 36.
// Invalid bases and allocation failures preserve the builder contents.
error StringBuilder::appendInteger<T: integer>(
    &self,
    T value,
    u8 base = 10,
) {
    [65]u8 formatted = none;
    written, formatError := format_integer(formatted[:], value, base);
    if formatError != none {
        return formatError;
    }

    return self->storage.write(formatted[:written]);
}

// Appends the shortest locale-independent decimal representation that round
// trips to value. Allocation failure preserves the builder contents.
error StringBuilder::appendFloat<T: floating_point>(&self, T value) {
    [64]u8 formatted = none;
    written, formatError := format_float<T>(formatted[:], value);
    if formatError != none {
        return formatError;
    }

    return self->storage.write(formatted[:written]);
}

// Appends "true" or "false".
error StringBuilder::appendBool(&self, bool value) {
    if value {
        return self->storage.writeString("true");
    }

    return self->storage.writeString("false");
}

// Appends value the requested number of times, preserving contents on failure.
error StringBuilder::appendRepeated(&self, char value, usize times) {
    err := self->reserveAdditional(times);
    if err != none {
        return err;
    }

    loop usize i = 0; i < times; i++ {
        err = self->storage.writeByte(value);
        if err != none {
            return err;
        }
    }

    return none;
}

// Appends one Unicode scalar encoded as UTF-8.
// Preserves the builder on invalid input or allocation failure.
error StringBuilder::appendCodePoint(&self, u32 codePoint) {
    encoded, length, encodingError := utf8::encode(codePoint);
    if encodingError != none {
        return encodingError;
    }

    err := self->reserveAdditional(length);
    if err != none {
        return err;
    }

    return self->storage.write(encoded[:length]);
}

// Borrows the builder contents as text.
stringv StringBuilder::view(&const self) <-self {
    return stringv_from_bytes(self->storage.bytes());
}

// Copies the builder contents into an owning string.
(string, error) StringBuilder::toString(&const self) {
    return string_from_bytes(self->storage.bytes());
}

// Appends line followed by a newline, preserving contents on allocation error.
error StringBuilder::appendLine(&self, stringv line) {
    usize additional = line.len().cast<usize>;
    additional++;
    if additional == 0 {
        return AllocationError.OutOfMemory;
    }

    err := self->reserveAdditional(additional);
    if err != none {
        return err;
    }

    err = self->storage.writeString(line);
    if err != none {
        return err;
    }

    return self->storage.writeByte('\n');
}

// Removes all accumulated bytes without releasing the allocation.
void StringBuilder::clear(&self) {
    self->storage.clear();
}

// Borrows all accumulated bytes.
[]const u8 StringBuilder::bytes(&const self) <-self {
    return self->storage.bytes();
}

private error StringBuilder::reserveAdditional(&self, usize additional) {
    if additional == 0 {
        return none;
    }

    const usize CURRENT = self->len();
    const usize REQUIRED = CURRENT + additional;
    if REQUIRED < CURRENT {
        return AllocationError.OutOfMemory;
    }

    return self->storage.reserve(REQUIRED);
}

// Borrows value as byte-oriented text without allocating.
export stringv stringv_from_bytes([]const u8 value) <-value {
    return value.cast<stringv>;
}

// Copies value into a null-terminated owning string.
export (string, error) string_from_bytes([]const u8 value) {
    string result = none;

    unsafe {
        i32 status = runtime::flecha_runtime_v1_string_try_from_bytes(
            &raw result,
            value.data(),
            value.len()
        );

        if status != 0 {
            return (none, AllocationError.OutOfMemory);
        }
    }

    return (result, none);
}
