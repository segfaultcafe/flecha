module strings_test;

@imports
    :: root::text::strings
    :: root::text::utf8
    :: root::text::errors as text_errors
    :: lib::std::tests::testing
    :: lib::std::tests::asserts;

test string_builder_init_is_empty_and_uses_no_allocation(
    &testing::UnitTest t
) {
    value := strings::StringBuilder::init();

    asserts::is_true(t, value.len() == 0, "StringBuilder starts empty");
    asserts::is_true(
        t,
        value.capacity() == 0,
        "StringBuilder init does not allocate"
    );
}

test string_builder_with_capacity_reserves_storage(&testing::UnitTest t) {
    value, err := strings::StringBuilder::withCapacity(12);

    asserts::is_true(t, err == none, "StringBuilder allocation succeeds");
    if err != none {
        return;
    }

    asserts::is_true(t, value.len() == 0, "reserved builder remains empty");
    asserts::is_true(
        t,
        value.capacity() == 12,
        "StringBuilder preserves the requested capacity"
    );
}

test string_builder_appends_text_characters_and_bytes(&testing::UnitTest t) {
    value := strings::StringBuilder::init();
    textError := value.append("fle");
    charError := value.appendChar('c');
    [3]u8 suffix = [104, 0, 97];
    bytesError := value.appendBytes(suffix[:]);

    asserts::is_true(
        t,
        textError == none and charError == none and bytesError == none,
        "every append operation succeeds"
    );
    asserts::is_true(t, value.len() == 7, "appends advance the byte length");

    bytes := value.bytes();
    asserts::is_true(
        t,
        bytes[0] == 102 and bytes[1] == 108 and bytes[2] == 101 and
            bytes[3] == 99 and bytes[4] == 104 and bytes[5] == 0 and
            bytes[6] == 97,
        "appends preserve byte order including embedded nulls"
    );
}

test string_builder_appends_integers_and_booleans(&testing::UnitTest t) {
    value := strings::StringBuilder::init();

    prefixError := value.append("values=");
    decimalError := value.appendInteger<i32>(-42);
    firstSeparatorError := value.appendChar(',');
    hexError := value.appendInteger<u16>(255, 16);
    secondSeparatorError := value.appendChar(',');
    trueError := value.appendBool(true);
    thirdSeparatorError := value.appendChar(',');
    falseError := value.appendBool(false);

    asserts::is_true(
        t,
        prefixError == none and decimalError == none and
            firstSeparatorError == none and hexError == none and
            secondSeparatorError == none and trueError == none and
            thirdSeparatorError == none and falseError == none,
        "integer and boolean appends succeed"
    );
    asserts::is_true(
        t,
        value.view() == "values=-42,ff,true,false",
        "integer bases and boolean spellings append exactly"
    );
}

test string_builder_appends_integer_boundaries(&testing::UnitTest t) {
    value := strings::StringBuilder::init();

    minimumError := value.appendInteger<i64>(i64.min_value);
    separatorError := value.appendChar('|');
    maximumError := value.appendInteger<u64>(u64.max_value, 2);

    asserts::is_true(
        t,
        minimumError == none and separatorError == none and
            maximumError == none,
        "integer boundary appends succeed"
    );
    asserts::is_true(
        t,
        value.view() ==
            "-9223372036854775808|1111111111111111111111111111111111111111111111111111111111111111",
        "integer boundaries retain every digit"
    );
}

test string_builder_invalid_integer_base_preserves_contents(
    &testing::UnitTest t
) {
    value := strings::StringBuilder::init();
    setupError := value.append("kept");
    formatError := value.appendInteger<i32>(42, 1);

    asserts::is_true(t, setupError == none, "the setup append succeeds");
    asserts::is_true(
        t,
        formatError == text_errors::FormatError.InvalidBase,
        "invalid integer bases report the formatting error"
    );
    asserts::is_true(
        t,
        value.view() == "kept",
        "invalid integer bases preserve builder contents"
    );
}

test integer_text_conversion_handles_bases_and_boundaries(
    &testing::UnitTest t
) {
    hexadecimal, formatError := strings::int_to_string(-255, 16);
    minimum, minimumError :=
        strings::stringv_to_int<i64>("-9223372036854775808");
    maximum, maximumError :=
        strings::stringv_to_int<u64>("18446744073709551615");

    asserts::is_true(
        t,
        formatError == none and hexadecimal == "-ff",
        "integer formatting supports signed non-decimal values"
    );
    asserts::is_true(
        t,
        minimumError == none and minimum == i64.min_value,
        "integer parsing accepts the signed minimum"
    );
    asserts::is_true(
        t,
        maximumError == none and maximum == u64.max_value,
        "integer parsing accepts the unsigned maximum"
    );
}

test integer_text_conversion_reports_invalid_input(
    &testing::UnitTest t
) {
    _, baseError := strings::int_to_string(42, 1);
    _, emptyError := strings::stringv_to_int<i32>("");
    _, syntaxError := strings::stringv_to_int<i32>("12x");
    _, signError := strings::stringv_to_int<u32>("-1");
    _, overflowError := strings::stringv_to_int<i8>("128");

    asserts::is_true(
        t,
        baseError == text_errors::FormatError.InvalidBase,
        "invalid formatting bases are rejected"
    );
    asserts::is_true(
        t,
        emptyError == text_errors::ParseError.Empty,
        "empty integer text is rejected"
    );
    asserts::is_true(
        t,
        syntaxError == text_errors::ParseError.InvalidSyntax and
            signError == text_errors::ParseError.InvalidSyntax,
        "invalid digits and unsigned signs are rejected"
    );
    asserts::is_true(
        t,
        overflowError == text_errors::ParseError.Overflow,
        "integer parsing reports target-width overflow"
    );
}

test floating_text_conversion_round_trips_values(&testing::UnitTest t) {
    narrowText, narrowFormatError :=
        strings::float_to_string<f32>(1.25 as f32);
    wideText, wideFormatError :=
        strings::float_to_string<f64>(-0.00000000000000001);
    narrow, narrowParseError :=
        strings::stringv_to_float<f32>(narrowText.cast<stringv>);
    wide, wideParseError :=
        strings::stringv_to_float<f64>(wideText.cast<stringv>);

    asserts::is_true(
        t,
        narrowFormatError == none and wideFormatError == none and
            narrowParseError == none and wideParseError == none,
        "floating-point formatting and parsing succeed"
    );
    asserts::is_true(
        t,
        narrow == (1.25 as f32) and wide == -0.00000000000000001,
        "shortest formatting round trips both widths"
    );
}

test floating_text_parsing_requires_complete_input(&testing::UnitTest t) {
    positive, positiveError := strings::stringv_to_float<f64>("+1.5e2");
    _, emptyError := strings::stringv_to_float<f64>("");
    _, whitespaceError := strings::stringv_to_float<f64>(" 1.5");
    _, suffixError := strings::stringv_to_float<f32>("1.5x");
    _, overflowError := strings::stringv_to_float<f64>("1e9999");
    _, nonCanonicalError := strings::stringv_to_float<f64>("NAN");

    asserts::is_true(
        t,
        positiveError == none and positive == 150.0,
        "signed exponent notation parses"
    );
    asserts::is_true(
        t,
        emptyError == text_errors::ParseError.Empty,
        "empty floating-point text is rejected"
    );
    asserts::is_true(
        t,
        whitespaceError == text_errors::ParseError.InvalidSyntax and
            suffixError == text_errors::ParseError.InvalidSyntax and
            nonCanonicalError == text_errors::ParseError.InvalidSyntax,
        "whitespace, trailing bytes, and noncanonical spellings are rejected"
    );
    asserts::is_true(
        t,
        overflowError == text_errors::ParseError.Overflow,
        "floating-point range errors are reported"
    );
}

test floating_format_preserves_small_destinations(&testing::UnitTest t) {
    [3]u8 destination = [107, 101, 112];
    _, err := strings::format_float<f64>(destination[:], 12.5);

    asserts::is_true(
        t,
        err == text_errors::FormatError.InsufficientSpace,
        "short destinations report the formatting error"
    );
    asserts::is_true(
        t,
        destination[0] == 107 and destination[1] == 101 and
            destination[2] == 112,
        "failed formatting preserves destination bytes"
    );
}

test string_builder_appends_floating_values(&testing::UnitTest t) {
    value := strings::StringBuilder::init();
    prefixError := value.append("values=");
    firstError := value.appendFloat<f32>(1.25 as f32);
    separatorError := value.appendChar(',');
    secondError := value.appendFloat<f64>(-0.5);

    asserts::is_true(
        t,
        prefixError == none and firstError == none and
            separatorError == none and secondError == none,
        "floating-point builder appends succeed"
    );
    asserts::is_true(
        t,
        value.view() == "values=1.25,-0.5",
        "builder uses deterministic shortest formatting"
    );
}

test string_builder_appends_repeated_characters_and_lines(
    &testing::UnitTest t
) {
    value, allocationError := strings::StringBuilder::withCapacity(8);
    if allocationError != none {
        asserts::is_true(t, false, "the setup builder is constructed");
        return;
    }

    prefixError := value.append("ab");
    repeatError := value.appendRepeated('x', 3);
    lineError := value.appendLine("123");

    asserts::is_true(
        t,
        prefixError == none and repeatError == none and lineError == none,
        "compound appends succeed"
    );
    asserts::is_true(t, value.len() == 9, "compound appends include newline");
    asserts::is_true(
        t,
        value.capacity() >= 9,
        "appendLine reserves text and newline together"
    );

    bytes := value.bytes();
    asserts::is_true(
        t,
        bytes[0] == 97 and bytes[1] == 98 and bytes[2] == 120 and
            bytes[3] == 120 and bytes[4] == 120 and bytes[5] == 49 and
            bytes[6] == 50 and bytes[7] == 51 and bytes[8] == 10,
        "repetition and line appending preserve exact contents"
    );
}

test string_builder_compound_appends_handle_empty_inputs(
    &testing::UnitTest t
) {
    value := strings::StringBuilder::init();
    repeatError := value.appendRepeated('x', 0);
    lineError := value.appendLine("");

    asserts::is_true(
        t,
        repeatError == none and lineError == none,
        "empty compound appends succeed"
    );
    bytes := value.bytes();
    asserts::is_true(
        t,
        bytes.len() == 1 and bytes[0] == 10,
        "an empty line appends only a newline"
    );
}

test string_builder_appends_unicode_code_points(&testing::UnitTest t) {
    value := strings::StringBuilder::init();
    asciiError := value.appendCodePoint(65);
    twoByteError := value.appendCodePoint(162);
    threeByteError := value.appendCodePoint(8364);
    fourByteError := value.appendCodePoint(128512);

    asserts::is_true(
        t,
        asciiError == none and twoByteError == none and
            threeByteError == none and fourByteError == none,
        "every Unicode scalar appends successfully"
    );
    bytes := value.bytes();
    asserts::is_true(
        t,
        bytes.len() == 10 and
            bytes[0] == 65 and bytes[1] == 194 and bytes[2] == 162 and
            bytes[3] == 226 and bytes[4] == 130 and bytes[5] == 172 and
            bytes[6] == 240 and bytes[7] == 159 and
            bytes[8] == 152 and bytes[9] == 128,
        "code points append their canonical UTF-8 bytes"
    );
    asserts::is_true(
        t,
        utf8::validate(value.view()) == none,
        "appended code points form valid UTF-8"
    );
}

test string_builder_rejects_invalid_code_points_without_mutation(
    &testing::UnitTest t
) {
    value := strings::StringBuilder::init();
    setupError := value.append("kept");
    const usize ORIGINAL_CAPACITY = value.capacity();
    surrogateError := value.appendCodePoint(55296);
    oversizedError := value.appendCodePoint(1114112);

    asserts::is_true(t, setupError == none, "the setup append succeeds");
    asserts::is_true(
        t,
        surrogateError == text_errors::Utf8Error.InvalidCodePoint and
            oversizedError == text_errors::Utf8Error.InvalidCodePoint,
        "appendCodePoint rejects values that are not Unicode scalars"
    );
    asserts::is_true(
        t,
        value.view() == "kept" and value.capacity() == ORIGINAL_CAPACITY,
        "invalid code points preserve contents and allocation"
    );
}

test string_builder_repetition_overflow_preserves_contents(
    &testing::UnitTest t
) {
    value := strings::StringBuilder::init();
    setupError := value.appendChar('a');
    const usize ORIGINAL_CAPACITY = value.capacity();
    overflowError := value.appendRepeated('x', usize.max_value);

    asserts::is_true(t, setupError == none, "the setup append succeeds");
    asserts::is_true(
        t,
        overflowError == AllocationError.OutOfMemory,
        "capacity overflow reports allocation failure"
    );
    bytes := value.bytes();
    asserts::is_true(
        t,
        value.len() == 1 and value.capacity() == ORIGINAL_CAPACITY and
            bytes[0] == 97,
        "overflow preserves length capacity and contents"
    );
}

test string_builder_reserve_and_clear_preserve_allocation(
    &testing::UnitTest t
) {
    value := strings::StringBuilder::init();
    appendError := value.append("flecha");
    reserveError := value.reserve(32);

    asserts::is_true(
        t,
        appendError == none and reserveError == none,
        "append and reserve succeed"
    );
    asserts::is_true(
        t,
        value.len() == 6 and value.capacity() == 32,
        "reserve retains accumulated bytes"
    );

    value.clear();
    asserts::is_true(t, value.empty(), "clear makes the builder empty");
    asserts::is_true(t, value.len() == 0, "clear resets the byte length");
    asserts::is_true(t, value.capacity() == 32, "clear retains allocation");
}

test string_builder_borrows_accumulated_text(&testing::UnitTest t) {
    value := strings::StringBuilder::init();
    appendError := value.append("flecha");

    asserts::is_true(t, appendError == none, "the setup append succeeds");
    text := value.view();
    asserts::is_true(t, text == "flecha", "view borrows the accumulated text");
    asserts::is_true(t, text.len() == 6, "view preserves the byte length");
}

test string_builder_copies_an_independent_owning_string(
    &testing::UnitTest t
) {
    value := strings::StringBuilder::init();
    appendError := value.append("flecha");
    text, copyError := value.asString();

    asserts::is_true(
        t,
        appendError == none and copyError == none,
        "builder text copy succeeds"
    );
    if copyError != none {
        return;
    }

    value.clear();
    replacementError := value.append("arrow");
    asserts::is_true(t, replacementError == none, "builder remains reusable");
    asserts::is_true(
        t,
        text == "flecha",
        "owned copy is independent of builder"
    );
    asserts::is_true(
        t,
        value.view() == "arrow",
        "builder stores replacement text"
    );
}

test string_builder_copies_empty_text_without_allocation(
    &testing::UnitTest t
) {
    value := strings::StringBuilder::init();
    text, err := value.asString();

    asserts::is_true(t, err == none, "empty string copy succeeds");
    asserts::is_true(
        t,
        text.len() == 0,
        "empty builder produces an empty string"
    );
}

test string_search_handles_boundaries(&testing::UnitTest t) {
    asserts::is_true(
        t,
        strings::starts_with("flecha", "fle") and
            strings::ends_with("flecha", "cha"),
        "prefix and suffix matches are detected"
    );
    asserts::is_true(
        t,
        strings::starts_with("flecha", "") and
            strings::ends_with("flecha", "") and
            strings::starts_with("", "") and strings::ends_with("", ""),
        "empty prefixes and suffixes match every value"
    );
    asserts::is_false(
        t,
        strings::starts_with("flecha", "flechas") or
            strings::ends_with("flecha", "flechas") or
            strings::starts_with("flecha", "cha") or
            strings::ends_with("flecha", "fle"),
        "oversized and misplaced boundaries do not match"
    );
}

test string_find_returns_first_byte_offset(&testing::UnitTest t) {
    first, firstFound := strings::find("bananana", "nana");
    empty, emptyFound := strings::find("bananana", "");
    absent, absentFound := strings::find("bananana", "arrow");
    character, characterFound := strings::find_char("bananana", 'n');
    missingCharacter, missingCharacterFound :=
        strings::find_char("bananana", 'z');

    asserts::is_true(
        t,
        firstFound and first == 2 and strings::contains("bananana", "nana"),
        "find and contains detect the first candidate"
    );
    asserts::is_true(
        t,
        emptyFound and empty == 0 and strings::contains("", ""),
        "an empty needle is found at byte offset zero"
    );
    asserts::is_true(
        t,
        !absentFound and absent == 0 and
            !strings::contains("bananana", "arrow"),
        "an absent substring reports false and the zero value"
    );
    asserts::is_true(
        t,
        characterFound and character == 2 and
            !missingCharacterFound and missingCharacter == 0,
        "character search returns the first byte offset"
    );
}

test string_find_uses_byte_offsets(&testing::UnitTest t) {
    [5]u8 valueBytes = [195, 169, 120, 195, 169];
    [2]u8 needleBytes = [195, 169];
    value := strings::stringv_from_bytes(valueBytes[:]);
    needle := strings::stringv_from_bytes(needleBytes[:]);

    first, firstFound := strings::find(value, needle);
    const u8 CONTINUATION = 169;
    secondByte, byteFound :=
        strings::find_char(value, CONTINUATION.cast<char>);

    asserts::is_true(
        t,
        firstFound and first == 0 and byteFound and secondByte == 1,
        "text search reports byte offsets rather than code-point offsets"
    );
}

test ascii_trim_removes_only_edge_whitespace(&testing::UnitTest t) {
    stringv value = " \t\n  flecha text\r\n ";

    asserts::is_true(
        t,
        strings::trim_ascii(value) == "flecha text",
        "trim removes ASCII whitespace from both edges"
    );
    asserts::is_true(
        t,
        strings::trim_ascii_start(value) == "flecha text\r\n ",
        "trim start preserves trailing whitespace"
    );
    asserts::is_true(
        t,
        strings::trim_ascii_end(value) == " \t\n  flecha text",
        "trim end preserves leading whitespace"
    );
    asserts::is_true(
        t,
        strings::trim_ascii("\t\r\n ").len() == 0 and
            strings::trim_ascii("").len() == 0,
        "all-whitespace and empty values trim to an empty view"
    );
}

test ascii_trim_preserves_non_ascii_bytes(&testing::UnitTest t) {
    [7]u8 valueBytes = [194, 160, 32, 120, 32, 194, 160];
    value := strings::stringv_from_bytes(valueBytes[:]);

    asserts::is_true(
        t,
        strings::trim_ascii(value) == value,
        "non-ASCII whitespace bytes stop ASCII trimming"
    );
}

test ascii_case_conversion_maps_only_ascii_letters(&testing::UnitTest t) {
    [6]u8 sourceBytes = [195, 137, 65, 122, 45, 57];
    [6]u8 lowerBytes = [195, 137, 97, 122, 45, 57];
    [6]u8 upperBytes = [195, 137, 65, 90, 45, 57];
    source := strings::stringv_from_bytes(sourceBytes[:]);
    expectedLower := strings::stringv_from_bytes(lowerBytes[:]);
    expectedUpper := strings::stringv_from_bytes(upperBytes[:]);

    lower, lowerError := strings::to_ascii_lowercase(source);
    upper, upperError := strings::to_ascii_uppercase(source);

    asserts::is_true(
        t,
        lowerError == none and lower.view() == expectedLower,
        "lowercase maps ASCII uppercase and preserves other bytes"
    );
    asserts::is_true(
        t,
        upperError == none and upper.view() == expectedUpper,
        "uppercase maps ASCII lowercase and preserves other bytes"
    );
}

test ascii_case_conversion_handles_empty_text(&testing::UnitTest t) {
    lower, lowerError := strings::to_ascii_lowercase("");
    upper, upperError := strings::to_ascii_uppercase("");

    asserts::is_true(
        t,
        lowerError == none and upperError == none and
            lower.len() == 0 and upper.len() == 0,
        "case conversion returns owning empty strings"
    );
}

test replace_handles_growth_shrinkage_and_removal(&testing::UnitTest t) {
    grown, grownError := strings::replace("a-b-a", "a", "arrow");
    shrunk, shrunkError := strings::replace("one::two::", "::", ":");
    removed, removedError := strings::replace("banana", "na", "");

    asserts::is_true(
        t,
        grownError == none and grown == "arrow-b-arrow",
        "replacement grows output for every match"
    );
    asserts::is_true(
        t,
        shrunkError == none and shrunk == "one:two:",
        "replacement shrinks output for every match"
    );
    asserts::is_true(
        t,
        removedError == none and removed == "ba",
        "an empty replacement removes every match"
    );
}

test replace_uses_non_overlapping_matches(&testing::UnitTest t) {
    replaced, replacementError := strings::replace("aaaaa", "aa", "b");
    unchanged, unchangedError := strings::replace("flecha", "bow", "arrow");

    asserts::is_true(
        t,
        replacementError == none and replaced == "bba",
        "replacement consumes matches from left to right without overlap"
    );
    asserts::is_true(
        t,
        unchangedError == none and unchanged == "flecha",
        "an absent target produces an equal owning copy"
    );
}

test replace_empty_target_matches_byte_boundaries(&testing::UnitTest t) {
    separated, separatedError := strings::replace("ab", "", "-");
    empty, emptyError := strings::replace("", "", "-");
    unchanged, unchangedError := strings::replace("ab", "", "");

    asserts::is_true(
        t,
        separatedError == none and separated == "-a-b-",
        "an empty target inserts replacement at every boundary"
    );
    asserts::is_true(
        t,
        emptyError == none and empty == "-",
        "empty text has one byte boundary"
    );
    asserts::is_true(
        t,
        unchangedError == none and unchanged == "ab",
        "empty target and replacement preserve the value"
    );
}

test replace_preserves_arbitrary_bytes(&testing::UnitTest t) {
    [5]u8 sourceBytes = [65, 0, 66, 0, 65];
    [1]u8 targetBytes = [0];
    [2]u8 replacementBytes = [255, 1];
    [7]u8 expectedBytes = [65, 255, 1, 66, 255, 1, 65];
    source := strings::stringv_from_bytes(sourceBytes[:]);
    target := strings::stringv_from_bytes(targetBytes[:]);
    replacement := strings::stringv_from_bytes(replacementBytes[:]);
    expected := strings::stringv_from_bytes(expectedBytes[:]);

    result, replacementError :=
        strings::replace(source, target, replacement);

    asserts::is_true(
        t,
        replacementError == none and result.view() == expected,
        "replacement is byte-oriented and preserves embedded nulls"
    );
}
