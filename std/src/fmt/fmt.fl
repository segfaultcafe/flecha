module fmt;
under namespace root;

export void print(values...) {
    stdout(values...);
}

export void println(values...) {
    stdoutln(values...);
}

export void printf(stringv format, values...) {
    stdoutf(format, values...);
}

export void eprint(values...) {
    stderr(values...);
}

export void eprintln(values...) {
    stderrln(values...);
}

export void eprintf(stringv format, values...) {
    stderrf(format, values...);
}

export (string, error) sprintf(stringv format, values...) {
    return __sprintf(format, values...);
}

// Formats an owning string and crashes with a diagnostic report if the
// allocation cannot be completed.
export string sprintf!(stringv format, values...) {
    return __sprintf_crash!(format, values...);
}
